<Window x:Class="Intelektron.INComedor.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:demo="clr-namespace:Intelektron.INComedor.Kiosk.Demostracion"
        Title="INComedor · puesto de demostración" Height="640" Width="900">
    <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type demo:PantallaDemostracion}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
