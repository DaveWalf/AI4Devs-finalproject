<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- El ícono del puesto, en el ejecutable y en la ventana (D16 de configurar-puesto-por-pestanas). -->
    <ApplicationIcon>Recursos\incomedor-puesto.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="System.IO.Ports" />
    <ProjectReference Include="..\Intelektron.INComedor.Infrastructure.Sqlite\Intelektron.INComedor.Infrastructure.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Recursos\incomedor-puesto.ico" />
  </ItemGroup>
  <!-- La versión del paquete y la fecha de compilación, como metadatos con nombre propio que publicar-puesto.ps1 pasa con
       -p:VersionPuesto y -p:FechaCompilacionPuesto, nunca como Version (MSB4181 con un tag que empieza con «v»). Sin ellos
       van vacíos, y el puesto dice «desarrollo» y la fecha del archivo (D1 y D2 de mostrar-version-del-programa). -->
  <ItemGroup>
    <AssemblyMetadata Include="VersionPuesto" Value="$(VersionPuesto)" />
    <AssemblyMetadata Include="FechaCompilacionPuesto" Value="$(FechaCompilacionPuesto)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Demostracion\semilla_demostracion.sql" LogicalName="Demostracion.semilla_demostracion.sql" />
    <EmbeddedResource Include="Atencion\semilla_atencion_comun.sql" LogicalName="Atencion.semilla_atencion_comun.sql" />
    <EmbeddedResource Include="Atencion\opciones_quince.sql" LogicalName="Atencion.opciones_quince.sql" />
    <EmbeddedResource Include="Atencion\opciones_nueve.sql" LogicalName="Atencion.opciones_nueve.sql" />
  </ItemGroup>
</Project>
