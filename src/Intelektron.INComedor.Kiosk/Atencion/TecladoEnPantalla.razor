@*
    Un teclado en pantalla para editar sin teclado físico (D4 de editar-raciones-en-personas): números, letras con la Ñ,
    «Mayús», espacio y borrar, en cuatro filas de teclas de 56 px y del mismo ancho por fila, para que la tabla conserve
    sus filas a la vista a 1024 × 768. Avisa cada tecla con su valor
    (la letra, el número, BORRAR o ESPACIO); quien lo usa decide en qué campo escribe. Las teclas no sacan el foco del campo.
*@
<div class="teclado-en-pantalla" role="group" aria-label="Teclado en pantalla">
    @foreach (var fila in FilasVisibles)
    {
        <div class="fila-teclas">
            @foreach (var tecla in fila)
            {
                <button type="button" class="tecla @(tecla.Length > 1 ? "especial" : null) @(tecla == Mayus && _mayusculas ? "activa" : null)"
                        data-tecla="@tecla" aria-label="@Etiqueta(tecla)" aria-pressed="@(tecla == Mayus ? (_mayusculas ? "true" : "false") : null)"
                        @onmousedown:preventDefault @onclick="() => Tocar(tecla)">@Mostrar(tecla)</button>
            }
        </div>
    }
</div>

@code {
    public const string Borrar = "BORRAR";
    public const string Espacio = "ESPACIO";
    public const string Mayus = "MAYUS";
    public const string Ocultar = "OCULTAR";

    /// <summary>La fila de los símbolos de las casillas, los servidores y las carpetas (D1 de operar-solo-con-la-pantalla).</summary>
    private static readonly string[] Simbolos = [".", "-", "_", "@", ":", "/", "\\"];

    private static readonly string[][] Filas =
    [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L", "Ñ"],
        [Mayus, "Z", "X", "C", "V", "B", "N", "M", Espacio, Borrar],
    ];

    private bool _mayusculas;

    /// <summary>Con la fila de los símbolos: el teclado general la muestra; Personas, no.</summary>
    [Parameter]
    public bool ConSimbolos { get; set; }

    /// <summary>Con la tecla «Ocultar teclado» al final de los símbolos, que avisa OCULTAR (D4 de operar-solo-con-la-pantalla).</summary>
    [Parameter]
    public bool Ocultable { get; set; }

    private IEnumerable<string[]> FilasVisibles =>
        ConSimbolos ? [.. Filas, Ocultable ? [.. Simbolos, Ocultar] : Simbolos] : Filas;

    /// <summary>Cada tecla tocada: la letra (en mayúscula o minúscula según «Mayús»), el número, BORRAR, ESPACIO u OCULTAR.</summary>
    [Parameter]
    public EventCallback<string> Tecla { get; set; }

    private async Task Tocar(string tecla)
    {
        if (tecla == Mayus)
        {
            _mayusculas = !_mayusculas;
            return;
        }

        await Tecla.InvokeAsync(tecla.Length == 1 && char.IsLetter(tecla[0]) && !_mayusculas ? tecla.ToLowerInvariant() : tecla);
    }

    private string Mostrar(string tecla) => tecla switch
    {
        Borrar => "⌫",
        Espacio => "Espacio",
        Mayus => "Mayús",
        Ocultar => "Ocultar teclado",
        _ when char.IsLetter(tecla[0]) && !_mayusculas => tecla.ToLowerInvariant(),
        _ => tecla,
    };

    private static string Etiqueta(string tecla) => tecla switch
    {
        Borrar => "Borrar",
        Espacio => "Espacio",
        Mayus => "Mayúsculas",
        Ocultar => "Ocultar teclado",
        _ => tecla,
    };
}
