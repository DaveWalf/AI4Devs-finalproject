    /// <summary>
    /// «Importar Excel» de Opciones: pide el archivo, lo revisa sin escribir nada y muestra el resumen (D4); con errores, deja
    /// MENU_OPTIONS_IMPORT_REJECTED (D6). Cancelar la elección no hace nada.
    /// </summary>
    private void ImportarOpciones()
    {
        _mensajeArchivosOpciones = null;
        if (ElectorArchivo!.Elegir(AlmacenExportacion?.Leer(), IElectorArchivo.TituloOpciones) is not { } ruta)
        {
            return;
        }

        RevisionOpciones revision;
        string? huella;
        try
        {
            using var flujo = new System.IO.FileStream(ruta, System.IO.FileMode.Open, System.IO.FileAccess.Read,
                System.IO.FileShare.ReadWrite | System.IO.FileShare.Delete);
            huella = flujo.Length <= LectorPlanilla.TamanoMaximo ? Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(flujo)) : null;
            flujo.Position = 0;
            revision = new ImportacionOpciones(Administracion!).Revisar(flujo);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            (_mensajeArchivosOpciones, _archivosOpcionesFallido) = (MensajesAtencion.ArchivoNoLeido, true);
            return;
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeArchivosOpciones, _archivosOpcionesFallido) = (MensajesAtencion.ConfiguracionNoLeida, true);
            return;
        }

        (_revisionOpciones, _archivoOpciones, _huellaOpciones, _enfocarCartelOpciones) = (revision, System.IO.Path.GetFileName(ruta), huella, true);
        if (!revision.Valida)
        {
            RegistrarImportacionOpcionesRechazada?.Invoke(new ImportacionOpcionesRechazada(huella, revision.Errores));
        }
    }

    /// <summary>«Reemplazar»: aplica el resumen en una sola versión, con el actor, y vuelve a leer el catálogo a la vista (D4).</summary>
    private void AplicarImportacionOpciones()
    {
        var (revision, huella) = (_revisionOpciones!, _huellaOpciones);
        CerrarImportacionOpciones();
        ResultadoImportacionOpciones resultado;
        try
        {
            resultado = new ImportacionOpciones(Administracion!).Aplicar(revision, Actor);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _avisoGuardado = MensajesAtencion.PanelNoGuardado;
            return;
        }

        switch (resultado.Guardado.Tipo)
        {
            case TipoGuardado.Aplicado:
                _avisoGuardado = revision.Agregadas + revision.Modificadas + revision.Quitadas > 0
                    ? MensajesAtencion.ImportacionOpcionesAplicada(resultado.Guardado.VersionActiva, revision.Agregadas, revision.Modificadas, revision.Quitadas)
                    : MensajesAtencion.ImportacionSinCambios(resultado.Guardado.VersionActiva);
                RegistrarImportacionOpciones?.Invoke(new ImportacionOpcionesRealizada(huella, resultado));
                break;
            case TipoGuardado.Denegado:
                _avisoGuardado = MensajesAtencion.INWebAdministra;
                break;
            default:
                _avisoGuardado = MensajesAtencion.ImportacionRechazada;
                break;
        }

        LeerResumen();
    }

