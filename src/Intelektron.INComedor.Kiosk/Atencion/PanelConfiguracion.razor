    /// <summary>«Guardar resguardo»: el .zip en la carpeta de la exportación, como una exportación (D1 y D4).</summary>
    private void GuardarResguardo()
    {
        _mensajeResguardo = null;
        if (CarpetaDeExportacion(out var avisoCarpeta) is not { } carpeta)
        {
            (_mensajeResguardo, _resguardoFallido) = (MensajesAtencion.SinCarpetaResguardo, true);
            return;
        }

        ResguardoGuardado guardado;
        try
        {
            guardado = Resguardo!.Guardar(carpeta, Zona);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            (_mensajeResguardo, _resguardoFallido) = (MensajesAtencion.ResguardoNoGuardado, true);
            return;
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeResguardo, _resguardoFallido) = (MensajesAtencion.ConfiguracionNoLeida, true);
            return;
        }

        var archivo = System.IO.Path.GetFileName(guardado.Ruta);
        _resguardoFallido = avisoCarpeta is not null;
        _mensajeResguardo = string.Join(' ', new[] { avisoCarpeta, MensajesAtencion.ResguardoGuardado(archivo, carpeta) }.OfType<string>());
        RegistrarResguardo?.Invoke(new ResguardoRealizado(archivo, guardado.Huella, guardado.VersionConfiguracion, guardado.Partes));
    }

    /// <summary>
    /// «Recuperar resguardo»: pide el .zip, lo revisa entero sin escribir y muestra el resumen o el motivo (D2 y D4); un
    /// rechazo deja CONFIGURATION_RESTORE_REJECTED (D5). Cancelar la elección no hace nada.
    /// </summary>
    private void RevisarResguardo()
    {
        _mensajeResguardo = null;
        if (ElectorArchivo!.ElegirResguardo(AlmacenExportacion?.Leer()) is not { } ruta)
        {
            return;
        }

        RevisionResguardo revision;
        try
        {
            revision = Resguardo!.Revisar(ruta);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeResguardo, _resguardoFallido) = (MensajesAtencion.ConfiguracionNoLeida, true);
            RegistrarRecuperacionRechazada?.Invoke(new RecuperacionRechazada(null, MotivosResguardo.BaseSinRespuesta));
            return;
        }

        (_revisionResguardo, _archivoResguardo, _enfocarCartelResguardo) = (revision, System.IO.Path.GetFileName(ruta), true);
        if (revision.Motivo is { } motivo)
        {
            RegistrarRecuperacionRechazada?.Invoke(new RecuperacionRechazada(revision.Huella, motivo));
        }
    }

    /// <summary>
    /// «Recuperar»: los ajustes locales y la versión nueva del resguardo revisado, todo o nada (D3); la pantalla los vuelve a
    /// leer y el panel relee su resumen, las personas y los textos. La base vuelve a validar todo en su transacción.
    /// </summary>
    private void RecuperarResguardo()
    {
        var (revisado, archivo) = (_revisionResguardo!.Resguardo!, _archivoResguardo!);
        CerrarResguardo();
        RecuperacionResguardo resultado;
        try
        {
            resultado = Resguardo!.Recuperar(revisado);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _avisoGuardado = MensajesAtencion.PanelNoGuardado;
            RegistrarRecuperacionRechazada?.Invoke(new RecuperacionRechazada(revisado.Huella, MotivosResguardo.BaseSinRespuesta));
            return;
        }

        if (resultado.Base.Tipo == TipoGuardado.Aplicado)
        {
            _avisoGuardado = MensajesAtencion.ResguardoRecuperado(resultado.Base.VersionActiva);
            _releerTextos = true;
            _recargaPersonas++;
            RegistrarRecuperacion?.Invoke(new RecuperacionRealizada(revisado.Huella, revisado.VersionOrigen, resultado, revisado.Partes));
        }
        else
        {
            var motivo = resultado.Base.Motivo ?? CodigosAdministracion.ResguardoInvalido;
            _avisoGuardado = MensajesAtencion.ResguardoRechazado(archivo, motivo);
            RegistrarRecuperacionRechazada?.Invoke(new RecuperacionRechazada(revisado.Huella, motivo));
        }

        LeerResumen();
    }

