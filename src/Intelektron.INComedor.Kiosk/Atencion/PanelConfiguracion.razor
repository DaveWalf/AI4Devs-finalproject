@using Microsoft.AspNetCore.Components.Web
@using Intelektron.INComedor.Infrastructure.Sqlite

@*
    Configuración en este corte (D5 de presentar-atencion-tactil): un diálogo modal que no cambia el estado de la
    máquina, con «Estilo visual» y, sólo con la impresora simulada, sus modos. Se abre sin clave; la clave llega con el
    segundo change. Mover un rango sólo avisa la vista previa; «Guardar» y «Cancelar» (o Escape) los decide la pantalla.
*@
<div class="fondo-dialogo">
    <div class="dialogo superficie @(_panel is null ? "" : "ancho")" role="dialog" aria-modal="true" aria-labelledby="titulo-configuracion" tabindex="-1"
         @ref="_dialogo" @onkeydown="Tecla">
        <h2 id="titulo-configuracion">Configuración</h2>

        @* Cada panel se abre en lugar del contenido del diálogo, con su «Guardar» y su «Cancelar» (D12 de administrar-personas-y-opciones). *@
        @if (_panel == Panel.Personas && Administracion is not null)
        {
            <PanelPersonas Administracion="Administracion" Cerrar="CerrarPanel" />
        }
        else if (_panel == Panel.Opciones && Administracion is not null)
        {
            <PanelOpciones Administracion="Administracion" Cerrar="CerrarPanel" />
        }
        else
        {
        <text>
        @if (Administracion is not null)
        {
            <section id="administracion" aria-label="Personas y opciones">
                <div class="acciones abrir-paneles">
                    <button id="abrir-personas" type="button" @onclick="() => AbrirPanel(Panel.Personas)">Personas habilitadas</button>
                    <button id="abrir-opciones" type="button" @onclick="() => AbrirPanel(Panel.Opciones)">Opciones del comedor</button>
                </div>
                @if (_avisoPanel is not null)
                {
                    <p id="aviso-guardado" class="aviso" role="status">@_avisoPanel</p>
                }
            </section>
        }

        <section aria-labelledby="titulo-estilo">
            <h3 id="titulo-estilo">Estilo visual</h3>
            <div class="parametro">
                <label for="opacidad">Opacidad de las superficies</label>
                <output id="valor-opacidad" for="opacidad">@Estilo.Opacidad %</output>
                <input id="opacidad" type="range" min="@EstiloVisual.OpacidadMinima" max="@EstiloVisual.OpacidadMaxima" step="1"
                       value="@Estilo.Opacidad" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Opacidad = valor })" />
            </div>
            <div class="parametro">
                <label for="desenfoque">Desenfoque del fondo</label>
                <output id="valor-desenfoque" for="desenfoque">@Estilo.Desenfoque px</output>
                <input id="desenfoque" type="range" min="@EstiloVisual.DesenfoqueMinimo" max="@EstiloVisual.DesenfoqueMaximo" step="1"
                       value="@Estilo.Desenfoque" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Desenfoque = valor })" />
            </div>
        </section>

        @if (Impresora is not null)
        {
            <FranjaImpresora Impresora="Impresora" ModoCambiado="ModoImpresoraCambiado" />
        }

        @if (Bitacoras is not null)
        {
            @* El estado de cada bitácora, sin datos de personas (escribir-bitacoras-externas). *@
            <section id="estado-bitacoras" aria-labelledby="titulo-bitacoras">
                <h3 id="titulo-bitacoras">Bitácoras</h3>
                <ul>
                    @foreach (var bitacora in Bitacoras)
                    {
                        <li id="bitacora-@(bitacora.Destino == DestinoBitacora.General ? "general" : "interacciones")">@MensajesAtencion.EstadoBitacora(bitacora, Zona)</li>
                    }
                </ul>
            </section>
        }

        @if (Aviso is not null)
        {
            <p id="aviso-configuracion" class="aviso" role="alert">@Aviso</p>
        }

        <div class="acciones">
            <button id="cancelar-configuracion" type="button" @onclick="Cancelar">Cancelar</button>
            <button id="guardar-configuracion" type="button" class="principal" @onclick="Guardar">Guardar</button>
        </div>
        </text>
        }
    </div>
</div>

@code {
    private enum Panel
    {
        Personas,
        Opciones,
    }

    private ElementReference _dialogo;
    private Panel? _panel;
    private string? _avisoPanel;

    /// <summary>La edición de personas y opciones; null no muestra sus botones (administrar-personas-y-opciones).</summary>
    [Parameter]
    public AdministracionLocal? Administracion { get; set; }

    /// <summary>El estilo de la vista previa.</summary>
    [Parameter, EditorRequired]
    public EstiloVisual Estilo { get; set; } = EstiloVisual.PorDefecto;

    /// <summary>La impresora simulada, o null con cualquier otra: entonces no hay sección de impresora.</summary>
    [Parameter]
    public ImpresoraSimulada? Impresora { get; set; }

    /// <summary>El estado de las bitácoras al abrir; null no muestra la sección.</summary>
    [Parameter]
    public IReadOnlyList<EstadoBitacora>? Bitacoras { get; set; }

    /// <summary>La zona en que se muestra desde qué hora una bitácora está degradada.</summary>
    [Parameter]
    public TimeZoneInfo Zona { get; set; } = TimeZoneInfo.Utc;

    [Parameter]
    public EventCallback<CambioModoImpresora> ModoImpresoraCambiado { get; set; }

    /// <summary>Lo que el diálogo avisa, por ejemplo que no se pudo guardar; null sin aviso.</summary>
    [Parameter]
    public string? Aviso { get; set; }

    [Parameter]
    public EventCallback<EstiloVisual> VistaPrevia { get; set; }

    [Parameter]
    public EventCallback Guardar { get; set; }

    [Parameter]
    public EventCallback Cancelar { get; set; }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        // El foco entra al diálogo para que Escape funcione sin tocarlo antes.
        if (primera)
        {
            await _dialogo.FocusAsync();
        }
    }

    private Task Cambiar(ChangeEventArgs e, Func<EstiloVisual, int, EstiloVisual> aplicar)
    {
        if (!int.TryParse(e.Value?.ToString(), out var valor))
        {
            return Task.CompletedTask;
        }

        var estilo = aplicar(Estilo, valor);
        return estilo.EnRango ? VistaPrevia.InvokeAsync(estilo) : Task.CompletedTask;
    }

    /// <summary>Escape cierra el panel abierto, como su «Cancelar»; sin panel, cancela el diálogo.</summary>
    private Task Tecla(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
        {
            return Task.CompletedTask;
        }

        if (_panel is not null)
        {
            CerrarPanel(null);
            return Task.CompletedTask;
        }

        return Cancelar.InvokeAsync();
    }

    private void AbrirPanel(Panel panel)
    {
        _avisoPanel = null;
        _panel = panel;
    }

    /// <summary>Vuelve al contenido del diálogo; si el panel guardó, con el aviso de la versión nueva.</summary>
    private void CerrarPanel(string? aviso)
    {
        _panel = null;
        _avisoPanel = aviso;
    }
}
