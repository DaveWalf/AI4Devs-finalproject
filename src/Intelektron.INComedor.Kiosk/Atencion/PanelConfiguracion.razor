@using Microsoft.AspNetCore.Components.Web
@using Intelektron.INComedor.Infrastructure.Sqlite
@using Intelektron.INComedor.Kiosk.Red
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS

@*
    Configuración por pestañas (D1 a D3 de configurar-puesto-por-pestanas): un diálogo modal que no cambia el estado de la
    máquina, con nueve pestañas según el patrón de WAI-ARIA. Todas quedan montadas y sólo la elegida se ve, así que lo
    editado en una sobrevive al pasar a otra y los id de siempre siguen en el diálogo (D2). Cada «Guardar» guarda lo suyo y
    deja Configuración abierta, con el aviso de lo guardado debajo de las pestañas (D3); «Cerrar» o Escape la cierran y
    descartan lo no guardado, también con un panel de edición abierto. Sólo un panel de edición se abre a la vez: Personas y
    Opciones comparten los id de sus botones desde administrar-personas-y-opciones.
*@
<div class="fondo-dialogo" inert="@Inerte">
    @* Escape no sigue hasta la pantalla de atrás, que lo leería como un pedido de cierre en reposo (D7). *@
    <div class="dialogo superficie ancho" role="dialog" aria-modal="true" aria-labelledby="titulo-configuracion" tabindex="-1"
         @ref="_dialogo" @onkeydown="Tecla" @onkeydown:stopPropagation="true">
        @* Con un operador, su nombre arriba; con la clave del día, el aviso de que no se validó (D4 y D6 de entrar-a-configuracion-con-teclado). *@
        @* Van en la fila del título, que tiene lugar: así no le quitan alto a las tablas de Personas y Consumos. *@
        <div class="encabezado-configuracion">
            <h2 id="titulo-configuracion">Configuración</h2>
            @if (Operador is not null)
            {
                <p id="operador-configuracion" class="operador-configuracion">Operador: @Operador</p>
            }
            @if (ClaveSinValidar)
            {
                <p id="aviso-clave-sin-validar" class="aviso" role="status">@MensajesAtencion.ClaveSinValidar</p>
            }
        </div>

        <div class="pestanas" role="tablist" aria-label="Secciones de Configuración">
            @foreach (var pestana in Visibles)
            {
                var elegida = pestana == _elegida;
                var indice = (int)pestana;
                <button type="button" role="tab" id="pestana-@Clave(pestana)" class="pestana" aria-selected="@(elegida ? "true" : "false")"
                        aria-controls="seccion-@Clave(pestana)" tabindex="@(elegida ? "0" : "-1")" @ref="_botones[indice]"
                        @onclick="() => Elegir(pestana)" @onkeydown="e => TeclaPestana(e, pestana)">@Nombre(pestana)</button>
            }
        </div>

        @if (_avisoGuardado is not null)
        {
            <p id="aviso-guardado" class="aviso" role="status">@_avisoGuardado</p>
        }

        @* Con un operador, General, Opciones, Identidad visual, Pantalla y Red no existen en el DOM (D6). *@
        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-general" class="seccion" aria-labelledby="pestana-general" hidden="@Oculta(Pestana.General)">
            <p id="modo-puesto" class="modo-puesto">Modo: @(Modo == ModoPuesto.Operativo ? "operativo" : "mantenimiento")</p>
            @if (OfreceSimulacion)
            {
                @* El modo simulación, sólo en mantenimiento; se aplica en el acto, como el modo (D6 de simular-identificacion-por-lista). *@
                <p id="modo-simulacion" class="modo-puesto">Simulación: @(Simulacion ? "encendida" : "apagada")</p>
            }
            <div class="acciones abrir-paneles">
                @if (Modo == ModoPuesto.Mantenimiento)
                {
                    <button id="pasar-operativo" type="button" @onclick="() => PasarAOperativo.InvokeAsync()">Pasar a operativo</button>
                }
                else
                {
                    <button id="pasar-mantenimiento" type="button" @onclick="() => PasarAMantenimiento.InvokeAsync()">Pasar a mantenimiento</button>
                }
                @if (OfreceSimulacion)
                {
                    @if (Simulacion)
                    {
                        <button id="apagar-simulacion" type="button" @onclick="() => CambiarSimulacion.InvokeAsync(false)">Apagar la simulación</button>
                    }
                    else
                    {
                        <button id="encender-simulacion" type="button" @onclick="() => CambiarSimulacion.InvokeAsync(true)">Encender la simulación</button>
                    }
                }
                @if (PuedeCerrar)
                {
                    <button id="cerrar-puesto" type="button" @onclick="() => CerrarPuesto.InvokeAsync()">Cerrar el puesto</button>
                }
            </div>
            @if (AvisoModo is not null)
            {
                <p id="aviso-modo" class="aviso" role="alert">@AvisoModo</p>
            }
            @if (OfreceSimulacion && AvisoSimulacion is not null)
            {
                <p id="aviso-simulacion" class="aviso" role="alert">@AvisoSimulacion</p>
            }
            @if (Bitacoras is not null)
            {
                @* El estado de cada bitácora, sin datos de personas (escribir-bitacoras-externas). *@
                <section id="estado-bitacoras" aria-labelledby="titulo-bitacoras">
                    <h3 id="titulo-bitacoras">Bitácoras</h3>
                    <ul>
                        @foreach (var bitacora in Bitacoras)
                        {
                            <li id="bitacora-@(bitacora.Destino == DestinoBitacora.General ? "general" : "interacciones")">@MensajesAtencion.EstadoBitacora(bitacora, Zona)</li>
                        }
                    </ul>
                </section>
            }
        </section>
        }

        <section role="tabpanel" id="seccion-personas" class="seccion" aria-labelledby="pestana-personas" hidden="@Oculta(Pestana.Personas)">
            @if (Administracion is not null)
            {
                @* La tabla para leer y, con «Editar» en su encabezado, la misma tabla para editar en el mismo lugar (D4). *@
                @* La tabla de lectura se dibuja sólo con su pestaña elegida: no tiene nada editado que conservar, y así los nombres
                   de todas las personas no quedan en la página mientras se usa otra pestaña. La edición sigue montada (D2). *@
                @if (_panel == Panel.Personas || _elegida == Pestana.Personas)
                {
                    @* Una importación aplicada cambia la clave y la tabla se vuelve a leer (importar-personas-desde-excel). *@
                    <PanelPersonas @key="_recargaPersonas" Administracion="Administracion" Editando="@(_panel == Panel.Personas)" Cerrar="CerrarPanel"
                                   PuedeEditar="@(_panel is null)" Editar="() => AbrirPanel(Panel.Personas)" Actor="Actor"
                                   TecladoVisible="_tecladoPersonasVisible" TecladoVisibleChanged="v => _tecladoPersonasVisible = v" />
                }
                else
                {
                    @* Con la pestaña oculta queda sólo «Editar», sin nombres en la página. *@
                    <button id="abrir-personas" type="button" disabled="@(_panel is not null)" @onclick="() => AbrirPanel(Panel.Personas)">@Editar</button>
                }
            }
        </section>

        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-opciones" class="seccion" aria-labelledby="pestana-opciones" hidden="@Oculta(Pestana.Opciones)">
            @if (Administracion is not null)
            {
                @if (_panel == Panel.Opciones)
                {
                    <PanelOpciones Administracion="Administracion" Cerrar="CerrarPanel" Actor="Actor" Enfocar="_opcionAEnfocar" />
                }
                else
                {
                    <p id="resumen-opciones">@ResumenOpciones</p>
                    <div class="acciones abrir-paneles">
                        <button id="abrir-opciones" type="button" disabled="@(_panel is not null)" @onclick="() => AbrirPanel(Panel.Opciones)">@Editar</button>
                    </div>
                    @if (_panel is not null)
                    {
                        <p class="indicacion">@MensajesAtencion.EdicionDePersonasAbierta</p>
                    }
                    @* El catálogo a la vista, con «Editar» y «Personalizar» por opción (D1 de personalizar-opciones). Sólo con su
                       pestaña elegida, como la tabla de Personas. *@
                    @if (_resumen is { } catalogo && _elegida == Pestana.Opciones)
                    {
                        <div id="catalogo-opciones" class="catalogo-opciones">
                            @for (var i = 0; i < catalogo.Opciones.Count; i++)
                            {
                                var indice = i;
                                var opcion = catalogo.Opciones[indice];
                                var presentacion = PresentacionOpciones?.De(opcion.Id) ?? PresentacionOpcion.PorDefecto;
                                var uri = PresentacionOpciones?.UriImagen(presentacion);
                                var cargo = MensajesAtencion.Cargo(opcion.Moneda, opcion.Escala, opcion.ImporteUnidadesMenores);
                                <article class="opcion-catalogo" data-indice="@indice">
                                    <div class="datos-opcion">
                                        <h4 class="nombre-opcion">@opcion.Nombre</h4>
                                        <span class="servicio-opcion">Servicio: @opcion.Servicio</span>
                                        <span class="importe-opcion">@(cargo.Length > 0 ? "Importe: " + cargo : "Sin cargo")</span>
                                        <ul class="cargas">
                                            @foreach (var carga in opcion.Cargas)
                                            {
                                                <li class="carga">Carga: @carga.Categoria × @carga.Unidades</li>
                                            }
                                        </ul>
                                        <span class="franjas-opcion">@Franjas(opcion)</span>
                                    </div>
                                    <span class="opcion muestra-opcion @PresentacionOpcion.Clase(presentacion, uri)" style="@PresentacionOpcion.EstiloCss(presentacion, uri)">
                                        <span class="nombre">@opcion.Nombre</span>
                                        @if (presentacion.PrecioVisible && cargo.Length > 0)
                                        {
                                            <span class="cargo">@cargo</span>
                                        }
                                    </span>
                                    <div class="acciones-opcion">
                                        <button type="button" class="editar-opcion" disabled="@(_panel is not null)" @onclick="() => EditarOpcion(indice)">@Editar</button>
                                        @if (PresentacionOpciones is not null)
                                        {
                                            <button type="button" class="personalizar-opcion" @onclick="() => AbrirPersonalizacion(opcion)">Personalizar</button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            }
        </section>
        }

        <section role="tabpanel" id="seccion-consumos" class="seccion" aria-labelledby="pestana-consumos" hidden="@Oculta(Pestana.Consumos)">
            @if (Consumos is not null)
            {
                <PestanaConsumos Consulta="Consumos" Visible="@(_elegida == Pestana.Consumos)" Zona="Zona" Registrar="RegistrarConsulta" Sesion="SesionOperador"
                                 Almacen="AlmacenExportacion" Elector="ElectorCarpeta" RegistrarExportacion="RegistrarExportacion" />
            }
        </section>

        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-identidad" class="seccion" aria-labelledby="pestana-identidad" hidden="@Oculta(Pestana.Identidad)">
            <section aria-labelledby="titulo-estilo">
                <h3 id="titulo-estilo">Estilo visual</h3>
                <div class="parametro">
                    <label for="opacidad">Opacidad de las superficies</label>
                    <output id="valor-opacidad" for="opacidad">@Estilo.Opacidad %</output>
                    <input id="opacidad" type="range" min="@EstiloVisual.OpacidadMinima" max="@EstiloVisual.OpacidadMaxima" step="1"
                           value="@Estilo.Opacidad" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Opacidad = valor })" />
                </div>
                <div class="parametro">
                    <label for="desenfoque">Desenfoque del fondo</label>
                    <output id="valor-desenfoque" for="desenfoque">@Estilo.Desenfoque px</output>
                    <input id="desenfoque" type="range" min="@EstiloVisual.DesenfoqueMinimo" max="@EstiloVisual.DesenfoqueMaximo" step="1"
                           value="@Estilo.Desenfoque" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Desenfoque = valor })" />
                </div>
                @if (_avisoEstilo is not null)
                {
                    <p id="aviso-configuracion" class="aviso" role="alert">@_avisoEstilo</p>
                }
                <div class="acciones">
                    <button id="guardar-configuracion" type="button" class="principal" @onclick="GuardarElEstilo">Guardar</button>
                </div>
            </section>
            @if (Logos is not null && GuardarLogo is not null)
            {
                @* Los logos con las reglas de LogosLocales; la vista previa es un img, donde un SVG no ejecuta scripts (D14). *@
                <section class="logos" aria-labelledby="titulo-logos">
                    <h3 id="titulo-logos">Logos</h3>
                    <div class="lista-logos">
                        @foreach (var logo in LogosEditables)
                        {
                            var indice = (int)logo;
                            var clave = logo == LogoPuesto.Empresa ? "empresa" : "concesionaria";
                            var titulo = logo == LogoPuesto.Empresa ? "Logo de la empresa" : "Logo de la concesionaria";
                            <div class="logo-editable">
                                <span id="titulo-logo-@clave">@titulo</span>
                                <div class="cuadricula-logo">
                                    <img id="vista-logo-@clave" src="@VistaLogo(logo)" alt="@titulo" />
                                </div>
                                <InputFile id="@($"archivo-logo-{clave}")" accept=".png,.webp,.svg" aria-labelledby="@($"titulo-logo-{clave}")"
                                           OnChange="e => ElegirLogo(e, logo)" />
                                <button id="ejemplo-logo-@clave" type="button" @onclick="() => VolverAlEjemplo(logo)">Volver al de ejemplo</button>
                                @if (_avisoLogo[indice] is { } aviso)
                                {
                                    <p id="aviso-logo-@clave" class="aviso" role="alert">@aviso</p>
                                }
                            </div>
                        }
                    </div>
                    @if (_avisoLogos is not null)
                    {
                        <p id="aviso-logos" class="aviso" role="alert">@_avisoLogos</p>
                    }
                    @if (HayLogosPendientes)
                    {
                        <div class="acciones">
                            <button id="guardar-logos" type="button" class="principal" @onclick="GuardarLogos">Guardar los logos</button>
                        </div>
                    }
                </section>
            }
        </section>
        }

        <section role="tabpanel" id="seccion-impresora" class="seccion" aria-labelledby="pestana-impresora" hidden="@Oculta(Pestana.Impresora)">
            @if (Impresora is not null)
            {
                <FranjaImpresora Impresora="Impresora" ModoCambiado="ModoImpresoraCambiado" />
            }

            @* La prueba va directo a la impresora del puesto, sin consumo (D13). *@
            @if (ImprimirPrueba is not null)
            {
                <section aria-labelledby="titulo-prueba">
                    <h3 id="titulo-prueba">Prueba de impresión</h3>
                    <p>@MensajesAtencion.PruebaImpresionExplicacion</p>
                    <div class="acciones abrir-paneles">
                        <button id="imprimir-prueba" type="button" @onclick="Probar">Imprimir una prueba</button>
                    </div>
                    @if (_resultadoPrueba is not null)
                    {
                        <p id="resultado-prueba" class="aviso" role="status">@_resultadoPrueba</p>
                    }
                </section>
            }

            @* El encabezado y el pie del comprobante, desde el próximo que sale (D13). *@
            @if (GuardarTextos is not null)
            {
                <section aria-labelledby="titulo-textos" class="textos-comprobante">
                    <h3 id="titulo-textos">Textos del comprobante</h3>
                    <label for="encabezado-comprobante">Encabezado</label>
                    <input id="encabezado-comprobante" type="text" maxlength="@TextosComprobante.LargoEncabezado" value="@_encabezado"
                           aria-invalid="@(_camposTextos.Contains("Encabezado") ? "true" : null)" @oninput="e => _encabezado = e.Value?.ToString() ?? string.Empty" />
                    <label for="pie-comprobante">Pie</label>
                    <input id="pie-comprobante" type="text" maxlength="@TextosComprobante.LargoPie" value="@_pie"
                           aria-invalid="@(_camposTextos.Contains("Pie") ? "true" : null)" @oninput="e => _pie = e.Value?.ToString() ?? string.Empty" />
                    @if (_avisoTextos is not null)
                    {
                        <p id="aviso-textos" class="aviso" role="status">@_avisoTextos</p>
                    }
                    <div class="acciones">
                        <button id="guardar-textos" type="button" class="principal" @onclick="GuardarLosTextos">Guardar</button>
                    </div>
                </section>
            }
        </section>

        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-pantalla" class="seccion" aria-labelledby="pestana-pantalla" hidden="@Oculta(Pestana.Pantalla)">
            @* El monitor del puesto, recordado al volver a abrir; si el guardado no está, el principal y el aviso (D10). *@
            @if (AvisoMonitor is not null)
            {
                <p id="aviso-monitor" class="aviso" role="status">@AvisoMonitor</p>
            }
            <p>@MensajesAtencion.MonitorExplicacion</p>
            <ul class="lista-monitores">
                @for (var i = 0; i < _monitores.Count; i++)
                {
                    var indice = i;
                    var monitor = _monitores[indice];
                    <li>
                        <label class="monitor">
                            <input type="radio" name="monitor-puesto" checked="@(indice == _monitorElegido)" @onchange="() => _monitorElegido = indice" />
                            <span>@(monitor.Nombre ?? monitor.Dispositivo) · @monitor.Area.Ancho × @monitor.Area.Alto@(monitor.Principal ? " · Principal" : "")</span>
                        </label>
                    </li>
                }
            </ul>
            @if (_avisoMonitorError is not null)
            {
                <p id="aviso-monitor-error" class="aviso" role="status">@_avisoMonitorError</p>
            }
            @if (GuardarMonitor is not null && _monitores.Count > 0)
            {
                <div class="acciones">
                    <button id="guardar-monitor" type="button" class="principal" @onclick="GuardarElMonitor">Guardar</button>
                </div>
            }
        </section>

        <section role="tabpanel" id="seccion-red" class="seccion" aria-labelledby="pestana-red" hidden="@Oculta(Pestana.Red)">
            @* La red se lee al elegir la pestaña por primera vez, y la pestaña queda montada después (D2, D11). *@
            @if (_redMontada)
            {
                <PestanaRed Aplicar="AplicarRed" DireccionReceptor="DireccionReceptor" TieneCertificados="TieneCertificados" ProbarConexion="ProbarConexion" />
            }
        </section>
        }

        @* El resumen de una importación, en un cartel como el de «Ver» en Consumos: los totales y los tres botones, o los
           errores fila por fila y «Cerrar» (D4 y D9 de importar-personas-desde-excel). *@
        @if (_revision is { } revision)
        {
            <div class="fondo-cartel">
                <section id="resumen-importacion" class="cartel superficie" role="dialog" aria-modal="true" aria-label="Importar Personas">
                    @if (revision.Valida)
                    {
                        <p id="importacion-totales">@MensajesAtencion.ResumenImportacion(_archivoImportado!, revision.Agregadas, revision.Modificadas, revision.SinCambios)</p>
                        @if (revision.FilasDeEjemplo > 0)
                        {
                            <p id="importacion-ejemplo" class="aviso">@MensajesAtencion.ImportacionConFilasDeEjemplo(revision.FilasDeEjemplo)</p>
                        }
                        @if (revision.CodigosComoNumero > 0)
                        {
                            <p id="importacion-numeros" class="aviso">@MensajesAtencion.ImportacionCodigosComoNumero(revision.CodigosComoNumero)</p>
                        }
                        <p id="importacion-reemplazar">@MensajesAtencion.ImportacionReemplazar(revision.DeBajaAlReemplazar.Count)</p>
                        <p>@MensajesAtencion.ConsumosDeHoyAlImportar</p>
                        <div class="acciones">
                            <button id="importar-modificar" type="button" class="principal" @onclick="() => AplicarImportacion(ModoImportacion.ModificarYAgregar)">Modificar y agregar</button>
                            <button id="importar-reemplazar" type="button" @onclick="() => AplicarImportacion(ModoImportacion.Reemplazar)">Reemplazar</button>
                            <button id="importar-cancelar" type="button" @onclick="CerrarImportacion">Cancelar</button>
                        </div>
                    }
                    else
                    {
                        <p id="importacion-errores">@MensajesAtencion.ImportacionConErrores(revision.Errores.Count)</p>
                        <ul id="errores-importacion">
                            @foreach (var error in revision.Errores)
                            {
                                <li>@MensajesAtencion.ErrorDeImportacion(error)</li>
                            }
                        </ul>
                        <div class="acciones">
                            <button id="importar-cerrar" type="button" class="principal" @onclick="CerrarImportacion">Cerrar</button>
                        </div>
                    }
                </section>
            </div>
        }

        @* La personalización de una opción, en un cartel (D2 de personalizar-opciones): la muestra, el fondo, la imagen, la
           transparencia y el precio; «Guardar» escribe la presentación local y «Cancelar» no escribe nada. *@
        @if (_personalizando is { } aPersonalizar)
        {
            var uriBorrador = _imagenNueva?.UriData ?? PresentacionOpciones?.UriImagen(_borrador);
            var cargoBorrador = MensajesAtencion.Cargo(aPersonalizar.Moneda, aPersonalizar.Escala, aPersonalizar.ImporteUnidadesMenores);
            <div class="fondo-cartel">
                <section id="personalizar-opcion" class="cartel superficie" role="dialog" aria-modal="true" aria-label="Personalizar @aPersonalizar.Nombre">
                    <p class="titulo-cartel">Personalizar «@aPersonalizar.Nombre»</p>
                    <span class="opcion muestra-opcion @PresentacionOpcion.Clase(_borrador, uriBorrador)" style="@PresentacionOpcion.EstiloCss(_borrador, uriBorrador)">
                        <span class="nombre">@aPersonalizar.Nombre</span>
                        @if (_borrador.PrecioVisible && cargoBorrador.Length > 0)
                        {
                            <span class="cargo">@cargoBorrador</span>
                        }
                    </span>
                    <p class="rotulo-cartel">Fondo</p>
                    <div class="colores-opcion" role="group" aria-label="Color de fondo">
                        @for (var c = 0; c < PresentacionOpcion.Paleta.Count; c++)
                        {
                            var color = PresentacionOpcion.Paleta[c];
                            var numero = c + 1;
                            <button type="button" class="color-opcion" style="background-color: @color" aria-label="Color @numero"
                                    aria-pressed="@(_imagenNueva is null && _borrador.Imagen is null && _borrador.Color == color ? "true" : "false")"
                                    @onclick="() => ElegirColor(color)"></button>
                        }
                        <button type="button" class="sin-fondo" aria-pressed="@(uriBorrador is null && _borrador.Color is null ? "true" : "false")"
                                @onclick="() => ElegirColor(null)">Sin fondo</button>
                    </div>
                    <p class="rotulo-cartel">Imagen</p>
                    <div class="imagen-opcion">
                        <InputFile id="archivo-imagen-opcion" accept=".png,.webp,.svg" aria-label="Imagen de fondo" OnChange="ElegirImagen" />
                        @if (uriBorrador is not null)
                        {
                            <button type="button" class="quitar-imagen" @onclick="() => ElegirColor(null)">Quitar imagen</button>
                        }
                    </div>
                    @if (_avisoImagen is not null)
                    {
                        <p id="aviso-imagen-opcion" class="aviso" role="alert">@_avisoImagen</p>
                    }
                    <p class="rotulo-cartel">Transparencia</p>
                    <div class="transparencias-opcion" role="group" aria-label="Transparencia">
                        @foreach (var paso in PresentacionOpcion.Transparencias)
                        {
                            <button type="button" class="transparencia-opcion" aria-pressed="@(_borrador.Transparencia == paso ? "true" : "false")"
                                    @onclick="() => _borrador = _borrador with { Transparencia = paso }">@paso %</button>
                        }
                    </div>
                    <button type="button" id="precio-visible" aria-pressed="@(_borrador.PrecioVisible ? "true" : "false")"
                            @onclick="() => _borrador = _borrador with { PrecioVisible = !_borrador.PrecioVisible }">Mostrar el precio</button>
                    <div class="acciones">
                        <button id="guardar-presentacion" type="button" class="principal" @onclick="GuardarPresentacion">Guardar</button>
                        <button id="cancelar-presentacion" type="button" @onclick="CerrarPersonalizacion">Cancelar</button>
                    </div>
                </section>
            </div>
        }

        <div class="acciones pie-dialogo">
            @* Exportar e importar Personas van en el pie, a la izquierda de «Cerrar», para que la tabla conserve sus diez filas a
               la vista a 1024 × 768 (D5 y D6 de editar-raciones-en-personas, D9 de importar-personas-desde-excel). Sólo con
               Personas en lectura; los cuatro del mismo ancho. *@
            @if (_elegida == Pestana.Personas && _panel is null && Administracion is not null && (PuedeExportarPersonas || PuedeImportarPersonas))
            {
                <div class="exportar-personas">
                    @if (PuedeExportarPersonas)
                    {
                        <button id="exportar-personas-csv" type="button" @onclick="() => ExportarPersonas(FormatoExportacion.Csv)">Exportar CSV</button>
                        <button id="exportar-personas-xlsx" type="button" @onclick="() => ExportarPersonas(FormatoExportacion.Xlsx)">Exportar Excel</button>
                    }
                    @if (PuedeImportarPersonas)
                    {
                        <button id="importar-personas" type="button" @onclick="ImportarPersonas">Importar Excel</button>
                    }
                    @if (PuedeExportarPersonas)
                    {
                        <button id="planilla-personas" type="button" @onclick="EscribirPlanillaDeEjemplo">Planilla de ejemplo</button>
                    }
                </div>
                @if (_mensajeExportacionPersonas is not null)
                {
                    <p id="mensaje-exportacion-personas" class="@(_exportacionPersonasFallida ? "aviso" : "mensaje-exportacion")" role="status">@_mensajeExportacionPersonas</p>
                }
            }
            @* «Cerrar»: cada pestaña guarda lo suyo, así que el pie cierra y descarta lo no guardado; el id se conserva (D2 de ordenar-configuracion). *@
            <button id="cancelar-configuracion" type="button" @onclick="Cancelar">Cerrar</button>
