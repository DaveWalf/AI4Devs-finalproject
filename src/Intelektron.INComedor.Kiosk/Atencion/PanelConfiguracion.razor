    protected override async Task OnAfterRenderAsync(bool primera)
    {
        // El foco entra al diálogo para que Escape funcione sin tocarlo antes; con el teclado, sigue a la pestaña elegida.
        if (primera)
        {
            await _dialogo.FocusAsync();
        }
        else if (_enfocarPestana)
        {
            _enfocarPestana = false;
            await _botones[(int)_elegida].FocusAsync();
        }

        // Al cerrar el cartel, el foco vuelve al «Personalizar» de esa opción (D2 de personalizar-opciones).
        if (_devolverFocoA is { } indice && _personalizando is null)
        {
            _devolverFocoA = null;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", $"#catalogo-opciones article.opcion-catalogo[data-indice=\"{indice}\"] button.personalizar-opcion");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }

        // El foco entra al cartel de personalización, en el primer color (D2 de personalizar-opciones).
        if (_enfocarPersonalizacion && _personalizando is not null)
        {
            _enfocarPersonalizacion = false;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", "#personalizar-opcion button.color-opcion");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }

        // El foco entra al resumen de un resguardo, en «Cancelar» o «Cerrar» (D4 de resguardar-configuracion).
        if (_enfocarCartelResguardo && _revisionResguardo is not null)
        {
            _enfocarCartelResguardo = false;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", "#resumen-resguardo .acciones button.principal");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }

        // El foco entra al resumen de una importación de Opciones, en su primer botón (D4 de importar-opciones-desde-excel).
        if (_enfocarCartelOpciones && _revisionOpciones is not null)
        {
            _enfocarCartelOpciones = false;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", "#resumen-importacion-opciones .acciones button.principal");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }

        // El foco entra al resumen de una importación, en su primer botón (D9 de importar-personas-desde-excel).
        if (_enfocarCartel && _revision is not null)
        {
            _enfocarCartel = false;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", "#resumen-importacion .acciones button");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }
    }

