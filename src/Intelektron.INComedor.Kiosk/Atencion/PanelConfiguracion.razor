        @* La exportación automática de consumos, antes de General y sólo con la clave del día (D6 de exportar-consumos-automaticamente). *@
        <section role="tabpanel" id="seccion-exportacion" class="seccion" aria-labelledby="pestana-exportacion" hidden="@Oculta(Pestana.Exportacion)">
            @if (Exportacion is not null && GuardarExportacion is not null)
            {
                <section aria-labelledby="titulo-exportacion" class="textos-comprobante datos-comprobante">
                    <h3 id="titulo-exportacion">Exportación automática de consumos</h3>
                    <span id="rotulo-exportacion-activa" class="rotulo">Exportación</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-exportacion-activa">
                        <button id="exportacion-activa" type="button" aria-pressed="@(_exportacionActiva ? "true" : "false")" @onclick="() => _exportacionActiva = true">Activa</button>
                        <button id="exportacion-apagada" type="button" aria-pressed="@(_exportacionActiva ? "false" : "true")" @onclick="() => _exportacionActiva = false">Apagada</button>
                    </div>
                    <label for="minutos-exportacion">Cada cuántos minutos</label>
                    <input id="minutos-exportacion" type="text" inputmode="numeric" maxlength="4" value="@_minutosExportacion"
                           aria-invalid="@(_camposExportacion.Contains("Minutos") ? "true" : null)" @oninput="e => _minutosExportacion = e.Value?.ToString() ?? string.Empty" />
                    <span id="rotulo-archivo-exportacion" class="rotulo">Archivo</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-archivo-exportacion">
                        <button id="archivo-que-crece" type="button" aria-pressed="@(_archivoPorDia ? "false" : "true")" @onclick="() => _archivoPorDia = false">Un archivo que crece</button>
                        <button id="archivo-por-dia" type="button" aria-pressed="@(_archivoPorDia ? "true" : "false")" @onclick="() => _archivoPorDia = true">Un archivo por día</button>
                    </div>
                    <label for="carpeta-exportacion">Carpeta</label>
                    <div class="numeracion">
                        <input id="carpeta-exportacion" type="text" maxlength="240" value="@_carpetaExportacion"
                               aria-invalid="@(_camposExportacion.Contains("Carpeta") ? "true" : null)" @oninput="e => _carpetaExportacion = e.Value?.ToString() ?? string.Empty" />
                        @if (ElectorCarpeta is not null)
                        {
                            <button id="elegir-carpeta-exportacion" type="button" @onclick="ElegirCarpetaExportacion">Elegir</button>
                        }
                    </div>
                    <span id="rotulo-sftp" class="rotulo">SFTP simulado</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-sftp">
                        <button id="sftp-activo" type="button" aria-pressed="@(_sftpActivo ? "true" : "false")" @onclick="() => _sftpActivo = true">Activo</button>
                        <button id="sftp-apagado" type="button" aria-pressed="@(_sftpActivo ? "false" : "true")" @onclick="() => _sftpActivo = false">Apagado</button>
                    </div>
                    <label for="servidor-sftp">Servidor</label>
                    <input id="servidor-sftp" type="text" maxlength="100" value="@_servidorSftp"
                           aria-invalid="@(_camposExportacion.Contains("Servidor") ? "true" : null)" @oninput="e => _servidorSftp = e.Value?.ToString() ?? string.Empty" />
                    <label for="puerto-sftp">Puerto</label>
                    <input id="puerto-sftp" type="text" inputmode="numeric" maxlength="5" value="@_puertoSftp"
                           aria-invalid="@(_camposExportacion.Contains("Puerto") ? "true" : null)" @oninput="e => _puertoSftp = e.Value?.ToString() ?? string.Empty" />
                    <label for="usuario-sftp">Usuario</label>
                    <input id="usuario-sftp" type="text" maxlength="50" value="@_usuarioSftp"
                           aria-invalid="@(_camposExportacion.Contains("Usuario") ? "true" : null)" @oninput="e => _usuarioSftp = e.Value?.ToString() ?? string.Empty" />
                    <label for="carpeta-remota-sftp">Carpeta remota</label>
                    <input id="carpeta-remota-sftp" type="text" maxlength="200" value="@_carpetaRemotaSftp"
                           aria-invalid="@(_camposExportacion.Contains("CarpetaRemota") ? "true" : null)" @oninput="e => _carpetaRemotaSftp = e.Value?.ToString() ?? string.Empty" />
                    <span id="rotulo-servidor-simulado" class="rotulo">Servidor simulado</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-servidor-simulado">
                        <button id="sftp-disponible" type="button" aria-pressed="@(Exportacion.SftpCaido ? "false" : "true")" @onclick="() => CambiarSftp(false)">Disponible</button>
                        <button id="sftp-caido" type="button" aria-pressed="@(Exportacion.SftpCaido ? "true" : "false")" @onclick="() => CambiarSftp(true)">Caído</button>
                    </div>
                    @if (_avisoExportacion is not null)
                    {
                        <p id="aviso-exportacion" class="aviso" role="status">@_avisoExportacion</p>
                    }
                    <div class="acciones">
                        <button id="exportar-ahora" type="button" disabled="@_exportando" @onclick="ExportarAhora">@(_exportando ? "Exportando…" : "Exportar ahora")</button>
                        <button id="guardar-exportacion" type="button" class="principal" @onclick="GuardarLaExportacion">Guardar</button>
                    </div>
                </section>
                <section aria-labelledby="titulo-estado-exportacion" class="estado-exportacion">
                    <h3 id="titulo-estado-exportacion">Estado de los destinos</h3>
                    @{ var estados = Exportacion.Estado; }
                    <ul>
                        <li id="estado-exportacion-carpeta">@MensajesAtencion.EstadoExportacion(ExportacionAutomatica.Carpeta, estados.GetValueOrDefault(ExportacionAutomatica.Carpeta), Zona)</li>
                        <li id="estado-exportacion-sftp">@MensajesAtencion.EstadoExportacion(ExportacionAutomatica.Sftp, estados.GetValueOrDefault(ExportacionAutomatica.Sftp), Zona)</li>
                    </ul>
                    @if (_mensajeExportacion is not null)
                    {
                        <p id="mensaje-exportacion-automatica" class="@(_exportacionFallida ? "aviso" : "mensaje-exportacion")" role="status">@_mensajeExportacion</p>
                    }
                </section>
            }
        </section>
        }

        @* El resumen de una importación, en un cartel como el de «Ver» en Consumos: los totales y los tres botones, o los
           errores fila por fila y «Cerrar» (D4 y D9 de importar-personas-desde-excel). *@
        @if (_revision is { } revision)
        {
            <div class="fondo-cartel">
                <section id="resumen-importacion" class="cartel superficie" role="dialog" aria-modal="true" aria-label="Importar Personas">
                    @if (revision.Valida)
                    {
                        <p id="importacion-totales">@MensajesAtencion.ResumenImportacion(_archivoImportado!, revision.Agregadas, revision.Modificadas, revision.SinCambios,
                                                         revision.PermisosDados, revision.PermisosQuitados)</p>
                        @if (revision.FilasDeEjemplo > 0)
                        {
                            <p id="importacion-ejemplo" class="aviso">@MensajesAtencion.ImportacionConFilasDeEjemplo(revision.FilasDeEjemplo)</p>
                        }
                        @if (revision.CodigosComoNumero > 0)
                        {
                            <p id="importacion-numeros" class="aviso">@MensajesAtencion.ImportacionCodigosComoNumero(revision.CodigosComoNumero)</p>
                        }
                        <p id="importacion-reemplazar">@MensajesAtencion.ImportacionReemplazar(revision.DeBajaAlReemplazar.Count)</p>
                        <p>@MensajesAtencion.ConsumosDeHoyAlImportar</p>
                        <div class="acciones">
                            <button id="importar-modificar" type="button" class="principal" @onclick="() => AplicarImportacion(ModoImportacion.ModificarYAgregar)">Modificar y agregar</button>
                            <button id="importar-reemplazar" type="button" @onclick="() => AplicarImportacion(ModoImportacion.Reemplazar)">Reemplazar</button>
                            <button id="importar-cancelar" type="button" @onclick="CerrarImportacion">Cancelar</button>
                        </div>
                    }
                    else
                    {
                        <p id="importacion-errores">@MensajesAtencion.ImportacionConErrores(revision.Errores.Count)</p>
                        <ul id="errores-importacion">
                            @foreach (var error in revision.Errores)
                            {
                                <li>@MensajesAtencion.ErrorDeImportacion(error)</li>
                            }
                        </ul>
                        <div class="acciones">
                            <button id="importar-cerrar" type="button" class="principal" @onclick="CerrarImportacion">Cerrar</button>
                        </div>
                    }
                </section>
            </div>
        }

        @* La personalización de una opción, en un cartel (D2 de personalizar-opciones): la muestra, el fondo, la imagen, la
           transparencia y el precio; «Guardar» escribe la presentación local y «Cancelar» no escribe nada. *@
        @if (_personalizando is { } aPersonalizar)
        {
            var uriBorrador = _imagenNueva?.UriData ?? PresentacionOpciones?.UriImagen(_borrador);
            var cargoBorrador = MensajesAtencion.Cargo(aPersonalizar.Moneda, aPersonalizar.Escala, aPersonalizar.ImporteUnidadesMenores);
            <div class="fondo-cartel">
                <section id="personalizar-opcion" class="cartel superficie" role="dialog" aria-modal="true" aria-label="Personalizar @aPersonalizar.Nombre">
                    <p class="titulo-cartel">Personalizar «@aPersonalizar.Nombre»</p>
                    <span class="opcion muestra-opcion @PresentacionOpcion.Clase(_borrador, uriBorrador)" style="@PresentacionOpcion.EstiloCss(_borrador, uriBorrador)">
                        <span class="nombre">@aPersonalizar.Nombre</span>
                        @if (_borrador.PrecioVisible && cargoBorrador.Length > 0)
                        {
                            <span class="cargo">@cargoBorrador</span>
                        }
                    </span>
                    <p class="rotulo-cartel">Fondo</p>
                    <div class="colores-opcion" role="group" aria-label="Color de fondo">
                        @for (var c = 0; c < PresentacionOpcion.Paleta.Count; c++)
                        {
                            var color = PresentacionOpcion.Paleta[c];
                            var numero = c + 1;
                            <button type="button" class="color-opcion" style="background-color: @color" aria-label="Color @numero"
                                    aria-pressed="@(_imagenNueva is null && _borrador.Imagen is null && _borrador.Color == color ? "true" : "false")"
                                    @onclick="() => ElegirColor(color)"></button>
                        }
                        <button type="button" class="sin-fondo" aria-pressed="@(uriBorrador is null && _borrador.Color is null ? "true" : "false")"
                                @onclick="() => ElegirColor(null)">Sin fondo</button>
                    </div>
                    <p class="rotulo-cartel">Imagen</p>
                    <div class="imagen-opcion">
                        <InputFile id="archivo-imagen-opcion" accept=".png,.webp,.svg" aria-label="Imagen de fondo" OnChange="ElegirImagen" />
                        @if (uriBorrador is not null)
                        {
                            <button type="button" class="quitar-imagen" @onclick="() => ElegirColor(null)">Quitar imagen</button>
                        }
                    </div>
                    @if (_avisoImagen is not null)
                    {
                        <p id="aviso-imagen-opcion" class="aviso" role="alert">@_avisoImagen</p>
                    }
                    <p class="rotulo-cartel">Transparencia</p>
                    <div class="transparencias-opcion" role="group" aria-label="Transparencia">
                        @foreach (var paso in PresentacionOpcion.Transparencias)
                        {
                            <button type="button" class="transparencia-opcion" aria-pressed="@(_borrador.Transparencia == paso ? "true" : "false")"
                                    disabled="@(uriBorrador is null && _borrador.Color is null)"
                                    @onclick="() => _borrador = _borrador with { Transparencia = paso }">@paso %</button>
                        }
                    </div>
                    @* Sin cargo no hay precio que mostrar u ocultar. *@
                    @if (cargoBorrador.Length > 0)
                    {
                        <button type="button" id="precio-visible" aria-pressed="@(_borrador.PrecioVisible ? "true" : "false")"
                                @onclick="() => _borrador = _borrador with { PrecioVisible = !_borrador.PrecioVisible }">Mostrar el precio</button>
                    }
                    @if (_avisoPresentacion is not null)
                    {
                        <p id="aviso-presentacion" class="aviso" role="alert">@_avisoPresentacion</p>
                    }
                    <div class="acciones">
                        <button id="guardar-presentacion" type="button" class="principal" @onclick="GuardarPresentacion">Guardar</button>
                        <button id="cancelar-presentacion" type="button" @onclick="CerrarPersonalizacion">Cancelar</button>
                    </div>
                </section>
            </div>
        }

        @* El resumen de una importación de Opciones: los totales con «Reemplazar» y «Cancelar», o los errores fila por fila y
           «Cerrar» (D4 de importar-opciones-desde-excel). *@
        @if (_revisionOpciones is { } revisionOpciones)
        {
            <div class="fondo-cartel">
                <section id="resumen-importacion-opciones" class="cartel superficie" role="dialog" aria-modal="true" aria-label="Importar Opciones">
                    @if (revisionOpciones.Valida)
                    {
                        <p id="importacion-opciones-totales">@MensajesAtencion.ResumenImportacionOpciones(_archivoOpciones!, revisionOpciones.Agregadas, revisionOpciones.Modificadas, revisionOpciones.SinCambios, revisionOpciones.Quitadas)</p>
                        @* Las que se quitan, por su nombre: un cambio de nombre es una quitada y una agregada (D2). *@
                        @if (revisionOpciones.Quitadas > 0)
                        {
                            <ul id="opciones-que-se-quitan">
                                @foreach (var quitada in revisionOpciones.Opciones.Where(o => o.Accion == AccionOpcionImportada.Quitada))
                                {
                                    <li>@quitada.Nombre</li>
                                }
                            </ul>
                        }
                        @if (revisionOpciones.FilasDeEjemplo > 0)
                        {
                            <p id="importacion-opciones-ejemplo" class="aviso">@MensajesAtencion.ImportacionOpcionesConFilasDeEjemplo(revisionOpciones.FilasDeEjemplo)</p>
                        }
                        <p>@MensajesAtencion.ReemplazarOpciones</p>
                        @* «Reemplazar» quita opciones: el botón destacado y el foco van a «Cancelar». *@
                        <div class="acciones">
                            <button id="importar-opciones-reemplazar" type="button" @onclick="AplicarImportacionOpciones">Reemplazar</button>
                            <button id="importar-opciones-cancelar" type="button" class="principal" @onclick="CerrarImportacionOpciones">Cancelar</button>
                        </div>
                    }
                    else
                    {
                        <p>@MensajesAtencion.ImportacionConErrores(revisionOpciones.Errores.Count)</p>
                        <ul id="errores-importacion-opciones">
                            @foreach (var error in revisionOpciones.Errores)
                            {
                                <li>@MensajesAtencion.ErrorDeImportacionOpciones(error)</li>
                            }
                        </ul>
                        <div class="acciones">
                            <button id="importar-opciones-cerrar" type="button" class="principal" @onclick="CerrarImportacionOpciones">Cerrar</button>
                        </div>
                    }
                </section>
            </div>
        }

        @* El resumen de un resguardo: de dónde viene, qué trae y «Recuperar» o «Cancelar», o el motivo y «Cerrar» (D4 de
           resguardar-configuracion). Recuperar reemplaza todo: el botón destacado y el foco van a «Cancelar». *@
        @if (_revisionResguardo is { } revisionResguardo)
        {
            <div class="fondo-cartel">
                <section id="resumen-resguardo" class="cartel superficie" role="dialog" aria-modal="true" aria-label="Recuperar resguardo">
                    @if (revisionResguardo.Resguardo is { } resguardo)
                    {
                        <p id="resguardo-origen">@MensajesAtencion.ResumenResguardo(_archivoResguardo!, resguardo, Zona)</p>
                        <p id="resguardo-ajustes">@MensajesAtencion.AjustesDelResguardo(resguardo)</p>
                        <p>@MensajesAtencion.RecuperarReemplaza</p>
                        <div class="acciones">
                            <button id="resguardo-recuperar" type="button" @onclick="RecuperarResguardo">Recuperar</button>
                            <button id="resguardo-cancelar" type="button" class="principal" @onclick="CerrarResguardo">Cancelar</button>
                        </div>
                    }
                    else
                    {
                        <p id="resguardo-rechazado">@MensajesAtencion.ResguardoRechazado(_archivoResguardo!, revisionResguardo.Motivo!)</p>
                        <div class="acciones">
                            <button id="resguardo-cerrar" type="button" class="principal" @onclick="CerrarResguardo">Cerrar</button>
                        </div>
                    }
                </section>
            </div>
        }

        <div class="acciones pie-dialogo">
            @* Exportar e importar Personas van en el pie, a la izquierda de «Cerrar», para que la tabla conserve sus diez filas a
               la vista a 1024 × 768 (D5 y D6 de editar-raciones-en-personas, D9 de importar-personas-desde-excel). Sólo con
               Personas en lectura; los cuatro del mismo ancho. *@
            @if (_elegida == Pestana.Personas && _panel is null && Administracion is not null && (PuedeExportarPersonas || PuedeImportarPersonas))
            {
                <div class="exportar-personas">
                    @if (PuedeExportarPersonas)
                    {
                        <button id="exportar-personas-csv" type="button" @onclick="() => ExportarPersonas(FormatoExportacion.Csv)">Exportar CSV</button>
                        <button id="exportar-personas-xlsx" type="button" @onclick="() => ExportarPersonas(FormatoExportacion.Xlsx)">Exportar Excel</button>
                    }
                    @if (PuedeImportarPersonas)
                    {
                        <button id="importar-personas" type="button" @onclick="ImportarPersonas">Importar Excel</button>
                    }
                    @if (PuedeExportarPersonas)
                    {
                        <button id="planilla-personas" type="button" @onclick="EscribirPlanillaDeEjemplo">Planilla de ejemplo</button>
                    }
                </div>
                @if (_mensajeExportacionPersonas is not null)
                {
                    <p id="mensaje-exportacion-personas" class="@(_exportacionPersonasFallida ? "aviso" : "mensaje-exportacion")" role="status">@_mensajeExportacionPersonas</p>
                }
            }
            @* Exportar, importar y la planilla base de Opciones, en el pie como los de Personas (D6 de importar-opciones-desde-excel). *@
            @if (_elegida == Pestana.Opciones && _panel is null && Operador is null && Administracion is not null && (PuedeExportarPersonas || PuedeImportarPersonas))
            {
                <div class="exportar-personas archivos-opciones">
                    @if (PuedeExportarPersonas)
                    {
                        <button id="exportar-opciones" type="button" @onclick="ExportarOpciones">Exportar Excel</button>
                    }
                    @if (PuedeImportarPersonas)
                    {
                        <button id="importar-opciones" type="button" @onclick="ImportarOpciones">Importar Excel</button>
                    }
                    @if (PuedeExportarPersonas)
                    {
                        <button id="planilla-opciones" type="button" @onclick="EscribirPlanillaOpciones">Planilla base</button>
                    }
                </div>
                @if (_mensajeArchivosOpciones is not null)
                {
                    <p id="mensaje-archivos-opciones" class="@(_archivosOpcionesFallido ? "aviso" : "mensaje-exportacion")" role="status">@_mensajeArchivosOpciones</p>
                }
            }
            @* «Cerrar»: cada pestaña guarda lo suyo, así que el pie cierra y descarta lo no guardado; el id se conserva (D2 de ordenar-configuracion). *@
            <button id="cancelar-configuracion" type="button" @onclick="Cancelar">Cerrar</button>
        </div>
    </div>
</div>

@code {
    /// <summary>Las pestañas en el orden en que se muestran: Consumos primero y General al final (D1 de ordenar-configuracion).</summary>
    private enum Pestana
    {
        Consumos,
        Personas,
        Opciones,
        Identidad,
        Impresora,
        Mails,
        Pantalla,
        Red,
        Lector,
        Exportacion,
        General,
    }

    private enum Panel
    {
        Personas,
        Opciones,
    }

    private static readonly Pestana[] Todas = Enum.GetValues<Pestana>();

    /// <summary>Las tres de un operador, en este orden (D6 de entrar-a-configuracion-con-teclado).</summary>
    private static readonly Pestana[] DelOperador = [Pestana.Consumos, Pestana.Personas, Pestana.Impresora];

    /// <summary>Las once con la clave del día; con un operador, sólo las suyas.</summary>
    private Pestana[] Visibles => Operador is null ? Todas : DelOperador;

    private readonly ElementReference[] _botones = new ElementReference[Todas.Length];
    private ElementReference _dialogo;
    private Pestana _elegida = Pestana.Consumos;
    private static readonly LogoPuesto[] LogosEditables = [LogoPuesto.Empresa, LogoPuesto.Concesionaria];
    private readonly LogoElegido?[] _logoPendiente = new LogoElegido?[2];
    private readonly bool[] _logoAlEjemplo = new bool[2];
    private readonly string?[] _avisoLogo = new string?[2];
    private string? _avisoLogos;
    private bool _redMontada;
    private bool _enfocarPestana;
    private Panel? _panel;
    private string? _mensajeExportacionPersonas;

    /// <summary>El teclado en pantalla de Personas, visible hasta que se oculte; dura lo que dura Configuración abierta (D4).</summary>
    private bool _tecladoPersonasVisible = true;
    private bool _exportacionPersonasFallida;

    /// <summary>
    /// Exporta Personas a la carpeta de la exportación de Consumos; sin carpeta guardada, la pide y la guarda; si se cancela,
    /// no exporta. Sin poder escribir, avisa y la general no registra nada (D5 de editar-raciones-en-personas).
    /// </summary>
    private void ExportarPersonas(FormatoExportacion formato)
    {
        if (CarpetaDeExportacion(out var avisoCarpeta) is not { } carpeta)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.SinCarpeta, true);
            return;
        }

        ResultadoExportacionPersonas resultado;
        try
        {
            resultado = new ExportacionPersonas(Administracion!, Administracion!.Reloj).Exportar(formato, carpeta, Zona);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.ExportacionPersonasFallida, true);
            return;
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.ConfiguracionNoLeida, true);
            return;
        }

        _exportacionPersonasFallida = avisoCarpeta is not null;
        _mensajeExportacionPersonas = string.Join(' ', new[]
        {
            avisoCarpeta, MensajesAtencion.ExportacionPersonasHecha(resultado.Archivo, resultado.Filas, carpeta),
        }.OfType<string>());
        RegistrarExportacionPersonas?.Invoke(new PanelPersonas.ExportacionPersonasRealizada(
            formato == FormatoExportacion.Csv ? "CSV" : "XLSX", resultado.Archivo, resultado.Filas));
    }

    /// <summary>
    /// Una importación aplicada, para la general: la huella SHA-256 del archivo, no su nombre, que lo escribe cualquiera y
    /// puede tener un código; el modo y cada persona (D8 de importar-personas-desde-excel).
    /// </summary>
    public sealed record ImportacionPersonasRealizada(string? Huella, ModoImportacion Modo, ResultadoImportacion Resultado);

    /// <summary>Una importación con errores, para la general: la huella del archivo y sus errores, de los que se registran sólo los motivos (D8).</summary>
    public sealed record ImportacionPersonasRechazada(string? Huella, IReadOnlyList<ErrorImportacion> Errores);

    private RevisionImportacion? _revision;
    private string? _archivoImportado;
    private string? _huellaImportada;
    private bool _enfocarCartel;
    private int _recargaPersonas;

    private bool PuedeExportarPersonas => AlmacenExportacion is not null && ElectorCarpeta is not null;

    private bool PuedeImportarPersonas => ElectorArchivo is not null && _resumen?.SoloLectura != true;

    /// <summary>
    /// La carpeta de la exportación de Consumos; sin una guardada, la pide y la guarda, y si no se pudo guardar lo dice en
    /// <paramref name="avisoCarpeta"/>. Null si se cancela la elección (D5 de editar-raciones-en-personas).
    /// </summary>
    private string? CarpetaDeExportacion(out string? avisoCarpeta)
    {
        avisoCarpeta = null;
        if (AlmacenExportacion!.Leer() is { } guardada)
        {
            return guardada;
        }

        if (ElectorCarpeta!.Elegir(null) is not { } carpeta)
        {
            return null;
        }

        try
        {
            AlmacenExportacion.Guardar(carpeta);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            avisoCarpeta = MensajesAtencion.CarpetaNoGuardada;
        }

        return carpeta;
    }

    /// <summary>
    /// «Planilla de ejemplo»: la escribe en la carpeta de la exportación, como exportar (D6 de importar-personas-desde-excel).
    /// No queda en la general: no tiene datos de nadie.
    /// </summary>
    private void EscribirPlanillaDeEjemplo()
    {
        if (CarpetaDeExportacion(out var avisoCarpeta) is not { } carpeta)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.SinCarpeta, true);
            return;
        }

        string archivo;
        try
        {
            archivo = new ImportacionPersonas(Administracion!).EscribirPlanillaDeEjemplo(carpeta, Zona);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.PlanillaFallida, true);
            return;
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.ConfiguracionNoLeida, true);
            return;
        }

        _exportacionPersonasFallida = avisoCarpeta is not null;
        _mensajeExportacionPersonas = string.Join(' ', new[] { avisoCarpeta, MensajesAtencion.PlanillaDeEjemploHecha(archivo, carpeta) }.OfType<string>());
    }

    /// <summary>
    /// «Importar Excel»: pide el archivo, lo revisa sin escribir nada y muestra el resumen (D4 y D7). Una planilla con errores
    /// queda en la general como PEOPLE_IMPORT_REJECTED (D8); cancelar la elección no hace nada.
    /// </summary>
    private void ImportarPersonas()
    {
        _mensajeExportacionPersonas = null;
        if (ElectorArchivo!.Elegir(AlmacenExportacion?.Leer()) is not { } ruta)
        {
            return;
        }

        var archivo = System.IO.Path.GetFileName(ruta);
        RevisionImportacion revision;
        string? huella;
        try
        {
            // Compartido para leer aunque Excel lo tenga abierto. La huella, sólo de un archivo que se va a leer: uno de más de
            // 5 MB se rechaza sin leerlo.
            using var flujo = new System.IO.FileStream(ruta, System.IO.FileMode.Open, System.IO.FileAccess.Read,
                System.IO.FileShare.ReadWrite | System.IO.FileShare.Delete);
            huella = flujo.Length <= LectorPlanilla.TamanoMaximo ? Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(flujo)) : null;
            flujo.Position = 0;
            // Con un operador, su propia fila no puede cambiar su permiso (D2 de marcar-operadores-en-personas).
            revision = new ImportacionPersonas(Administracion!).Revisar(flujo, Actor);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.ArchivoNoLeido, true);
            return;
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeExportacionPersonas, _exportacionPersonasFallida) = (MensajesAtencion.ConfiguracionNoLeida, true);
            return;
        }

        (_revision, _archivoImportado, _huellaImportada, _enfocarCartel) = (revision, archivo, huella, true);
        if (!revision.Valida)
        {
            RegistrarImportacionRechazada?.Invoke(new ImportacionPersonasRechazada(huella, revision.Errores));
        }
    }

    /// <summary>
    /// Aplica el resumen en el modo tocado, con el operador como actor, y vuelve a leer la tabla. Si la configuración cambió
    /// desde el resumen, el guardado lo rechaza y no se aplica nada (D4).
    /// </summary>
    private void AplicarImportacion(ModoImportacion modo)
    {
        var (revision, huella) = (_revision!, _huellaImportada);
        CerrarImportacion();
        ResultadoImportacion resultado;
        try
        {
            resultado = new ImportacionPersonas(Administracion!).Aplicar(revision, modo, Actor);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _avisoGuardado = MensajesAtencion.PanelNoGuardado;
            return;
        }

        switch (resultado.Guardado.Tipo)
        {
            case TipoGuardado.Aplicado:
                var dadas = resultado.Personas.Count(p => p.Accion == AccionImportada.DadaDeBaja);
                _avisoGuardado = revision.Agregadas + revision.Modificadas + dadas > 0
                    ? MensajesAtencion.ImportacionAplicada(resultado.Guardado.VersionActiva, revision.Agregadas, revision.Modificadas, dadas)
                    : MensajesAtencion.ImportacionSinCambios(resultado.Guardado.VersionActiva);
                RegistrarImportacionPersonas?.Invoke(new ImportacionPersonasRealizada(huella, modo, resultado));
                break;
            case TipoGuardado.Denegado:
                _avisoGuardado = MensajesAtencion.INWebAdministra;
                break;
            default:
                _avisoGuardado = MensajesAtencion.ImportacionRechazada;
                break;
        }

        LeerResumen();
        _recargaPersonas++;
    }

    /// <summary>
    /// Un guardado de la presentación, para la general (D5 de personalizar-opciones): la opción, cómo estaba, cómo se pidió
    /// (con la huella de una imagen elegida y todavía no guardada), el resultado y cómo quedó vigente.
    /// </summary>
    public sealed record PresentacionGuardada(
        Guid Opcion, PresentacionOpcion Antes, PresentacionOpcion Despues, string? HuellaPedida, string Resultado, PresentacionOpcion Vigente);

    private int? _opcionAEnfocar;
    private OpcionAdministrada? _personalizando;
    private PresentacionOpcion _borrador = PresentacionOpcion.PorDefecto;
    private LogoElegido? _imagenNueva;
    private string? _avisoImagen;
    private string? _avisoPresentacion;
    private bool _enfocarPersonalizacion;
    private int? _devolverFocoA;
    private int _indicePersonalizado;

    /// <summary>«Editar» en una opción abre la edición de siempre en el lugar del catálogo, con el nombre de esa opción enfocado (D1).</summary>
    private void EditarOpcion(int indice)
    {
        AbrirPanel(Panel.Opciones);
        _opcionAEnfocar = indice;
    }

    private static string Franjas(OpcionAdministrada opcion) => opcion.Franjas.Count == 0
        ? "Todo el día"
        : string.Join(", ", opcion.Franjas.Select(f =>
            $"{f.Inicio.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)} a {f.Fin.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)}"));

    private void AbrirPersonalizacion(OpcionAdministrada opcion, int indice)
    {
        _avisoGuardado = null;
        (_personalizando, _borrador, _imagenNueva, _avisoImagen, _avisoPresentacion, _enfocarPersonalizacion, _indicePersonalizado) =
            (opcion, PresentacionOpciones!.De(opcion.Id), null, null, null, true, indice);
    }

    /// <summary>Cierra el cartel y devuelve el foco al «Personalizar» que lo abrió.</summary>
    private void CerrarPersonalizacion()
    {
        (_personalizando, _imagenNueva, _avisoImagen, _avisoPresentacion) = (null, null, null, null);
        _devolverFocoA = _indicePersonalizado;
    }

    /// <summary>Un color de la paleta, o ninguno con null; cualquiera de los dos quita la imagen (D2).</summary>
    private void ElegirColor(string? color)
    {
        _borrador = _borrador with { Color = color, Imagen = null };
        _imagenNueva = null;
        _avisoImagen = null;
    }

    /// <summary>Una imagen de fondo, con las reglas de los logos; la válida quita el color, la inválida deja el aviso (D2).</summary>
    private async Task ElegirImagen(InputFileChangeEventArgs e)
    {
        // Un archivo nuevo reemplaza al elegido antes, también si es inválido, como un logo.
        _avisoImagen = null;
        _imagenNueva = null;
        var archivo = e.File;
        byte[] contenido = [];
        if (archivo.Size <= LogosLocales.TamanoMaximo)
        {
            try
            {
                await using var flujo = archivo.OpenReadStream(LogosLocales.TamanoMaximo + 1);
                using var memoria = new System.IO.MemoryStream();
                await flujo.CopyToAsync(memoria);
                contenido = memoria.ToArray();
            }
            catch (System.IO.IOException)
            {
                _avisoImagen = MensajesAtencion.LogoInvalido;
                return;
            }
        }

        var validacion = LogosLocales.Validar(archivo.Name, archivo.Size, contenido);
        if (validacion.Logo is null)
        {
            _avisoImagen = validacion.Motivo;
            return;
        }

        _imagenNueva = validacion.Logo;
        _borrador = _borrador with { Color = null, Imagen = null };
    }

    /// <summary>
    /// Guarda la presentación local, sin crear versión, y la deja en la general con el antes, el después y el resultado,
    /// también si no se pudo escribir: entonces el cartel sigue abierto con el aviso (D3 y D5).
    /// </summary>
    private void GuardarPresentacion()
    {
        var opcion = _personalizando!;
        var antes = PresentacionOpciones!.De(opcion.Id);
        var pedida = _imagenNueva is not null ? _borrador with { Color = null } : _borrador;
        try
        {
            PresentacionOpciones.Guardar(opcion.Id, _borrador, _imagenNueva);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            RegistrarPresentacion?.Invoke(new PresentacionGuardada(opcion.Id, antes, pedida, _imagenNueva?.Sha256, "FAILED", antes));
            _avisoPresentacion = MensajesAtencion.PresentacionNoGuardada;
            return;
        }

        RegistrarPresentacion?.Invoke(new PresentacionGuardada(opcion.Id, antes, pedida, _imagenNueva?.Sha256, "APPLIED", PresentacionOpciones.De(opcion.Id)));
        _avisoGuardado = MensajesAtencion.PresentacionGuardada(opcion.Nombre);
        CerrarPersonalizacion();
    }

    /// <summary>Una exportación de Opciones, para la general: el archivo sin su ruta y las filas (D5 de importar-opciones-desde-excel).</summary>
    public sealed record ExportacionOpcionesRealizada(string Archivo, int Filas);

    /// <summary>Una importación de Opciones aplicada, para la general: la huella del archivo y cada opción (D6).</summary>
    public sealed record ImportacionOpcionesRealizada(string? Huella, ResultadoImportacionOpciones Resultado);

    /// <summary>Una importación de Opciones con errores, para la general: la huella y los errores, de los que se registran los motivos (D6).</summary>
    public sealed record ImportacionOpcionesRechazada(string? Huella, IReadOnlyList<ErrorImportacion> Errores);

    private string? _mensajeArchivosOpciones;
    private bool _archivosOpcionesFallido;
    private RevisionOpciones? _revisionOpciones;
    private string? _archivoOpciones;
    private string? _huellaOpciones;
    private bool _enfocarCartelOpciones;

