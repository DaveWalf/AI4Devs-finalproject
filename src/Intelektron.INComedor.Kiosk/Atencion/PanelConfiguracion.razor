                    <div class="acciones">
                        <button id="guardar-lector" type="button" class="principal" @onclick="GuardarElLector">Guardar</button>
                    </div>
                </section>
                <section aria-labelledby="titulo-estado-lector" class="estado-exportacion">
                    <h3 id="titulo-estado-lector">Estado del lector</h3>
                    <p id="estado-lector" role="status">@MensajesAtencion.EstadoLector(LectorDelPuesto.Estado, LectorDelPuesto.Configuracion)</p>
                    <p id="ultima-lectura" role="status">@MensajesAtencion.UltimaLectura(LectorDelPuesto.Ultima, Zona)</p>
