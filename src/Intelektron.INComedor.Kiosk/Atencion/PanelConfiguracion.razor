@using Microsoft.AspNetCore.Components.Web
@using Intelektron.INComedor.Infrastructure.Sqlite

@*
    Configuración por pestañas (D1 a D3 de configurar-puesto-por-pestanas): un diálogo modal que no cambia el estado de la
    máquina, con nueve pestañas según el patrón de WAI-ARIA. Todas quedan montadas y sólo la elegida se ve, así que lo
    editado en una sobrevive al pasar a otra y los id de siempre siguen en el diálogo (D2). Cada «Guardar» guarda lo suyo y
    deja Configuración abierta, con el aviso de lo guardado debajo de las pestañas (D3); «Cancelar» o Escape la cierran y
    descartan lo no guardado, también con un panel de edición abierto. Sólo un panel de edición se abre a la vez: Personas y
    Opciones comparten los id de sus botones desde administrar-personas-y-opciones.
*@
<div class="fondo-dialogo" inert="@Inerte">
    @* Escape no sigue hasta la pantalla de atrás, que lo leería como un pedido de cierre en reposo (D7). *@
    <div class="dialogo superficie ancho" role="dialog" aria-modal="true" aria-labelledby="titulo-configuracion" tabindex="-1"
         @ref="_dialogo" @onkeydown="Tecla" @onkeydown:stopPropagation="true">
        <h2 id="titulo-configuracion">Configuración</h2>

        <div class="pestanas" role="tablist" aria-label="Secciones de Configuración">
            @foreach (var pestana in Todas)
            {
                var elegida = pestana == _elegida;
                var indice = (int)pestana;
                <button type="button" role="tab" id="pestana-@Clave(pestana)" class="pestana" aria-selected="@(elegida ? "true" : "false")"
                        aria-controls="seccion-@Clave(pestana)" tabindex="@(elegida ? "0" : "-1")" @ref="_botones[indice]"
                        @onclick="() => Elegir(pestana)" @onkeydown="e => TeclaPestana(e, pestana)">@Nombre(pestana)</button>
            }
        </div>

        @if (_avisoGuardado is not null)
        {
            <p id="aviso-guardado" class="aviso" role="status">@_avisoGuardado</p>
        }

        <section role="tabpanel" id="seccion-general" class="seccion" aria-labelledby="pestana-general" hidden="@Oculta(Pestana.General)">
            <p id="modo-puesto" class="modo-puesto">Modo: @(Modo == ModoPuesto.Operativo ? "operativo" : "mantenimiento")</p>
            <div class="acciones abrir-paneles">
                @if (Modo == ModoPuesto.Mantenimiento)
                {
                    <button id="pasar-operativo" type="button" @onclick="() => PasarAOperativo.InvokeAsync()">Pasar a operativo</button>
                }
                else
                {
                    <button id="pasar-mantenimiento" type="button" @onclick="() => PasarAMantenimiento.InvokeAsync()">Pasar a mantenimiento</button>
                }
                @if (PuedeCerrar)
                {
                    <button id="cerrar-puesto" type="button" @onclick="() => CerrarPuesto.InvokeAsync()">Cerrar el puesto</button>
                }
            </div>
            @if (AvisoModo is not null)
            {
                <p id="aviso-modo" class="aviso" role="alert">@AvisoModo</p>
            }
            @if (Bitacoras is not null)
            {
                @* El estado de cada bitácora, sin datos de personas (escribir-bitacoras-externas). *@
                <section id="estado-bitacoras" aria-labelledby="titulo-bitacoras">
                    <h3 id="titulo-bitacoras">Bitácoras</h3>
                    <ul>
                        @foreach (var bitacora in Bitacoras)
                        {
                            <li id="bitacora-@(bitacora.Destino == DestinoBitacora.General ? "general" : "interacciones")">@MensajesAtencion.EstadoBitacora(bitacora, Zona)</li>
                        }
                    </ul>
                </section>
            }
        </section>

        <section role="tabpanel" id="seccion-personas" class="seccion" aria-labelledby="pestana-personas" hidden="@Oculta(Pestana.Personas)">
            @if (Administracion is not null)
            {
                @if (_panel == Panel.Personas)
                {
                    <PanelPersonas Administracion="Administracion" Cerrar="CerrarPanel" />
                }
                else
                {
                    <p id="resumen-personas">@ResumenPersonas</p>
                    <div class="acciones abrir-paneles">
                        <button id="abrir-personas" type="button" disabled="@(_panel is not null)" @onclick="() => AbrirPanel(Panel.Personas)">@Editar</button>
                    </div>
                    @if (_panel is not null)
                    {
                        <p class="indicacion">Terminá o cancelá la edición de Opciones para editar Personas</p>
                    }
                }
            }
        </section>

        <section role="tabpanel" id="seccion-opciones" class="seccion" aria-labelledby="pestana-opciones" hidden="@Oculta(Pestana.Opciones)">
            @if (Administracion is not null)
            {
                @if (_panel == Panel.Opciones)
                {
                    <PanelOpciones Administracion="Administracion" Cerrar="CerrarPanel" />
                }
                else
                {
                    <p id="resumen-opciones">@ResumenOpciones</p>
                    <div class="acciones abrir-paneles">
                        <button id="abrir-opciones" type="button" disabled="@(_panel is not null)" @onclick="() => AbrirPanel(Panel.Opciones)">@Editar</button>
                    </div>
                    @if (_panel is not null)
                    {
                        <p class="indicacion">Terminá o cancelá la edición de Personas para editar Opciones</p>
                    }
                }
            }
        </section>

        <section role="tabpanel" id="seccion-consumos" class="seccion" aria-labelledby="pestana-consumos" hidden="@Oculta(Pestana.Consumos)">
        </section>

        <section role="tabpanel" id="seccion-comprobantes" class="seccion" aria-labelledby="pestana-comprobantes" hidden="@Oculta(Pestana.Comprobantes)">
            @if (SesionOperador is not null)
            {
                <PestanaComprobantes Sesion="SesionOperador" Zona="Zona" />
            }
        </section>

        <section role="tabpanel" id="seccion-identidad" class="seccion" aria-labelledby="pestana-identidad" hidden="@Oculta(Pestana.Identidad)">
            <section aria-labelledby="titulo-estilo">
                <h3 id="titulo-estilo">Estilo visual</h3>
                <div class="parametro">
                    <label for="opacidad">Opacidad de las superficies</label>
                    <output id="valor-opacidad" for="opacidad">@Estilo.Opacidad %</output>
                    <input id="opacidad" type="range" min="@EstiloVisual.OpacidadMinima" max="@EstiloVisual.OpacidadMaxima" step="1"
                           value="@Estilo.Opacidad" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Opacidad = valor })" />
                </div>
                <div class="parametro">
                    <label for="desenfoque">Desenfoque del fondo</label>
                    <output id="valor-desenfoque" for="desenfoque">@Estilo.Desenfoque px</output>
                    <input id="desenfoque" type="range" min="@EstiloVisual.DesenfoqueMinimo" max="@EstiloVisual.DesenfoqueMaximo" step="1"
                           value="@Estilo.Desenfoque" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Desenfoque = valor })" />
                </div>
                @if (_avisoEstilo is not null)
                {
                    <p id="aviso-configuracion" class="aviso" role="alert">@_avisoEstilo</p>
                }
                <div class="acciones">
                    <button id="guardar-configuracion" type="button" class="principal" @onclick="GuardarElEstilo">Guardar</button>
                </div>
            </section>
        </section>

        <section role="tabpanel" id="seccion-impresora" class="seccion" aria-labelledby="pestana-impresora" hidden="@Oculta(Pestana.Impresora)">
            @if (Impresora is not null)
            {
                <FranjaImpresora Impresora="Impresora" ModoCambiado="ModoImpresoraCambiado" />
            }
        </section>

        <section role="tabpanel" id="seccion-pantalla" class="seccion" aria-labelledby="pestana-pantalla" hidden="@Oculta(Pestana.Pantalla)">
        </section>

        <section role="tabpanel" id="seccion-red" class="seccion" aria-labelledby="pestana-red" hidden="@Oculta(Pestana.Red)">
        </section>

        <div class="acciones pie-dialogo">
            <button id="cancelar-configuracion" type="button" @onclick="Cancelar">Cancelar</button>
        </div>
    </div>
</div>

@code {
    /// <summary>Las nueve pestañas, en el orden de D1.</summary>
    private enum Pestana
    {
        General,
        Personas,
        Opciones,
        Consumos,
        Comprobantes,
        Identidad,
        Impresora,
        Pantalla,
        Red,
    }

    private enum Panel
    {
        Personas,
        Opciones,
    }

    private static readonly Pestana[] Todas = Enum.GetValues<Pestana>();

    private readonly ElementReference[] _botones = new ElementReference[Todas.Length];
    private ElementReference _dialogo;
    private Pestana _elegida = Pestana.General;
    private bool _enfocarPestana;
    private Panel? _panel;
    private string? _avisoGuardado;
    private string? _avisoEstilo;
    private VistaAdministracion? _resumen;

    /// <summary>La edición de personas y opciones; null deja esas pestañas vacías (administrar-personas-y-opciones).</summary>
    [Parameter]
    public AdministracionLocal? Administracion { get; set; }

    /// <summary>El estilo de la vista previa.</summary>
    [Parameter, EditorRequired]
    public EstiloVisual Estilo { get; set; } = EstiloVisual.PorDefecto;

    /// <summary>La impresora simulada, o null con cualquier otra: entonces la pestaña Impresora no tiene sus modos.</summary>
    [Parameter]
    public ImpresoraSimulada? Impresora { get; set; }

    /// <summary>El estado de las bitácoras al abrir; null no muestra la sección.</summary>
    [Parameter]
    public IReadOnlyList<EstadoBitacora>? Bitacoras { get; set; }

    /// <summary>La zona en que se muestra desde qué hora una bitácora está degradada.</summary>
    [Parameter]
    public TimeZoneInfo Zona { get; set; } = TimeZoneInfo.Utc;

    [Parameter]
    public EventCallback<CambioModoImpresora> ModoImpresoraCambiado { get; set; }

    [Parameter]
    public EventCallback<EstiloVisual> VistaPrevia { get; set; }

    /// <summary>Guarda el estilo de la vista previa; false si no se pudo escribir y quedó vigente el de antes (D3).</summary>
    [Parameter, EditorRequired]
    public Func<bool> GuardarEstilo { get; set; } = () => true;

    [Parameter]
    public EventCallback Cancelar { get; set; }

    /// <summary>El modo vigente del puesto, que General muestra (D5).</summary>
    [Parameter]
    public ModoPuesto Modo { get; set; }

    /// <summary>Pasar a operativo pide la clave del día; volver a mantenimiento, no (acceso-puesto).</summary>
    [Parameter]
    public EventCallback PasarAOperativo { get; set; }

    [Parameter]
    public EventCallback PasarAMantenimiento { get; set; }

    /// <summary>«Cerrar el puesto», el camino táctil del cierre; sólo con un cierre que lo pueda hacer (D7).</summary>
    [Parameter]
    public EventCallback CerrarPuesto { get; set; }

    [Parameter]
    public bool PuedeCerrar { get; set; }

    /// <summary>El aviso de que no se pudo guardar el modo; null sin aviso.</summary>
    [Parameter]
    public string? AvisoModo { get; set; }

    /// <summary>La sesión del operador de Comprobantes, que la pantalla abre con Configuración y cierra con ella (D8).</summary>
    [Parameter]
    public SesionOperador? SesionOperador { get; set; }

    /// <summary>Con la clave del día pedida encima, el diálogo queda inerte.</summary>
    [Parameter]
    public bool Inerte { get; set; }

    private string Editar => _resumen?.SoloLectura == true ? "Ver" : "Editar";

    private string ResumenPersonas => _resumen is { } vista
        ? $"{vista.Personas.Count} personas en la versión {vista.VersionConfiguracion} de la configuración"
        : MensajesAtencion.ConfiguracionNoLeida;

    private string ResumenOpciones => _resumen is { } vista
        ? $"{vista.Opciones.Count} opciones en la versión {vista.VersionConfiguracion} de la configuración"
        : MensajesAtencion.ConfiguracionNoLeida;

    protected override void OnInitialized() => LeerResumen();

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        // El foco entra al diálogo para que Escape funcione sin tocarlo antes; con el teclado, sigue a la pestaña elegida.
        if (primera)
        {
            await _dialogo.FocusAsync();
        }
        else if (_enfocarPestana)
        {
            _enfocarPestana = false;
            await _botones[(int)_elegida].FocusAsync();
        }
    }

    private static string Clave(Pestana pestana) => pestana switch
    {
        Pestana.Identidad => "identidad",
        _ => pestana.ToString().ToLowerInvariant(),
    };

    private static string Nombre(Pestana pestana) => pestana switch
    {
        Pestana.Identidad => "Identidad visual",
        _ => pestana.ToString(),
    };

    private bool Oculta(Pestana pestana) => pestana != _elegida;

    private void Elegir(Pestana pestana)
    {
        if (pestana != _elegida)
        {
            _avisoGuardado = null;
        }

        _elegida = pestana;
    }

    /// <summary>Flechas, Inicio y Fin mueven la pestaña elegida y el foco con ella (patrón de pestañas de WAI-ARIA, D1).</summary>
    private void TeclaPestana(KeyboardEventArgs e, Pestana actual)
    {
        var indice = (int)actual;
        int? destino = e.Key switch
        {
            "ArrowRight" => (indice + 1) % Todas.Length,
            "ArrowLeft" => (indice + Todas.Length - 1) % Todas.Length,
            "Home" => 0,
            "End" => Todas.Length - 1,
            _ => null,
        };
        if (destino is { } nueva)
        {
            Elegir(Todas[nueva]);
            _enfocarPestana = true;
        }
    }

    private Task Cambiar(ChangeEventArgs e, Func<EstiloVisual, int, EstiloVisual> aplicar)
    {
        if (!int.TryParse(e.Value?.ToString(), out var valor))
        {
            return Task.CompletedTask;
        }

        var estilo = aplicar(Estilo, valor);
        return estilo.EnRango ? VistaPrevia.InvokeAsync(estilo) : Task.CompletedTask;
    }

    /// <summary>Guarda sólo el estilo y deja Configuración abierta: con el aviso de lo guardado o el de que no se pudo (D3).</summary>
    private void GuardarElEstilo()
    {
        if (GuardarEstilo())
        {
            _avisoEstilo = null;
            _avisoGuardado = MensajesAtencion.EstiloGuardado;
        }
        else
        {
            _avisoEstilo = MensajesAtencion.EstiloNoGuardado;
            _avisoGuardado = null;
        }
    }

    /// <summary>Escape cierra Configuración como «Cancelar», también con un panel de edición abierto (D3).</summary>
    private Task Tecla(KeyboardEventArgs e) => e.Key == "Escape" ? Cancelar.InvokeAsync() : Task.CompletedTask;

    private void AbrirPanel(Panel panel)
    {
        _avisoGuardado = null;
        _panel = panel;
    }

    /// <summary>Vuelve al resumen de la pestaña; si el panel guardó, con el aviso de la versión nueva.</summary>
    private void CerrarPanel(string? aviso)
    {
        _panel = null;
        if (aviso is not null)
        {
            _avisoGuardado = aviso;
            LeerResumen();
        }
    }

    private void LeerResumen()
    {
        try
        {
            _resumen = Administracion?.Leer();
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _resumen = null;
        }
    }
}
