    private bool HayLogosPendientes => _logoPendiente.Any(l => l is not null) || _logoAlEjemplo.Any(e => e);

    /// <summary>Lo pendiente de un logo, o el vigente: el de ejemplo pedido, el archivo elegido o el de la cabecera.</summary>
    private string VistaLogo(LogoPuesto logo)
    {
        var indice = (int)logo;
        var ejemplo = logo == LogoPuesto.Empresa ? LogosLocales.EmpresaDeEjemplo : LogosLocales.ConcesionariaDeEjemplo;
        var vigente = logo == LogoPuesto.Empresa ? Logos?.Empresa : Logos?.Concesionaria;
        return _logoAlEjemplo[indice] ? ejemplo : _logoPendiente[indice]?.UriData ?? vigente ?? ejemplo;
    }

    /// <summary>
    /// Lee el archivo elegido con un tope de 2 MB más un byte y lo valida con las reglas de LogosLocales; uno que no sirve
    /// dice por qué y deja el logo vigente (D14).
    /// </summary>
    private async Task ElegirLogo(InputFileChangeEventArgs e, LogoPuesto logo)
    {
        var indice = (int)logo;
        _avisoLogo[indice] = null;
        _avisoLogos = null;
        _logoPendiente[indice] = null;
        _logoAlEjemplo[indice] = false;
        var archivo = e.File;
        byte[] contenido = [];
        if (archivo.Size <= LogosLocales.TamanoMaximo)
        {
            try
            {
                await using var flujo = archivo.OpenReadStream(LogosLocales.TamanoMaximo + 1);
                using var memoria = new System.IO.MemoryStream();
                await flujo.CopyToAsync(memoria);
                contenido = memoria.ToArray();
            }
            catch (System.IO.IOException)
            {
                _avisoLogo[indice] = MensajesAtencion.LogoInvalido;
                return;
            }
        }

        var validacion = LogosLocales.Validar(archivo.Name, archivo.Size, contenido);
        _logoPendiente[indice] = validacion.Logo;
        _avisoLogo[indice] = validacion.Motivo;
    }

    private void VolverAlEjemplo(LogoPuesto logo)
    {
        var indice = (int)logo;
        _logoPendiente[indice] = null;
        _logoAlEjemplo[indice] = true;
        _avisoLogo[indice] = null;
        _avisoLogos = null;
    }

    /// <summary>Guarda lo pendiente de cada logo y deja Configuración abierta, con el aviso de lo guardado (D3, D14).</summary>
    private void GuardarLogos()
    {
        if (GuardarLogo is null)
        {
            return;
        }

        var guardados = true;
        foreach (var logo in LogosEditables)
        {
            var indice = (int)logo;
            if (!_logoAlEjemplo[indice] && _logoPendiente[indice] is null)
            {
                continue;
            }

            guardados &= GuardarLogo(logo, _logoAlEjemplo[indice] ? null : _logoPendiente[indice]);
            _logoPendiente[indice] = null;
            _logoAlEjemplo[indice] = false;
        }

        _avisoGuardado = guardados ? MensajesAtencion.LogosGuardados : null;
        _avisoLogos = guardados ? null : MensajesAtencion.LogosNoGuardados;
    }

    /// <summary>Flechas, Inicio y Fin mueven la pestaña elegida y el foco con ella (patrón de pestañas de WAI-ARIA, D1).</summary>
    private void TeclaPestana(KeyboardEventArgs e, Pestana actual)
    {
        // Las flechas, Inicio y Fin recorren sólo las pestañas visibles: con un operador, las tres suyas (D6).
        var visibles = Visibles;
        var indice = Array.IndexOf(visibles, actual);
        int? destino = e.Key switch
        {
            "ArrowRight" => (indice + 1) % visibles.Length,
            "ArrowLeft" => (indice + visibles.Length - 1) % visibles.Length,
            "Home" => 0,
            "End" => visibles.Length - 1,
            _ => null,
        };
        if (destino is { } nueva)
        {
            Elegir(visibles[nueva]);
            _enfocarPestana = true;
        }
    }

