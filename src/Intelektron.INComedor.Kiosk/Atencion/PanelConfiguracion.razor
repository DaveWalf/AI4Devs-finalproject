    [Parameter]
    public Guid? Actor { get; set; }

    /// <summary>Se entró con la clave del día de desarrollo, que no se valida: el aviso queda arriba hasta cerrar (D4).</summary>
    [Parameter]
    public bool ClaveSinValidar { get; set; }

    private string Editar => _resumen?.SoloLectura == true ? "Ver" : "Editar";

    private string ResumenOpciones => _resumen is { } vista
        ? MensajesAtencion.ResumenOpciones(vista.Opciones.Count, vista.VersionConfiguracion)
        : MensajesAtencion.ConfiguracionNoLeida;

    protected override void OnInitialized()
    {
        // Abre en la primera visible, Consumos, con la clave del día o con un operador (D1 de ordenar-configuracion).
        _elegida = Visibles[0];

        LeerResumen();
        _encabezado = Textos.Encabezado;
        _pie = Textos.Pie;
        _monitores = Monitores.Leer();
        var guardado = _monitores.ToList().FindIndex(m => m.Id == MonitorGuardadoId);
        _monitorElegido = guardado >= 0 ? guardado : Math.Max(0, _monitores.ToList().FindIndex(m => m.Principal));
    }

    /// <summary>Guarda el monitor y deja Configuración abierta, con el aviso de lo guardado (D3, D10).</summary>
    private void GuardarElMonitor()
    {
        if (GuardarMonitor is null || _monitorElegido >= _monitores.Count)
        {
            return;
        }

        var guardado = GuardarMonitor(_monitores[_monitorElegido]);
        _avisoMonitorError = guardado ? null : MensajesAtencion.MonitorNoGuardado;
        _avisoGuardado = guardado ? MensajesAtencion.MonitorGuardado : null;
    }

    private void Probar() => _resultadoPrueba = ImprimirPrueba?.Invoke();

    /// <summary>Guarda sólo los textos y deja Configuración abierta: con el aviso de lo guardado o los campos señalados (D3).</summary>
    private void GuardarLosTextos()
    {
        if (GuardarTextos?.Invoke(_encabezado, _pie) is not { } resultado)
        {
            return;
        }

        _camposTextos = resultado.Campos;
        _avisoTextos = resultado.Aviso;
        _avisoGuardado = resultado.Guardado ? MensajesAtencion.TextosGuardados : null;
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        // El foco entra al diálogo para que Escape funcione sin tocarlo antes; con el teclado, sigue a la pestaña elegida.
        if (primera)
        {
            await _dialogo.FocusAsync();
        }
        else if (_enfocarPestana)
        {
            _enfocarPestana = false;
            await _botones[(int)_elegida].FocusAsync();
        }

        // El foco entra al cartel de personalización, en el primer color (D2 de personalizar-opciones).
        if (_enfocarPersonalizacion && _personalizando is not null)
        {
            _enfocarPersonalizacion = false;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", "#personalizar-opcion button.color-opcion");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }

        // El foco entra al resumen de una importación, en su primer botón (D9 de importar-personas-desde-excel).
        if (_enfocarCartel && _revision is not null)
        {
            _enfocarCartel = false;
            try
            {
                await JS.InvokeVoidAsync("incomedor.enfocar", "#resumen-importacion .acciones button");
            }
            catch (JSException)
            {
                // Sin la función (una página vieja en caché), el foco queda donde estaba.
            }
        }
    }

    private static string Clave(Pestana pestana) => pestana switch
    {
        Pestana.Identidad => "identidad",
        _ => pestana.ToString().ToLowerInvariant(),
    };

    private static string Nombre(Pestana pestana) => pestana switch
    {
        Pestana.Identidad => "Identidad visual",
        _ => pestana.ToString(),
    };

    private bool Oculta(Pestana pestana) => pestana != _elegida;

    private void Elegir(Pestana pestana)
    {
        if (pestana != _elegida)
        {
            _avisoGuardado = null;
        }

        _elegida = pestana;
        _redMontada |= pestana == Pestana.Red;
    }

    private bool HayLogosPendientes => _logoPendiente.Any(l => l is not null) || _logoAlEjemplo.Any(e => e);

    /// <summary>Lo pendiente de un logo, o el vigente: el de ejemplo pedido, el archivo elegido o el de la cabecera.</summary>
    private string VistaLogo(LogoPuesto logo)
    {
        var indice = (int)logo;
        var ejemplo = logo == LogoPuesto.Empresa ? LogosLocales.EmpresaDeEjemplo : LogosLocales.ConcesionariaDeEjemplo;
        var vigente = logo == LogoPuesto.Empresa ? Logos?.Empresa : Logos?.Concesionaria;
        return _logoAlEjemplo[indice] ? ejemplo : _logoPendiente[indice]?.UriData ?? vigente ?? ejemplo;
    }

    /// <summary>
    /// Lee el archivo elegido con un tope de 2 MB más un byte y lo valida con las reglas de LogosLocales; uno que no sirve
    /// dice por qué y deja el logo vigente (D14).
    /// </summary>
    private async Task ElegirLogo(InputFileChangeEventArgs e, LogoPuesto logo)
    {
        var indice = (int)logo;
        _avisoLogo[indice] = null;
        _avisoLogos = null;
        _logoPendiente[indice] = null;
        _logoAlEjemplo[indice] = false;
        var archivo = e.File;
        byte[] contenido = [];
        if (archivo.Size <= LogosLocales.TamanoMaximo)
        {
            try
            {
                await using var flujo = archivo.OpenReadStream(LogosLocales.TamanoMaximo + 1);
                using var memoria = new System.IO.MemoryStream();
                await flujo.CopyToAsync(memoria);
                contenido = memoria.ToArray();
            }
            catch (System.IO.IOException)
            {
                _avisoLogo[indice] = MensajesAtencion.LogoInvalido;
                return;
            }
        }

        var validacion = LogosLocales.Validar(archivo.Name, archivo.Size, contenido);
        _logoPendiente[indice] = validacion.Logo;
        _avisoLogo[indice] = validacion.Motivo;
    }

    private void VolverAlEjemplo(LogoPuesto logo)
    {
        var indice = (int)logo;
        _logoPendiente[indice] = null;
        _logoAlEjemplo[indice] = true;
        _avisoLogo[indice] = null;
        _avisoLogos = null;
    }

    /// <summary>Guarda lo pendiente de cada logo y deja Configuración abierta, con el aviso de lo guardado (D3, D14).</summary>
    private void GuardarLogos()
    {
        if (GuardarLogo is null)
        {
            return;
        }

        var guardados = true;
        foreach (var logo in LogosEditables)
        {
            var indice = (int)logo;
            if (!_logoAlEjemplo[indice] && _logoPendiente[indice] is null)
            {
                continue;
            }

            guardados &= GuardarLogo(logo, _logoAlEjemplo[indice] ? null : _logoPendiente[indice]);
            _logoPendiente[indice] = null;
            _logoAlEjemplo[indice] = false;
        }

        _avisoGuardado = guardados ? MensajesAtencion.LogosGuardados : null;
        _avisoLogos = guardados ? null : MensajesAtencion.LogosNoGuardados;
    }

    /// <summary>Flechas, Inicio y Fin mueven la pestaña elegida y el foco con ella (patrón de pestañas de WAI-ARIA, D1).</summary>
    private void TeclaPestana(KeyboardEventArgs e, Pestana actual)
    {
        // Las flechas, Inicio y Fin recorren sólo las pestañas visibles: con un operador, las tres suyas (D6).
        var visibles = Visibles;
        var indice = Array.IndexOf(visibles, actual);
        int? destino = e.Key switch
        {
            "ArrowRight" => (indice + 1) % visibles.Length,
            "ArrowLeft" => (indice + visibles.Length - 1) % visibles.Length,
            "Home" => 0,
            "End" => visibles.Length - 1,
            _ => null,
        };
        if (destino is { } nueva)
        {
            Elegir(visibles[nueva]);
            _enfocarPestana = true;
        }
    }

    private Task Cambiar(ChangeEventArgs e, Func<EstiloVisual, int, EstiloVisual> aplicar)
    {
        if (!int.TryParse(e.Value?.ToString(), out var valor))
        {
            return Task.CompletedTask;
        }

        var estilo = aplicar(Estilo, valor);
        return estilo.EnRango ? VistaPrevia.InvokeAsync(estilo) : Task.CompletedTask;
    }

    /// <summary>Guarda sólo el estilo y deja Configuración abierta: con el aviso de lo guardado o el de que no se pudo (D3).</summary>
    private void GuardarElEstilo()
    {
        if (GuardarEstilo())
        {
            _avisoEstilo = null;
            _avisoGuardado = MensajesAtencion.EstiloGuardado;
        }
        else
        {
            _avisoEstilo = MensajesAtencion.EstiloNoGuardado;
            _avisoGuardado = null;
        }
    }

    /// <summary>Escape cierra Configuración como «Cerrar», también con un panel de edición abierto (D3).</summary>
    /// <summary>Escape cierra Configuración, también con el resumen de una importación abierto, que no se aplica.</summary>
    private Task Tecla(KeyboardEventArgs e) => e.Key == "Escape" ? Cancelar.InvokeAsync() : Task.CompletedTask;

    /// <summary>Abrir una edición elige su pestaña, que queda a la vista con la tabla o el panel.</summary>
    private void AbrirPanel(Panel panel)
    {
        _avisoGuardado = null;
        _opcionAEnfocar = null;
        _panel = panel;
        _elegida = panel == Panel.Personas ? Pestana.Personas : Pestana.Opciones;
    }

    /// <summary>Vuelve al resumen de la pestaña; si el panel guardó, con el aviso de la versión nueva.</summary>
    private void CerrarPanel(string? aviso)
    {
        _panel = null;
        if (aviso is not null)
        {
            _avisoGuardado = aviso;
            LeerResumen();
        }
    }

    private void LeerResumen()
    {
        try
        {
            _resumen = Administracion?.Leer();
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _resumen = null;
        }
    }
