    protected override void OnInitialized()
    {
        // Abre en la primera visible, Consumos, con la clave del día o con un operador (D1 de ordenar-configuracion).
        _elegida = Visibles[0];

        LeerResumen();
        _encabezado = Textos.Encabezado;
        _pie = Textos.Pie;
        (_lineaComensal, _lineaAviso, _lineaOperador) = (Textos.Comensal, Textos.AvisoReimpresion, Textos.Operador);
        LeerConfiguracionExportacion();
        LeerConfiguracionCorreo();
        LeerConfiguracionLector();
        _numeroPuesto = DatosDelPuesto.Numero?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        _nombrePuesto = DatosDelPuesto.Nombre;
        _correlativo = DatosDelPuesto.Correlativo;
        _desde = DatosDelPuesto.Desde.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _monitores = Monitores.Leer();
        var guardado = _monitores.ToList().FindIndex(m => m.Id == MonitorGuardadoId);
        _monitorElegido = guardado >= 0 ? guardado : Math.Max(0, _monitores.ToList().FindIndex(m => m.Principal));
    }

    /// <summary>Guarda el monitor y deja Configuración abierta, con el aviso de lo guardado (D3, D10).</summary>
    private void GuardarElMonitor()
    {
        if (GuardarMonitor is null || _monitorElegido >= _monitores.Count)
        {
            return;
        }

