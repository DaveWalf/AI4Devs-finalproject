@using Microsoft.AspNetCore.Components.Web
@using Intelektron.INComedor.Infrastructure.Sqlite
@using Intelektron.INComedor.Kiosk.Red
@using Intelektron.INComedor.Kiosk.Lector
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS

@*
    Configuración por pestañas (D1 a D3 de configurar-puesto-por-pestanas): un diálogo modal que no cambia el estado de la
    máquina, con once pestañas según el patrón de WAI-ARIA. Todas quedan montadas y sólo la elegida se ve, así que lo
    editado en una sobrevive al pasar a otra y los id de siempre siguen en el diálogo (D2). Cada «Guardar» guarda lo suyo y
    deja Configuración abierta, con el aviso de lo guardado debajo de las pestañas (D3); «Cerrar» o Escape la cierran y
    descartan lo no guardado, también con un panel de edición abierto. Sólo un panel de edición se abre a la vez: Personas y
    Opciones comparten los id de sus botones desde administrar-personas-y-opciones.
*@
<div class="fondo-dialogo" inert="@Inerte">
    @* Escape no sigue hasta la pantalla de atrás, que lo leería como un pedido de cierre en reposo (D7). *@
    <div class="dialogo superficie ancho" role="dialog" aria-modal="true" aria-labelledby="titulo-configuracion" tabindex="-1"
         @ref="_dialogo" @onkeydown="Tecla" @onkeydown:stopPropagation="true">
        @* Con un operador, su nombre arriba; con la clave del día, el aviso de que no se validó (D4 y D6 de entrar-a-configuracion-con-teclado). *@
        @* Van en la fila del título, que tiene lugar: así no le quitan alto a las tablas de Personas y Consumos. *@
        <div class="encabezado-configuracion">
            <h2 id="titulo-configuracion">Configuración</h2>
            @if (Operador is not null)
            {
                <p id="operador-configuracion" class="operador-configuracion">Operador: @Operador</p>
            }
            @if (ClaveSinValidar)
            {
                <p id="aviso-clave-sin-validar" class="aviso" role="status">@MensajesAtencion.ClaveSinValidar</p>
            }
        </div>

        <div class="pestanas" role="tablist" aria-label="Secciones de Configuración">
            @foreach (var pestana in Visibles)
            {
                var elegida = pestana == _elegida;
                var indice = (int)pestana;
                <button type="button" role="tab" id="pestana-@Clave(pestana)" class="pestana" aria-selected="@(elegida ? "true" : "false")"
                        aria-controls="seccion-@Clave(pestana)" tabindex="@(elegida ? "0" : "-1")" @ref="_botones[indice]"
                        @onclick="() => Elegir(pestana)" @onkeydown="e => TeclaPestana(e, pestana)">@Nombre(pestana)</button>
            }
        </div>

        @if (_avisoGuardado is not null)
        {
            <p id="aviso-guardado" class="aviso" role="status">@_avisoGuardado</p>
        }

        @* Con un operador, General, Opciones, Identidad visual, Mails, Pantalla, Red, Lector y Exportación no existen en el DOM (D6). *@
        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-general" class="seccion" aria-labelledby="pestana-general" hidden="@Oculta(Pestana.General)">
            <p id="modo-puesto" class="modo-puesto">Modo: @(Modo == ModoPuesto.Operativo ? "operativo" : "mantenimiento")</p>
            @if (OfreceSimulacion)
            {
                @* El modo simulación, sólo en mantenimiento; se aplica en el acto, como el modo (D6 de simular-identificacion-por-lista). *@
                <p id="modo-simulacion" class="modo-puesto">Simulación: @(Simulacion ? "encendida" : "apagada")</p>
            }
            <div class="acciones abrir-paneles">
                @if (Modo == ModoPuesto.Mantenimiento)
                {
                    <button id="pasar-operativo" type="button" @onclick="() => PasarAOperativo.InvokeAsync()">Pasar a operativo</button>
                }
                else
                {
                    <button id="pasar-mantenimiento" type="button" @onclick="() => PasarAMantenimiento.InvokeAsync()">Pasar a mantenimiento</button>
                }
                @if (OfreceSimulacion)
                {
                    @if (Simulacion)
                    {
                        <button id="apagar-simulacion" type="button" @onclick="() => CambiarSimulacion.InvokeAsync(false)">Apagar la simulación</button>
                    }
                    else
                    {
                        <button id="encender-simulacion" type="button" @onclick="() => CambiarSimulacion.InvokeAsync(true)">Encender la simulación</button>
                    }
                }
                @if (PuedeCerrar)
                {
                    <button id="cerrar-puesto" type="button" @onclick="() => CerrarPuesto.InvokeAsync()">Cerrar el puesto</button>
                }
            </div>
            @if (AvisoModo is not null)
            {
                <p id="aviso-modo" class="aviso" role="alert">@AvisoModo</p>
            }
            @if (OfreceSimulacion && AvisoSimulacion is not null)
            {
                <p id="aviso-simulacion" class="aviso" role="alert">@AvisoSimulacion</p>
            }
            @if (Bitacoras is not null)
            {
                @* El estado de cada bitácora, sin datos de personas (escribir-bitacoras-externas). *@
                <section id="estado-bitacoras" aria-labelledby="titulo-bitacoras">
                    <h3 id="titulo-bitacoras">Bitácoras</h3>
                    <ul>
                        @foreach (var bitacora in Bitacoras)
                        {
                            <li id="bitacora-@(bitacora.Destino == DestinoBitacora.General ? "general" : "interacciones")">@MensajesAtencion.EstadoBitacora(bitacora, Zona)</li>
                        }
                    </ul>
                </section>
            }
            @if (Resguardo is not null)
            {
                @* Al final de General: guardar el resguardo siempre; recuperarlo, sólo sin INWeb como dueño y con el diálogo de
                   archivos (D4 de resguardar-configuracion). *@
                <section id="resguardo" aria-labelledby="titulo-resguardo">
                    <h3 id="titulo-resguardo">Resguardo de la configuración</h3>
                    <div class="acciones botones-resguardo">
                        @if (PuedeExportarPersonas)
                        {
                            <button id="guardar-resguardo" type="button" @onclick="GuardarResguardo">Guardar resguardo</button>
                        }
                        @if (PuedeRecuperar)
                        {
                            <button id="recuperar-resguardo" type="button" @onclick="RevisarResguardo">Recuperar resguardo</button>
                        }
                    </div>
                    @if (_mensajeResguardo is not null)
                    {
                        <p id="mensaje-resguardo" class="@(_resguardoFallido ? "aviso" : "mensaje-exportacion")" role="status">@_mensajeResguardo</p>
                    }
                </section>
            }
        </section>
        }

        <section role="tabpanel" id="seccion-personas" class="seccion" aria-labelledby="pestana-personas" hidden="@Oculta(Pestana.Personas)">
            @if (Administracion is not null)
            {
                @* La tabla para leer y, con «Editar» en su encabezado, la misma tabla para editar en el mismo lugar (D4). *@
                @* La tabla de lectura se dibuja sólo con su pestaña elegida: no tiene nada editado que conservar, y así los nombres
                   de todas las personas no quedan en la página mientras se usa otra pestaña. La edición sigue montada (D2). *@
                @if (_panel == Panel.Personas || _elegida == Pestana.Personas)
                {
                    @* Una importación aplicada cambia la clave y la tabla se vuelve a leer (importar-personas-desde-excel). *@
                    <PanelPersonas @key="_recargaPersonas" Administracion="Administracion" Editando="@(_panel == Panel.Personas)" Cerrar="CerrarPanel"
                                   PuedeEditar="@(_panel is null)" Editar="() => AbrirPanel(Panel.Personas)" Actor="Actor"
                                   TecladoVisible="_tecladoPersonasVisible" TecladoVisibleChanged="v => _tecladoPersonasVisible = v" />
                }
                else
                {
                    @* Con la pestaña oculta queda sólo «Editar», sin nombres en la página. *@
                    <button id="abrir-personas" type="button" disabled="@(_panel is not null)" @onclick="() => AbrirPanel(Panel.Personas)">@Editar</button>
                }
            }
        </section>

        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-opciones" class="seccion" aria-labelledby="pestana-opciones" hidden="@Oculta(Pestana.Opciones)">
            @if (Administracion is not null)
            {
                @if (_panel == Panel.Opciones)
                {
                    <PanelOpciones Administracion="Administracion" Cerrar="CerrarPanel" Actor="Actor" Enfocar="_opcionAEnfocar" />
                }
                else
                {
                    <p id="resumen-opciones">@ResumenOpciones</p>
                    <div class="acciones abrir-paneles">
                        <button id="abrir-opciones" type="button" disabled="@(_panel is not null)" @onclick="() => AbrirPanel(Panel.Opciones)">@Editar</button>
                    </div>
                    @if (_panel is not null)
                    {
                        <p class="indicacion">@MensajesAtencion.EdicionDePersonasAbierta</p>
                    }
                    @* El catálogo a la vista, con «Editar» y «Personalizar» por opción (D1 de personalizar-opciones). Sólo con su
                       pestaña elegida, como la tabla de Personas. *@
                    @if (_resumen is { } catalogo && _elegida == Pestana.Opciones)
                    {
                        <div id="catalogo-opciones" class="catalogo-opciones">
                            @for (var i = 0; i < catalogo.Opciones.Count; i++)
                            {
                                var indice = i;
                                var opcion = catalogo.Opciones[indice];
                                var presentacion = PresentacionOpciones?.De(opcion.Id) ?? PresentacionOpcion.PorDefecto;
                                var (estilo, clase) = PresentacionOpciones?.EstiloDe(opcion.Id) ?? (null, string.Empty);
                                var cargo = MensajesAtencion.Cargo(opcion.Moneda, opcion.Escala, opcion.ImporteUnidadesMenores);
                                <article class="opcion-catalogo" data-indice="@indice">
                                    <div class="datos-opcion">
                                        <h4 class="nombre-opcion">@opcion.Nombre</h4>
                                        <span class="servicio-opcion">Servicio: @opcion.Servicio</span>
                                        <span class="importe-opcion">@(cargo.Length > 0 ? "Importe: " + cargo : "Sin cargo")</span>
                                        <ul class="cargas">
                                            @foreach (var carga in opcion.Cargas)
                                            {
                                                <li class="carga">Carga: @carga.Categoria × @carga.Unidades</li>
                                            }
                                        </ul>
                                        <span class="franjas-opcion">@Franjas(opcion)</span>
                                    </div>
                                    <span class="opcion muestra-opcion @clase" style="@estilo">
                                        <span class="nombre">@opcion.Nombre</span>
                                        @if (presentacion.PrecioVisible && cargo.Length > 0)
                                        {
                                            <span class="cargo">@cargo</span>
                                        }
                                    </span>
                                    <div class="acciones-opcion">
                                        <button type="button" class="editar-opcion" disabled="@(_panel is not null)" @onclick="() => EditarOpcion(indice)">@Editar</button>
                                        @if (PresentacionOpciones is not null)
                                        {
                                            <button type="button" class="personalizar-opcion" @onclick="() => AbrirPersonalizacion(opcion, indice)">Personalizar</button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            }
        </section>
        }

        <section role="tabpanel" id="seccion-consumos" class="seccion" aria-labelledby="pestana-consumos" hidden="@Oculta(Pestana.Consumos)">
            @if (Consumos is not null)
            {
                <PestanaConsumos Consulta="Consumos" Visible="@(_elegida == Pestana.Consumos)" Zona="Zona" Registrar="RegistrarConsulta" Sesion="SesionOperador"
                                 Almacen="AlmacenExportacion" Elector="ElectorCarpeta" RegistrarExportacion="RegistrarExportacion" />
            }
        </section>

        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-identidad" class="seccion" aria-labelledby="pestana-identidad" hidden="@Oculta(Pestana.Identidad)">
            <section aria-labelledby="titulo-estilo">
                <h3 id="titulo-estilo">Estilo visual</h3>
                <div class="parametro">
                    <label for="opacidad">Opacidad de las superficies</label>
                    <output id="valor-opacidad" for="opacidad">@Estilo.Opacidad %</output>
                    <input id="opacidad" type="range" min="@EstiloVisual.OpacidadMinima" max="@EstiloVisual.OpacidadMaxima" step="1"
                           value="@Estilo.Opacidad" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Opacidad = valor })" />
                </div>
                <div class="parametro">
                    <label for="desenfoque">Desenfoque del fondo</label>
                    <output id="valor-desenfoque" for="desenfoque">@Estilo.Desenfoque px</output>
                    <input id="desenfoque" type="range" min="@EstiloVisual.DesenfoqueMinimo" max="@EstiloVisual.DesenfoqueMaximo" step="1"
                           value="@Estilo.Desenfoque" @oninput="e => Cambiar(e, (estilo, valor) => estilo with { Desenfoque = valor })" />
                </div>
                @if (_avisoEstilo is not null)
                {
                    <p id="aviso-configuracion" class="aviso" role="alert">@_avisoEstilo</p>
                }
                <div class="acciones">
                    <button id="guardar-configuracion" type="button" class="principal" @onclick="GuardarElEstilo">Guardar</button>
                </div>
            </section>
            @if (Logos is not null && GuardarLogo is not null)
            {
                @* Los logos con las reglas de LogosLocales; la vista previa es un img, donde un SVG no ejecuta scripts (D14). *@
                <section class="logos" aria-labelledby="titulo-logos">
                    <h3 id="titulo-logos">Logos</h3>
                    <div class="lista-logos">
                        @foreach (var logo in LogosEditables)
                        {
                            var indice = (int)logo;
                            var clave = logo == LogoPuesto.Empresa ? "empresa" : "concesionaria";
                            var titulo = logo == LogoPuesto.Empresa ? "Logo de la empresa" : "Logo de la concesionaria";
                            <div class="logo-editable">
                                <span id="titulo-logo-@clave">@titulo</span>
                                <div class="cuadricula-logo">
                                    <img id="vista-logo-@clave" src="@VistaLogo(logo)" alt="@titulo" />
                                </div>
                                <InputFile id="@($"archivo-logo-{clave}")" accept=".png,.webp,.svg" aria-labelledby="@($"titulo-logo-{clave}")"
                                           OnChange="e => ElegirLogo(e, logo)" />
                                <button id="ejemplo-logo-@clave" type="button" @onclick="() => VolverAlEjemplo(logo)">Volver al de ejemplo</button>
                                @if (_avisoLogo[indice] is { } aviso)
                                {
                                    <p id="aviso-logo-@clave" class="aviso" role="alert">@aviso</p>
                                }
                            </div>
                        }
                    </div>
                    @if (_avisoLogos is not null)
                    {
                        <p id="aviso-logos" class="aviso" role="alert">@_avisoLogos</p>
                    }
                    @if (HayLogosPendientes)
                    {
                        <div class="acciones">
                            <button id="guardar-logos" type="button" class="principal" @onclick="GuardarLogos">Guardar los logos</button>
                        </div>
                    }
                </section>
            }
        </section>
        }

        <section role="tabpanel" id="seccion-impresora" class="seccion" aria-labelledby="pestana-impresora" hidden="@Oculta(Pestana.Impresora)">
            @if (Impresora is not null)
            {
                <FranjaImpresora Impresora="Impresora" ModoCambiado="ModoImpresoraCambiado" />
            }

            @* La prueba va directo a la impresora del puesto, sin consumo (D13). *@
            @if (ImprimirPrueba is not null)
            {
                <section aria-labelledby="titulo-prueba">
                    <h3 id="titulo-prueba">Prueba de impresión</h3>
                    <p>@MensajesAtencion.PruebaImpresionExplicacion</p>
                    <div class="acciones abrir-paneles">
                        <button id="imprimir-prueba" type="button" @onclick="Probar">Imprimir una prueba</button>
                    </div>
                    @if (_resultadoPrueba is not null)
                    {
                        <p id="resultado-prueba" class="aviso" role="status">@_resultadoPrueba</p>
                    }
                </section>
            }

            @* El encabezado y el pie del comprobante, desde el próximo que sale (D13). *@
            @if (GuardarTextos is not null)
            {
                <section aria-labelledby="titulo-textos" class="textos-comprobante datos-comprobante">
                    <h3 id="titulo-textos">Textos del comprobante</h3>
                    <label for="encabezado-comprobante">Encabezado</label>
                    <input id="encabezado-comprobante" type="text" maxlength="@TextosComprobante.LargoEncabezado" value="@_encabezado"
                           aria-invalid="@(_camposTextos.Contains("Encabezado") ? "true" : null)" @oninput="e => _encabezado = e.Value?.ToString() ?? string.Empty" />
                    <label for="pie-comprobante">Pie</label>
                    <input id="pie-comprobante" type="text" maxlength="@TextosComprobante.LargoPie" value="@_pie"
                           aria-invalid="@(_camposTextos.Contains("Pie") ? "true" : null)" @oninput="e => _pie = e.Value?.ToString() ?? string.Empty" />
                    @* Las líneas que imprime el comprobante, con el par «Imprimir» y «No imprimir» de cada una, que se guardan con los *@
                    @* textos (D2 de elegir-lineas-del-comprobante): los rótulos en la columna de los de arriba y los pares en la de *@
                    @* los campos, con los botones de los pares de Mails. La marca de la clave del día no tiene elección. *@
                    <span id="rotulo-linea-comensal" class="rotulo">Nombre del comensal</span>
                    <div class="numeracion lineas-comprobante" role="group" aria-labelledby="rotulo-linea-comensal">
                        <button id="comensal-imprimir" type="button" aria-pressed="@Presionado(_lineaComensal)" @onclick="() => _lineaComensal = true">Imprimir</button>
                        <button id="comensal-no-imprimir" type="button" aria-pressed="@Presionado(!_lineaComensal)" @onclick="() => _lineaComensal = false">No imprimir</button>
                    </div>
                    <span id="rotulo-linea-aviso" class="rotulo">Aviso de reimpresión</span>
                    <div class="numeracion lineas-comprobante" role="group" aria-labelledby="rotulo-linea-aviso">
                        <button id="aviso-reimpresion-imprimir" type="button" aria-pressed="@Presionado(_lineaAviso)" @onclick="() => _lineaAviso = true">Imprimir</button>
                        <button id="aviso-reimpresion-no-imprimir" type="button" aria-pressed="@Presionado(!_lineaAviso)" @onclick="() => _lineaAviso = false">No imprimir</button>
                    </div>
                    <span id="rotulo-linea-operador" class="rotulo">Operador que habilitó</span>
                    <div class="numeracion lineas-comprobante" role="group" aria-labelledby="rotulo-linea-operador">
                        <button id="operador-imprimir" type="button" aria-pressed="@Presionado(_lineaOperador)" @onclick="() => _lineaOperador = true">Imprimir</button>
                        <button id="operador-no-imprimir" type="button" aria-pressed="@Presionado(!_lineaOperador)" @onclick="() => _lineaOperador = false">No imprimir</button>
                    </div>
                    @if (_avisoTextos is not null)
                    {
                        <p id="aviso-textos" class="aviso" role="status">@_avisoTextos</p>
                    }
                    <div class="acciones">
                        <button id="guardar-textos" type="button" class="principal" @onclick="GuardarLosTextos">Guardar</button>
                    </div>
                </section>
            }

            @* El número y el nombre del puesto y la numeración, desde el próximo comprobante (D7 de enriquecer-comprobante). *@
            @if (GuardarDatosPuesto is not null)
            {
                <section aria-labelledby="titulo-datos-comprobante" class="textos-comprobante datos-comprobante">
                    <h3 id="titulo-datos-comprobante">Datos del comprobante</h3>
                    <label for="numero-puesto">Número del puesto</label>
                    <input id="numero-puesto" type="text" inputmode="numeric" maxlength="3" value="@_numeroPuesto"
                           aria-invalid="@(_camposDatos.Contains("Numero") ? "true" : null)" @oninput="e => _numeroPuesto = e.Value?.ToString() ?? string.Empty" />
                    <label for="nombre-puesto">Nombre del puesto</label>
                    <input id="nombre-puesto" type="text" maxlength="@DatosPuesto.LargoNombre" value="@_nombrePuesto"
                           aria-invalid="@(_camposDatos.Contains("Nombre") ? "true" : null)" @oninput="e => _nombrePuesto = e.Value?.ToString() ?? string.Empty" />
                    <span id="titulo-numeracion" class="rotulo">Número del comprobante</span>
                    <div class="numeracion" role="group" aria-labelledby="titulo-numeracion">
                        <button id="numeracion-codigo" type="button" aria-pressed="@(_correlativo ? "false" : "true")" @onclick="() => _correlativo = false">El código de siempre</button>
                        <button id="numeracion-correlativo" type="button" aria-pressed="@(_correlativo ? "true" : "false")" @onclick="() => _correlativo = true">Correlativo desde</button>
                        <input id="desde-correlativo" type="text" inputmode="numeric" maxlength="9" value="@_desde" aria-label="Desde el número"
                               aria-invalid="@(_camposDatos.Contains("Desde") ? "true" : null)" @oninput="e => _desde = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    @if (_avisoDatos is not null)
                    {
                        <p id="aviso-datos-comprobante" class="aviso" role="status">@_avisoDatos</p>
                    }
                    <div class="acciones">
                        <button id="guardar-datos-comprobante" type="button" class="principal" @onclick="GuardarLosDatosDelPuesto">Guardar</button>
                    </div>
                </section>
            }
        </section>

        @if (Operador is null)
        {
        <section role="tabpanel" id="seccion-pantalla" class="seccion" aria-labelledby="pestana-pantalla" hidden="@Oculta(Pestana.Pantalla)">
            @* El monitor del puesto, recordado al volver a abrir; si el guardado no está, el principal y el aviso (D10). *@
            @if (AvisoMonitor is not null)
            {
                <p id="aviso-monitor" class="aviso" role="status">@AvisoMonitor</p>
            }
            <p>@MensajesAtencion.MonitorExplicacion</p>
            <ul class="lista-monitores">
                @for (var i = 0; i < _monitores.Count; i++)
                {
                    var indice = i;
                    var monitor = _monitores[indice];
                    <li>
                        <label class="monitor">
                            <input type="radio" name="monitor-puesto" checked="@(indice == _monitorElegido)" @onchange="() => _monitorElegido = indice" />
                            <span>@(monitor.Nombre ?? monitor.Dispositivo) · @monitor.Area.Ancho × @monitor.Area.Alto@(monitor.Principal ? " · Principal" : "")</span>
                        </label>
                    </li>
                }
            </ul>
            @if (_avisoMonitorError is not null)
            {
                <p id="aviso-monitor-error" class="aviso" role="status">@_avisoMonitorError</p>
            }
            @if (GuardarMonitor is not null && _monitores.Count > 0)
            {
                <div class="acciones">
                    <button id="guardar-monitor" type="button" class="principal" @onclick="GuardarElMonitor">Guardar</button>
                </div>
            }
        </section>

        <section role="tabpanel" id="seccion-red" class="seccion" aria-labelledby="pestana-red" hidden="@Oculta(Pestana.Red)">
            @* La red se lee al elegir la pestaña por primera vez, y la pestaña queda montada después (D2, D11). *@
            @if (_redMontada)
            {
                <PestanaRed Aplicar="AplicarRed" DireccionReceptor="DireccionReceptor" TieneCertificados="TieneCertificados" ProbarConexion="ProbarConexion" />
            }
        </section>

        @* Los correos, después de Impresora y sólo con la clave del día (D7 de avisar-por-correo). *@
        <section role="tabpanel" id="seccion-mails" class="seccion" aria-labelledby="pestana-mails" hidden="@Oculta(Pestana.Mails)">
            @if (Avisos is not null && GuardarCorreo is not null)
            {
                <section aria-labelledby="titulo-correo" class="textos-comprobante datos-comprobante">
                    <h3 id="titulo-correo">Avisos por correo</h3>
                    <p class="explicacion-correo">@MensajesAtencion.ExplicacionCorreo</p>
                    <span id="rotulo-correos-activos" class="rotulo">Correos</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-correos-activos">
                        <button id="correos-activos" type="button" aria-pressed="@(_correosActivos ? "true" : "false")" @onclick="() => _correosActivos = true">Activos</button>
                        <button id="correos-apagados" type="button" aria-pressed="@(_correosActivos ? "false" : "true")" @onclick="() => _correosActivos = false">Apagados</button>
                    </div>
                    <label for="cliente-correo">Cliente</label>
                    <input id="cliente-correo" type="text" maxlength="@ConfiguracionCorreo.LargoCliente" value="@_clienteCorreo"
                           aria-invalid="@(_camposCorreo.Contains("Cliente") ? "true" : null)" @oninput="e => _clienteCorreo = e.Value?.ToString() ?? string.Empty" />
                    <label for="remitente-correo">Remitente</label>
                    <input id="remitente-correo" type="email" maxlength="@ConfiguracionCorreo.LargoCasilla" value="@_remitenteCorreo"
                           aria-invalid="@(_camposCorreo.Contains("Remitente") ? "true" : null)" @oninput="e => _remitenteCorreo = e.Value?.ToString() ?? string.Empty" />
                    <label for="servidor-correo">Servidor</label>
                    <input id="servidor-correo" type="text" maxlength="100" value="@_servidorCorreo"
                           aria-invalid="@(_camposCorreo.Contains("Servidor") ? "true" : null)" @oninput="e => _servidorCorreo = e.Value?.ToString() ?? string.Empty" />
                    <label for="puerto-correo">Puerto</label>
                    <input id="puerto-correo" type="text" inputmode="numeric" maxlength="5" value="@_puertoCorreo"
                           aria-invalid="@(_camposCorreo.Contains("Puerto") ? "true" : null)" @oninput="e => _puertoCorreo = e.Value?.ToString() ?? string.Empty" />
                    <span id="rotulo-cifrado" class="rotulo">Cifrado</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-cifrado">
                        <button id="cifrado-starttls" type="button" aria-pressed="@(_cifradoTls ? "false" : "true")" @onclick="() => _cifradoTls = false">STARTTLS</button>
                        <button id="cifrado-tls" type="button" aria-pressed="@(_cifradoTls ? "true" : "false")" @onclick="() => _cifradoTls = true">TLS directo</button>
                    </div>
                    <span id="rotulo-segundo-factor" class="rotulo">Segundo factor</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-segundo-factor">
                        <button id="factor-aplicacion" type="button" aria-pressed="@(_factorOAuth ? "false" : "true")" @onclick="() => _factorOAuth = false">Contraseña de aplicación</button>
                        <button id="factor-oauth" type="button" aria-pressed="@(_factorOAuth ? "true" : "false")" @onclick="() => _factorOAuth = true">OAuth 2.0</button>
                    </div>
                    @for (var i = 0; i < ConfiguracionCorreo.MaximoOperadores; i++)
                    {
                        var indice = i;
                        var campo = "Operador" + (indice + 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
                        <label for="operador-correo-@(indice + 1)">Operador @(indice + 1)</label>
                        <input id="operador-correo-@(indice + 1)" type="email" maxlength="@ConfiguracionCorreo.LargoCasilla" value="@_operadoresCorreo[indice]"
                               aria-invalid="@(_camposCorreo.Contains(campo) ? "true" : null)" @oninput="e => _operadoresCorreo[indice] = e.Value?.ToString() ?? string.Empty" />
                    }
                    <label for="administrador-correo">Administrador Principal</label>
                    <input id="administrador-correo" type="email" maxlength="@ConfiguracionCorreo.LargoCasilla" value="@_administradorCorreo"
                           aria-invalid="@(_camposCorreo.Contains("Administrador") ? "true" : null)" @oninput="e => _administradorCorreo = e.Value?.ToString() ?? string.Empty" />
                    <label for="hora-senal">Señal de vida (HH:mm)</label>
                    <input id="hora-senal" type="text" inputmode="numeric" maxlength="5" value="@_horaSenal"
                           aria-invalid="@(_camposCorreo.Contains("HoraSenal") ? "true" : null)" @oninput="e => _horaSenal = e.Value?.ToString() ?? string.Empty" />
                    <span id="rotulo-servidor-simulado-correo" class="rotulo">Servidor simulado</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-servidor-simulado-correo">
                        <button id="servidor-correo-disponible" type="button" aria-pressed="@(Avisos.Servidor.Caido ? "false" : "true")" @onclick="() => CambiarCorreo(false)">Disponible</button>
                        <button id="servidor-correo-caido" type="button" aria-pressed="@(Avisos.Servidor.Caido ? "true" : "false")" @onclick="() => CambiarCorreo(true)">Caído</button>
                    </div>
                    @if (_avisoCorreo is not null)
                    {
                        <p id="aviso-correo" class="aviso" role="status">@_avisoCorreo</p>
                    }
                    <div class="acciones">
                        <button id="enviar-prueba-correo" type="button" disabled="@_enviandoPrueba" @onclick="EnviarPruebaCorreo">@(_enviandoPrueba ? "Enviando…" : "Enviar una prueba")</button>
                        <button id="guardar-correo" type="button" class="principal" @onclick="GuardarLosCorreos">Guardar</button>
                    </div>
                </section>
                <section aria-labelledby="titulo-estado-correo" class="estado-exportacion">
                    <h3 id="titulo-estado-correo">Estado de los correos</h3>
                    <p id="estado-correo">@MensajesAtencion.EstadoColaCorreo(Avisos.Pendientes)</p>
                    @if (_mensajeCorreo is not null)
                    {
                        <p id="mensaje-correo" class="@(_correoFallido ? "aviso" : "mensaje-exportacion")" role="status">@_mensajeCorreo</p>
                    }
                </section>
            }
        </section>

        @* El medio de identificación, después de Red y sólo con la clave del día (D8 de elegir-medio-de-identificacion). *@
        <section role="tabpanel" id="seccion-lector" class="seccion" aria-labelledby="pestana-lector" hidden="@Oculta(Pestana.Lector)">
            @if (LectorDelPuesto is not null && GuardarLector is not null)
            {
                <section aria-labelledby="titulo-lector" class="textos-comprobante datos-comprobante">
                    <h3 id="titulo-lector">Medio de identificación</h3>
                    <p class="explicacion-correo">@MensajesAtencion.ExplicacionLector</p>
                    <span id="rotulo-medio-lector" class="rotulo">Medio</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-medio-lector">
                        <button id="medio-teclado" type="button" aria-pressed="@(_medioLector == MedioIdentificacion.Teclado ? "true" : "false")" @onclick="() => _medioLector = MedioIdentificacion.Teclado">Teclado</button>
                        <button id="medio-simulador" type="button" aria-pressed="@(_medioLector == MedioIdentificacion.Simulador ? "true" : "false")" @onclick="() => _medioLector = MedioIdentificacion.Simulador">Simulador interno</button>
                        <button id="medio-puerto" type="button" aria-pressed="@(_medioLector == MedioIdentificacion.PuertoSerie ? "true" : "false")" @onclick="() => _medioLector = MedioIdentificacion.PuertoSerie">Puerto serie</button>
                    </div>
                    <label for="puerto-lector">Puerto</label>
                    <div class="numeracion">
                        <input id="puerto-lector" type="text" maxlength="6" value="@_puertoLector"
                               aria-invalid="@(_camposLector.Contains("Puerto") ? "true" : null)" @oninput="e => _puertoLector = e.Value?.ToString() ?? string.Empty" />
                        <button id="actualizar-puertos" type="button" @onclick="ActualizarPuertos">Actualizar</button>
                    </div>
                    @if (_puertosLector is not null)
                    {
                        <p id="puertos-lector" class="en-columna-de-campos" role="status">@_puertosLector</p>
                    }
                    <label for="velocidad-lector">Velocidad (baudios)</label>
                    <input id="velocidad-lector" type="text" inputmode="numeric" maxlength="6" value="@_velocidadLector"
                           aria-invalid="@(_camposLector.Contains("Velocidad") ? "true" : null)" @oninput="e => _velocidadLector = e.Value?.ToString() ?? string.Empty" />
                    <span id="rotulo-bits-lector" class="rotulo">Bits de datos</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-bits-lector">
                        <button id="bits-7" type="button" aria-pressed="@(_bitsLector == 7 ? "true" : "false")" @onclick="() => _bitsLector = 7">7</button>
                        <button id="bits-8" type="button" aria-pressed="@(_bitsLector == 8 ? "true" : "false")" @onclick="() => _bitsLector = 8">8</button>
                    </div>
                    <span id="rotulo-paridad-lector" class="rotulo">Paridad</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-paridad-lector">
                        <button id="paridad-ninguna" type="button" aria-pressed="@(_paridadLector == ParidadLector.Ninguna ? "true" : "false")" @onclick="() => _paridadLector = ParidadLector.Ninguna">Ninguna</button>
                        <button id="paridad-par" type="button" aria-pressed="@(_paridadLector == ParidadLector.Par ? "true" : "false")" @onclick="() => _paridadLector = ParidadLector.Par">Par</button>
                        <button id="paridad-impar" type="button" aria-pressed="@(_paridadLector == ParidadLector.Impar ? "true" : "false")" @onclick="() => _paridadLector = ParidadLector.Impar">Impar</button>
                    </div>
                    <span id="rotulo-parada-lector" class="rotulo">Bits de parada</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-parada-lector">
                        <button id="parada-1" type="button" aria-pressed="@(_paradaLector == 1 ? "true" : "false")" @onclick="() => _paradaLector = 1">1</button>
                        <button id="parada-2" type="button" aria-pressed="@(_paradaLector == 2 ? "true" : "false")" @onclick="() => _paradaLector = 2">2</button>
                    </div>
                    <span id="rotulo-terminador-lector" class="rotulo">Terminador</span>
                    <div class="numeracion" role="group" aria-labelledby="rotulo-terminador-lector">
                        <button id="terminador-crlf" type="button" aria-pressed="@(_terminadorLector == TerminadorLector.CrLf ? "true" : "false")" @onclick="() => _terminadorLector = TerminadorLector.CrLf">CR LF</button>
                        <button id="terminador-cr" type="button" aria-pressed="@(_terminadorLector == TerminadorLector.Cr ? "true" : "false")" @onclick="() => _terminadorLector = TerminadorLector.Cr">CR</button>
                        <button id="terminador-lf" type="button" aria-pressed="@(_terminadorLector == TerminadorLector.Lf ? "true" : "false")" @onclick="() => _terminadorLector = TerminadorLector.Lf">LF</button>
                        <button id="terminador-tab" type="button" aria-pressed="@(_terminadorLector == TerminadorLector.Tab ? "true" : "false")" @onclick="() => _terminadorLector = TerminadorLector.Tab">TAB</button>
                    </div>
                    <label for="relleno-lector">Relleno de dígitos (0 a 20)</label>
                    <input id="relleno-lector" type="text" inputmode="numeric" maxlength="2" value="@_rellenoLector"
                           aria-invalid="@(_camposLector.Contains("Relleno") ? "true" : null)" @oninput="e => _rellenoLector = e.Value?.ToString() ?? string.Empty" />
                    @if (_avisoLector is not null)
                    {
                        <p id="aviso-lector" class="aviso" role="status">@_avisoLector</p>
