        _factorOAuth = c.SegundoFactor == SegundoFactorCorreo.OAuth2;
        for (var i = 0; i < _operadoresCorreo.Length; i++)
        {
            _operadoresCorreo[i] = i < c.Operadores.Count ? c.Operadores[i] : string.Empty;
        }

        _administradorCorreo = c.Administrador ?? string.Empty;
