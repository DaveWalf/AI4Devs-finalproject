    /// <summary>
    /// «Guardar» de los correos: las casillas de operador vacías no cuentan, y un campo rechazado se señala en la casilla
    /// donde se tipeó aunque haya otras vacías antes (D7 de avisar-por-correo).
    /// </summary>
    private void GuardarLosCorreos()
    {
        var conCasilla = Enumerable.Range(0, _operadoresCorreo.Length).Where(i => _operadoresCorreo[i].Trim().Length > 0).ToList();
        var pedida = new ConfiguracionCorreo(
            _correosActivos, _clienteCorreo.Trim(), _remitenteCorreo.Trim(), _servidorCorreo.Trim(),
            int.TryParse(_puertoCorreo.Trim(), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var puerto) ? puerto : 0,
            _cifradoTls ? CifradoCorreo.Tls : CifradoCorreo.StartTls,
            _factorOAuth ? SegundoFactorCorreo.OAuth2 : SegundoFactorCorreo.ContrasenaDeAplicacion,
            conCasilla.Select(i => _operadoresCorreo[i].Trim()).ToList(),
            _administradorCorreo.Trim().Length == 0 ? null : _administradorCorreo.Trim(),
            _horaSenal.Trim());
        if (GuardarCorreo?.Invoke(pedida) is not { } resultado)
        {
            return;
        }

        _camposCorreo = resultado.Campos.Select(c =>
            c.StartsWith("Operador", StringComparison.Ordinal) && int.TryParse(c["Operador".Length..], out var n) && n >= 1 && n <= conCasilla.Count
                ? "Operador" + (conCasilla[n - 1] + 1).ToString(System.Globalization.CultureInfo.InvariantCulture)
                : c).ToList();
        _avisoCorreo = resultado.Aviso;
        _avisoGuardado = resultado.Guardado ? MensajesAtencion.CorreoGuardado : null;
    }

    /// <summary>
    /// «Enviar una prueba»: a todas las casillas guardadas, por la cola y fuera del hilo de la pantalla; dice si salió, si
    /// quedó en la cola o si no hay casillas (D7).
    /// </summary>
    private async Task EnviarPruebaCorreo()
    {
        _enviandoPrueba = true;
        _mensajeCorreo = null;
        try
        {
            // Las casillas las cuenta quien envía, con lo guardado recién: el parámetro de la pantalla puede ser el de antes.
            var resultado = await Task.Run(() => Avisos!.EnviarPrueba());
            (_mensajeCorreo, _correoFallido) = resultado switch
            {
                null => (MensajesAtencion.PruebaCorreoSinCasillas, true),
                { Pendientes: 0 } => (MensajesAtencion.PruebaCorreoEnviada(resultado.Casillas), false),
                _ => (MensajesAtencion.PruebaCorreoEnCola, true),
            };
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException or Microsoft.Data.Sqlite.SqliteException)
        {
            (_mensajeCorreo, _correoFallido) = (MensajesAtencion.PruebaCorreoFallida, true);
        }
        finally
        {
            _enviandoPrueba = false;
        }
    }

