@using Intelektron.INComedor.Infrastructure.Sqlite
@implements IDisposable
@inject MaquinaAtencion Maquina
@inject ServicioAtencion Servicio
@inject IServiceProvider Proveedor

@* La presentación táctil (D3 de presentar-atencion-tactil): los estilos están en wwwroot/css/puesto.css. *@
@* Escape en reposo pide el cierre del puesto según el modo (D7 de configurar-puesto-por-pestanas). *@
<div class="puesto" style="@_vista.VariablesCss" tabindex="-1" @ref="_raiz" @onkeydown="TeclaRaiz">
    @* Con Configuración abierta, el resto de la página es inerte: el foco no sale del diálogo (D5). *@
    <header class="cabecera" inert="@HayDialogo">
        <img class="logo-empresa" src="@_logos.Empresa" alt="Logo de la empresa" />
        <span class="servicio">Comedor · tu pausa del día</span>
        <img class="logo-concesionaria" src="@_logos.Concesionaria" alt="Logo de la concesionaria" />
    </header>

    <main class="atencion" inert="@HayDialogo">
        @switch (Maquina.Estado)
        {
            case EstadoAtencion.ErrorAlmacenamiento:
                <section class="tarjeta superficie">
                    <p id="error-almacenamiento" class="error" role="alert">@MensajesAtencion.ErrorAlmacenamiento</p>
                </section>
                break;

            case EstadoAtencion.Reposo:
                <section class="tarjeta superficie">
                    <h2>Identificate para comenzar</h2>
                    <p>Identificación simulada por código (demostración)</p>
                    <input id="codigo" type="text" inputmode="numeric" autocomplete="off" aria-label="Código"
                           value="@_codigo" @oninput="e => _codigo = e.Value?.ToString() ?? string.Empty" />
                    <div class="acciones">
                        <button id="ingresar" type="button" class="principal" @onclick="Ingresar">Ingresar</button>
                        <button id="asistencia" type="button" @onclick="EntrarAsistencia">Asistencia</button>
                    </div>
                    @if (Maquina.Aviso is not null)
                    {
                        <p id="aviso" class="aviso" role="status">@Maquina.Aviso</p>
                    }
                </section>
                break;

            case EstadoAtencion.Seleccion:
            case EstadoAtencion.Confirmando:
                <div class="titulo superficie">
                    <h2>Elegí tu servicio de hoy</h2>
                    <p id="saludo">Hola, <strong>@Maquina.NombreVisible</strong></p>
                    @* Sólo lo agotado hoy, que es lo que explica una opción ausente (D3 de ofrecer-solo-opciones-disponibles). *@
                    @if (Maquina.UsoDelDia is { } uso)
                    {
                        <p id="uso-del-dia" class="uso-del-dia">@uso</p>
                    }
                </div>
                @if (Maquina.Aviso is not null && Maquina.Estado == EstadoAtencion.Seleccion)
                {
                    <p id="aviso" class="aviso titulo superficie" role="status">@Maquina.Aviso</p>
                }
                <div class="lista">
                    @* Con dos columnas, cinco filas y el flujo por columna: la primera se completa antes que la segunda (D1). *@
                    <div class="opciones" data-columnas="@Maquina.ColumnasPagina" data-filas="@Filas">
                        @foreach (var opcion in Maquina.PaginaActual)
                        {
                            var elegida = opcion.Id == Maquina.Elegida?.Id;
                            <button type="button" class="opcion @(elegida ? "elegida" : "")" aria-pressed="@(elegida ? "true" : "false")"
                                    @onclick="() => Maquina.Elegir(opcion.Id)">
                                <span class="nombre">@opcion.Nombre</span>
                                @if (elegida)
                                {
                                    <span class="marca-elegida">Elegida</span>
                                }
                                @if (opcion.Cargo.Length > 0)
                                {
                                    <span class="cargo">@opcion.Cargo</span>
                                }
                            </button>
                        }
                    </div>
                </div>
                @if (Maquina.TotalPaginas > 1)
                {
                    <div class="paginas">
                        <button id="anterior" type="button" aria-disabled="@(Maquina.PuedeRetroceder ? "false" : "true")" @onclick="Maquina.Anterior">Anterior</button>
                        <span class="numero-pagina superficie">Página @Maquina.Pagina de @Maquina.TotalPaginas</span>
                        <button id="siguiente" type="button" aria-disabled="@(Maquina.PuedeAvanzar ? "false" : "true")" @onclick="Maquina.Siguiente">Siguiente</button>
                    </div>
                }
                <div class="barra superficie">
                    @if (Maquina.Elegida is { } eleccion)
                    {
                        <p id="eleccion">
                            Confirmar: <strong>@eleccion.Nombre</strong>
                            @if (eleccion.Cargo.Length > 0)
                            {
                                <span> · Cargo informado: @eleccion.Cargo</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="indicacion">Tocá tu opción y confirmá la elección</p>
                    }
                    <div class="acciones">
                        <button id="cancelar" type="button" disabled="@(Maquina.Estado == EstadoAtencion.Confirmando)" @onclick="Maquina.Cancelar">Cancelar</button>
                        @if (Maquina.Estado == EstadoAtencion.Confirmando)
                        {
                            <button id="confirmar" type="button" class="principal" disabled aria-busy="true">Confirmando…</button>
                        }
                        else
                        {
                            <button id="confirmar" type="button" class="principal" @onclick="Confirmar">Confirmar</button>
                        }
                    </div>
                    @if (Maquina.Estado == EstadoAtencion.Confirmando)
                    {
                        <p id="ocupado" role="status">Confirmando: el puesto está ocupado</p>
                    }
                </div>
                break;

            case EstadoAtencion.Reconfirmacion:
                <section class="tarjeta superficie">
                    <p id="saludo">Hola, <strong>@Maquina.NombreVisible</strong></p>
                    <p id="aviso" class="aviso" role="status">@Maquina.Aviso</p>
                    <p id="vigente">Valor vigente: <strong>@Maquina.Vigente?.Nombre</strong>@if (!string.IsNullOrEmpty(Maquina.Vigente?.Cargo))
                    {
                        @* El separador y el cargo, sólo si hay cargo (D2). *@
                        <text> · </text><span id="cargo-vigente">@Maquina.Vigente.Cargo</span>
                    }</p>
                    <div class="acciones">
                        <button id="volver" type="button" @onclick="Maquina.Volver">Volver</button>
                        <button id="reconfirmar" type="button" class="principal" @onclick="Reconfirmar">Reconfirmar</button>
                    </div>
                </section>
                break;

            case EstadoAtencion.SinOpciones:
                @* Ninguna opción disponible: el aviso, lo usado o el motivo, y «Listo» (D4); sin opciones ni «Confirmar». *@
                <section class="tarjeta superficie">
                    <p id="mensaje" class="mensaje" role="status">@MensajesAtencion.SinOpciones</p>
                    @if (Maquina.UsoDelDia is { } usado)
                    {
                        <p id="uso-del-dia" class="aviso">@usado</p>
                    }
                    else if (Maquina.MotivoSinOpciones is { } motivo)
                    {
                        <p id="motivo-sin-opciones" class="aviso">@motivo</p>
                    }
                    <div class="acciones">
                        <button id="listo" type="button" class="principal" @onclick="Maquina.Listo">Listo</button>
                    </div>
                </section>
                break;

            case EstadoAtencion.Resultado:
                <section class="tarjeta superficie">
                    <p id="mensaje" class="mensaje" role="status">@Maquina.Mensaje</p>
                    @if (Maquina.ComprobanteEnPantalla is { } papel)
                    {
                        @* Con la impresora simulada, el comprobante sale de una impresora en pantalla; tocarlo es «Listo» (D7). *@
                        <div class="impresora">
                            <div class="boca" aria-hidden="true"></div>
                            <button id="listo" type="button" class="comprobante" aria-label="Retirar el comprobante" @onclick="Maquina.Listo">
                                <span class="encabezado-comprobante">INComedor · comprobante</span>
                                <span class="leyenda">@papel.Leyenda · N.º @papel.Numero</span>
                                <span class="opcion-comprobante">@papel.Opcion</span>
                                <span>Fecha: @papel.FechaNegocio</span>
                                @if (papel.Cargo.Length > 0)
                                {
                                    <span>Cargo informado: @papel.Cargo</span>
                                }
                                <span class="retirar">Tocá el comprobante para retirarlo</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="acciones">
                            <button id="listo" type="button" class="principal" @onclick="Maquina.Listo">Listo</button>
                        </div>
                    }
                </section>
                break;

            case EstadoAtencion.Asistencia:
                <section class="tarjeta ancha superficie">
                    <h2>Asistencia</h2>
                    <p>Operador: <strong>@Maquina.NombreVisible</strong> · Identificación simulada por código (demostración)</p>
                    @if (Maquina.MensajeAsistencia is not null)
                    {
                        <p id="mensaje-asistencia" role="status">@Maquina.MensajeAsistencia</p>
                    }
                    @if (Maquina.ReimpresionPedida is { } pedida)
                    {
                        <section aria-label="Motivo de la reimpresión">
                            @if (Maquina.AvisoIncertidumbre)
                            {
                                <p id="aviso-incertidumbre" class="aviso" role="alert">@MensajesAtencion.Incertidumbre</p>
                            }
                            <p>Reimprimir el comprobante de las @Hora(pedida.CreadoUtc) · @pedida.Opcion. Elegí el motivo:</p>
                            <div class="acciones">
                                @foreach (var motivo in Enum.GetValues<MotivoReimpresion>())
                                {
                                    <button type="button" class="motivo" @onclick="() => Maquina.Reimprimir(motivo)">@MensajesAtencion.Motivo(motivo)</button>
                                }
                                <button id="cancelar-reimpresion" type="button" @onclick="Maquina.CancelarReimpresion">Cancelar</button>
                            </div>
                        </section>
                    }
                    else
                    {
                        <table>
                            <thead><tr><th>Hora</th><th>Opción</th><th>Persona</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var comprobante in Maquina.Comprobantes)
                                {
                                    <tr>
                                        <td>@Hora(comprobante.CreadoUtc)</td>
                                        <td>@comprobante.Opcion</td>
                                        <td>@comprobante.NombreVisible</td>
                                        <td>@Estado(comprobante.EstadoUltimoTrabajo)</td>
                                        <td>
                                            @if (comprobante.EstadoOriginal == EstadoTrabajoImpresion.Failed)
                                            {
                                                <button type="button" class="recuperar" @onclick="() => Maquina.Recuperar(comprobante.TrabajoOriginalId)">Recuperar</button>
                                            }
                                            <button type="button" class="reimprimir" @onclick="() => Maquina.PedirReimpresion(comprobante.TicketId)">Reimprimir</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="acciones">
                        <button id="salir" type="button" @onclick="Maquina.SalirAsistencia">Salir</button>
                    </div>
                </section>
                break;
        }
    </main>

    <footer class="pie" inert="@HayDialogo">
        <FranjaSincronizacion Estado="Servicio.Sincronizacion" />
        <div class="pie-derecha">
            <img class="marca-intelektron" src="img/intelektron.svg" alt="Intelektron" />
            @* El engranaje va en el borde, al lado de la marca, y sólo en reposo; durante la atención su lugar queda reservado (D1, D2 y D5). *@
            @if (Maquina.Estado == EstadoAtencion.Reposo)
            {
                <button type="button" class="engranaje" aria-label="Configuración" @onclick="AbrirConfiguracion"><span aria-hidden="true">&#9881;</span></button>
            }
            else
            {
                <span class="lugar-engranaje"></span>
            }
        </div>
    </footer>

    @* Configuración sólo se abre en reposo, y no cambia el estado de la máquina (D5). *@
    @if (ConfiguracionAbierta)
    {
        <PanelConfiguracion Estilo="_vista" Impresora="@(Servicio.Impresora as ImpresoraSimulada)"
                            Bitacoras="_estadoBitacoras" Zona="ZonaDelPuesto" ModoImpresoraCambiado="RegistrarModoImpresora"
                            Administracion="Servicio.Administracion"
                            VistaPrevia="estilo => _vista = estilo" GuardarEstilo="GuardarConfiguracion" Cancelar="CancelarConfiguracion"
                            Modo="_modo" AvisoModo="@_avisoModo" PasarAOperativo="PasarAOperativo" PasarAMantenimiento="PasarAMantenimiento"
                            PuedeCerrar="@(_cierre is not null)" CerrarPuesto="@(() => SolicitarCierre("CLOSE_BUTTON"))"
                            Inerte="@(_pedidoClave is not null)" />
    }

    @* La clave del día, cuando el modo la pide para abrir Configuración, cerrar el puesto o pasar a operativo (D6). *@
    @if (_pedidoClave is { } pedido)
    {
        <DialogoClaveDelDia Validador="_validador" Fecha="FechaLocal" Motivo="@MotivoClave(pedido)" Resultado="ResultadoClave"
                            Cancelada="() => _pedidoClave = null" />
    }
</div>

@code {
    private string _codigo = string.Empty;
    private Timer? _temporizador;
    private Logos _logos = new(LogosLocales.EmpresaDeEjemplo, LogosLocales.ConcesionariaDeEjemplo);
    private AlmacenEstiloVisual? _almacenEstilo;
    private EstiloVisual _guardado = EstiloVisual.PorDefecto;
    private EstiloVisual _vista = EstiloVisual.PorDefecto;
    private bool _configuracion;
    private IReadOnlyList<EstadoBitacora>? _estadoBitacoras;
    private ElementReference _raiz;
    private EstadoAtencion? _estadoDibujado;
    private AlmacenModoPuesto? _almacenModo;
    private ModoPuesto _modo = ModoPuesto.Mantenimiento;
    private string? _avisoModo;
    private CierrePuesto? _cierre;
    private IValidadorClaveDelDia _validador = new ClaveDelDiaDeDesarrollo();
    private AccionClave? _pedidoClave;
    private string _fuenteCierre = "ESCAPE";
    private string _acceso = AccesoMantenimiento;

    /// <summary>Para qué se pidió la clave del día; su código va a DAILY_KEY_ACCEPTED o DAILY_KEY_REJECTED (D17).</summary>
    private enum AccionClave
    {
        AbrirConfiguracion,
        CerrarPuesto,
        ActivarOperativo,
    }

    private const string AccesoMantenimiento = "MAINTENANCE_MODE";
    private const string AccesoClave = "DAILY_KEY";

    private static readonly TimeZoneInfo ZonaDelPuesto = TimeZoneInfo.FindSystemTimeZoneById("America/Argentina/Buenos_Aires");

    private bool ConfiguracionAbierta => _configuracion && Maquina.Estado == EstadoAtencion.Reposo;

    /// <summary>Con Configuración o la clave del día a la vista, el resto de la página es inerte.</summary>
    private bool HayDialogo => ConfiguracionAbierta || _pedidoClave is not null;

    private DateOnly FechaLocal => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Servicio.Reloj.GetUtcNow(), ZonaDelPuesto).DateTime);

    /// <summary>Cinco filas con dos columnas; con una, tantas como opciones (D1).</summary>
    private string Filas => Maquina.ColumnasPagina == 2 ? "5" : Maquina.PaginaActual.Count.ToString();

    protected override void OnInitialized()
    {
        Servicio.SincronizacionCambiada += RefrescarSincronizacion;
        // Sin carpeta de logos registrada (las pruebas que no la usan), quedan los de ejemplo (D4).
        if (Proveedor.GetService(typeof(LogosLocales)) is LogosLocales logos)
        {
            _logos = logos.Leer();
        }

        // Sin almacén registrado, el estilo por defecto y «Guardar» sólo dura la sesión (D5).
        _almacenEstilo = Proveedor.GetService(typeof(AlmacenEstiloVisual)) as AlmacenEstiloVisual;
        _guardado = _vista = _almacenEstilo?.Leer() ?? EstiloVisual.PorDefecto;

        // Sin almacén del modo registrado (las pruebas que no lo usan), mantenimiento en memoria, como el estilo (D5).
        _almacenModo = Proveedor.GetService(typeof(AlmacenModoPuesto)) as AlmacenModoPuesto;
        _modo = _almacenModo?.Leer() ?? ModoPuesto.Mantenimiento;
        if (Proveedor.GetService(typeof(IValidadorClaveDelDia)) is IValidadorClaveDelDia validador)
        {
            _validador = validador;
        }

        _cierre = Proveedor.GetService(typeof(CierrePuesto)) as CierrePuesto;
        if (_cierre is not null)
        {
            _cierre.RequiereClave = _modo == ModoPuesto.Operativo;
            _cierre.ClavePedida += PedirClaveDeLaVentana;
        }

        Maquina.Iniciar();
        _temporizador = new Timer(_ => _ = InvokeAsync(Revisar), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Revisar()
    {
        if (Maquina.RevisarInactividad())
        {
            CancelarConfiguracionFueraDeReposo();
            StateHasChanged();
        }
    }

    /// <summary>El campo queda vacío apenas se envía: el código no se vuelve a mostrar.</summary>
    private void Ingresar()
    {
        var codigo = _codigo;
        _codigo = string.Empty;
        Maquina.Identificar(codigo);
        CancelarConfiguracionFueraDeReposo();
    }

    private void EntrarAsistencia()
    {
        var codigo = _codigo;
        _codigo = string.Empty;
        Maquina.EntrarAsistencia(codigo);
        CancelarConfiguracionFueraDeReposo();
    }

    /// <summary>
    /// Si se sale de reposo con Configuración abierta (el resto de la página es inerte, pero por si acaso), se cancela
    /// como con «Cancelar»: la vista previa sin guardar no queda aplicada ni el panel reaparece al volver a reposo.
    /// </summary>
    private void CancelarConfiguracionFueraDeReposo()
    {
        if (_configuracion && Maquina.Estado != EstadoAtencion.Reposo)
        {
            CancelarConfiguracion();
        }
    }

    private Task Confirmar() => Maquina.ConfirmarAsync();

    /// <summary>El engranaje: directo en mantenimiento, con la clave del día en operativo (acceso-puesto).</summary>
    private void AbrirConfiguracion()
    {
        if (Maquina.Estado != EstadoAtencion.Reposo)
        {
            return;
        }

        if (_modo == ModoPuesto.Operativo)
        {
            _pedidoClave = AccionClave.AbrirConfiguracion;
            return;
        }

        AbrirConfiguracionCon(AccesoMantenimiento);
    }

    private void AbrirConfiguracionCon(string acceso)
    {
        _vista = _guardado;
        _acceso = acceso;
        _avisoModo = null;
        // El estado se lee antes de registrar la apertura: muestra lo que había al tocar el engranaje.
        _estadoBitacoras = LeerEstadoBitacoras();
        RegistrarConfiguracion("CONFIGURATION_OPENED", new { Access = _acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        _configuracion = true;
    }

    /// <summary>
    /// Escape en reposo, sin diálogos, pide el cierre del puesto; durante una atención no hace nada (acceso-puesto). Los
    /// diálogos no dejan pasar la tecla hasta acá.
    /// </summary>
    private void TeclaRaiz(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Maquina.Estado == EstadoAtencion.Reposo && !HayDialogo)
        {
            SolicitarCierre("ESCAPE");
        }
    }

    /// <summary>El cierre ordenado: directo en mantenimiento y, en operativo, después de la clave del día (D7).</summary>
    private void SolicitarCierre(string fuente)
    {
        if (_cierre is null)
        {
            return;
        }

        if (_modo == ModoPuesto.Operativo)
        {
            _fuenteCierre = fuente;
            _pedidoClave = AccionClave.CerrarPuesto;
            return;
        }

        Cerrar(fuente, AccesoMantenimiento);
    }

    private void Cerrar(string fuente, string acceso)
    {
        RegistrarConfiguracion("KIOSK_CLOSE_REQUESTED", new { Source = fuente, Access = acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        _cierre?.Cerrar();
    }

    /// <summary>La ventana pidió cerrarse en operativo sin la clave: se la pide la pantalla, desde su hilo (D7).</summary>
    private void PedirClaveDeLaVentana() => _ = InvokeAsync(() =>
    {
        _fuenteCierre = "WINDOW_CLOSE";
        _pedidoClave = AccionClave.CerrarPuesto;
        StateHasChanged();
    });

    private static string MotivoClave(AccionClave accion) => accion switch
    {
        AccionClave.AbrirConfiguracion => "Ingresá la clave del día para abrir Configuración",
        AccionClave.CerrarPuesto => "Ingresá la clave del día para cerrar el puesto",
        _ => "Ingresá la clave del día para pasar a operativo",
    };

    private static string CodigoDe(AccionClave accion) => accion switch
    {
        AccionClave.AbrirConfiguracion => "OPEN_CONFIGURATION",
        AccionClave.CerrarPuesto => "CLOSE_KIOSK",
        _ => "ACTIVATE_OPERATIVE",
    };

    /// <summary>Cada «Aceptar» de la clave queda en la general con su acción, nunca con lo tipeado (D17).</summary>
    private void ResultadoClave(bool valida)
    {
        if (_pedidoClave is not { } accion)
        {
            return;
        }

        if (!valida)
        {
            RegistrarConfiguracion("DAILY_KEY_REJECTED", new
            {
                Action = CodigoDe(accion), Cause = "INVALID_FORMAT", ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion,
            }, SeveridadBitacora.Warning);
            return;
        }

        RegistrarConfiguracion("DAILY_KEY_ACCEPTED", new { Action = CodigoDe(accion), ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        _pedidoClave = null;
        switch (accion)
        {
            case AccionClave.AbrirConfiguracion:
                if (Maquina.Estado == EstadoAtencion.Reposo)
                {
                    AbrirConfiguracionCon(AccesoClave);
                }

                break;
            case AccionClave.CerrarPuesto:
                Cerrar(_fuenteCierre, AccesoClave);
                break;
            default:
                CambiarModo(ModoPuesto.Operativo, AccesoClave);
                break;
        }
    }

    private void PasarAOperativo() => _pedidoClave = AccionClave.ActivarOperativo;

    /// <summary>Volver a mantenimiento no pide la clave otra vez: ya se entró con ella (acceso-puesto).</summary>
    private void PasarAMantenimiento() => CambiarModo(ModoPuesto.Mantenimiento, _acceso);

    private void CambiarModo(ModoPuesto nuevo, string acceso)
    {
        var antes = _modo;
        var resultado = "APPLIED";
        try
        {
            _almacenModo?.Guardar(nuevo);
            _modo = nuevo;
            _avisoModo = null;
            if (_cierre is not null)
            {
                _cierre.RequiereClave = _modo == ModoPuesto.Operativo;
            }
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            resultado = "FAILED";
            _avisoModo = MensajesAtencion.ModoNoGuardado;
        }

        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "KIOSK_MODE",
            Before = CodigoDe(antes),
            After = CodigoDe(nuevo),
            Result = resultado,
            Effective = CodigoDe(_modo),
            Access = acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });
    }

    private static string CodigoDe(ModoPuesto modo) => modo == ModoPuesto.Operativo ? "OPERATIVE" : "MAINTENANCE";

    /// <summary>
    /// Sin escritura en la carpeta de datos, el estilo guardado queda como estaba y el diálogo lo avisa: la atención sigue
    /// («Estilo por defecto y validado»). Configuración queda abierta (D3 de configurar-puesto-por-pestanas). Cada guardado
    /// queda en la bitácora con el antes, el después y lo vigente (D9 de escribir-bitacoras-externas).
    /// </summary>
    private bool GuardarConfiguracion()
    {
        var antes = _guardado;
        try
        {
            _almacenEstilo?.Guardar(_vista);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            RegistrarCambioDeEstilo(antes, _vista, "FAILED", vigente: antes);
            return false;
        }

        _guardado = _vista;
        RegistrarCambioDeEstilo(antes, _guardado, "APPLIED", vigente: _guardado);
        return true;
    }

    private void CancelarConfiguracion()
    {
        _vista = _guardado;
        _configuracion = false;
        RegistrarConfiguracion("CONFIGURATION_CANCELLED", new { Access = _acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
    }

    /// <summary>Sin clave, Configuración no tiene actor: va nulo con este motivo, sin inventar a nadie (D9).</summary>
    private const string SinAutenticacion = "NO_AUTHENTICATION";

    private void RegistrarCambioDeEstilo(EstiloVisual antes, EstiloVisual despues, string resultado, EstiloVisual vigente) =>
        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "VISUAL_STYLE",
            Before = new { Opacity = antes.Opacidad, Blur = antes.Desenfoque },
            After = new { Opacity = despues.Opacidad, Blur = despues.Desenfoque },
            Result = resultado,
            Effective = new { Opacity = vigente.Opacidad, Blur = vigente.Desenfoque },
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });

    private void RegistrarModoImpresora(CambioModoImpresora cambio) =>
        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "PRINTER_SIMULATION_MODE",
            Before = CodigoDe(cambio.Antes),
            After = CodigoDe(cambio.Despues),
            Result = "APPLIED",
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });

    private static string CodigoDe(ModoImpresoraSimulada modo) => modo switch
    {
        ModoImpresoraSimulada.Disponible => "AVAILABLE",
        ModoImpresoraSimulada.SinPapel => "PAPER_OUT",
        _ => "UNCERTAIN",
    };

    /// <summary>
    /// Configuración sigue aunque SQLite no registre: el ajuste es local y la atención muestra el error de almacenamiento en
    /// su próxima escritura.
    /// </summary>
    private void RegistrarConfiguracion(string tipo, object contexto, string severidad = SeveridadBitacora.Info)
    {
        try
        {
            Servicio.RegistroConfiguracion?.Registrar(tipo, contexto, severidad);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            // Ver el resumen: el ajuste no depende de la bitácora.
        }
    }

    private IReadOnlyList<EstadoBitacora>? LeerEstadoBitacoras()
    {
        try
        {
            return Servicio.Bitacoras?.Estado();
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            return null;
        }
    }

    private Task Reconfirmar() => Maquina.ReconfirmarAsync();

    private string Hora(DateTimeOffset instante) =>
        TimeZoneInfo.ConvertTime(instante, TimeZoneInfo.FindSystemTimeZoneById("America/Argentina/Buenos_Aires")).ToString("HH:mm");

    private static string Estado(EstadoTrabajoImpresion estado) => estado switch
    {
        EstadoTrabajoImpresion.Submitted => "Enviado",
        EstadoTrabajoImpresion.Failed => "Falló",
        EstadoTrabajoImpresion.Unknown => "Incierto",
        _ => "En cola",
    };

    /// <summary>El ciclo de envío avisa desde su hilo; la franja se redibuja en el del componente.</summary>
    private void RefrescarSincronizacion() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// En reposo y sin diálogos, el foco vuelve a la raíz para que Escape llegue aunque no se haya tocado nada: al abrir, al
    /// volver de una atención y al cerrar un diálogo (D7).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool primera)
    {
        var enReposo = Maquina.Estado == EstadoAtencion.Reposo && !HayDialogo;
        var estado = HayDialogo ? (EstadoAtencion?)null : Maquina.Estado;
        if (enReposo && (primera || _estadoDibujado != EstadoAtencion.Reposo))
        {
            await _raiz.FocusAsync();
        }

        _estadoDibujado = estado;
    }

    public void Dispose()
    {
        if (_cierre is not null)
        {
            _cierre.ClavePedida -= PedirClaveDeLaVentana;
        }

        Servicio.SincronizacionCambiada -= RefrescarSincronizacion;
        _temporizador?.Dispose();
    }
}
