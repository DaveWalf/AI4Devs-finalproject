@using Intelektron.INComedor.Infrastructure.Sqlite
@using Intelektron.INComedor.Kiosk.Red
@implements IDisposable
@inject MaquinaAtencion Maquina
@inject ServicioAtencion Servicio
@inject IServiceProvider Proveedor

@* La presentación táctil (D3 de presentar-atencion-tactil): los estilos están en wwwroot/css/puesto.css. *@
@* Escape en reposo pide el cierre del puesto según el modo (D7 de configurar-puesto-por-pestanas). *@
<div class="puesto" style="@_vista.VariablesCss" tabindex="-1" @ref="_raiz" @onkeydown="TeclaRaiz">
    @* Con Configuración abierta, el resto de la página es inerte: el foco no sale del diálogo (D5). *@
    <header class="cabecera" inert="@(HayDialogo || CartelVisible)">
        <img class="logo-empresa" src="@_logos.Empresa" alt="Logo de la empresa" />
        <span class="servicio">INComedor · tu pausa del día</span>
        <img class="logo-concesionaria" src="@_logos.Concesionaria" alt="Logo de la concesionaria" />
    </header>

    <main class="atencion" inert="@HayDialogo">
        @switch (Maquina.Estado)
        {
            case EstadoAtencion.ErrorAlmacenamiento:
                <section class="tarjeta superficie">
                    <p id="error-almacenamiento" class="error" role="alert">@MensajesAtencion.ErrorAlmacenamiento</p>
                </section>
                break;

            case EstadoAtencion.Reposo:
                <section class="tarjeta superficie">
                    <h2>@MensajesAtencion.TituloReposo</h2>
                    <p>Identificación simulada por código (demostración)</p>
                    @* El combo va arriba del campo del código, y el campo e «Ingresar» en su fila (D12 de simular-identificacion-por-lista). *@
                    @if (SimulacionActiva)
                    {
                        @* El combo del modo simulación: el valor es la credencial, nunca el código; elegir identifica en el acto (D1 y D9). *@
                        @* Es la lista propia, dibujada en la página, y no un select nativo: así se abre en el monitor del puesto (D3 de *@
                        @* ordenar-configuracion). La clave cambia con cada elección: la lista se vuelve a crear cerrada y sin elegida. *@
                        <div class="simulacion">
                            <label for="simulacion-persona">Simulación: elegí a la persona</label>
                            <ListaDesplegable @key="_eleccionesSimulacion" Id="simulacion-persona" Entradas="_entradasSimulacion" Valor=""
                                              TextoVacio="Elegí a una persona…" ValorChanged="ElegirEnSimulacion" />
                        </div>
                    }
                    <div class="ingreso">
                        <input id="codigo" type="text" inputmode="numeric" autocomplete="off" aria-label="Código"
                               value="@_codigo" @oninput="e => _codigo = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaCodigo" />
                        <button id="ingresar" type="button" class="principal" @onclick="Ingresar">Ingresar</button>
                    </div>
                    @if (Maquina.Aviso is not null)
                    {
                        <p id="aviso" class="aviso" role="status">@Maquina.Aviso</p>
                    }
                </section>
                break;

            case EstadoAtencion.Seleccion:
            case EstadoAtencion.Confirmando:
                @* «Cancelar» va en el título, a la derecha del saludo, y la selección no tiene barra al pie (D2 de confirmar-eleccion-en-cartel). *@
                @* Con el cartel abierto, el resto de la pantalla queda inerte (D3). *@
                <div class="titulo superficie" inert="@CartelVisible">
                    <h2>Elegí tu servicio de hoy</h2>
                    <p id="saludo">Hola, <strong>@Maquina.NombreVisible</strong></p>
                    <button id="cancelar" type="button" disabled="@(Maquina.Estado == EstadoAtencion.Confirmando)" @onclick="Maquina.Cancelar">Cancelar</button>
                    @* Sólo lo agotado hoy, que es lo que explica una opción ausente (D3 de ofrecer-solo-opciones-disponibles). *@
                    @if (Maquina.UsoDelDia is { } uso)
                    {
                        <p id="uso-del-dia" class="uso-del-dia">@uso</p>
                    }
                </div>
                @if (Maquina.Aviso is not null && Maquina.Estado == EstadoAtencion.Seleccion)
                {
                    <p id="aviso" class="aviso titulo superficie" role="status" inert="@CartelVisible">@Maquina.Aviso</p>
                }
                <div class="lista" inert="@CartelVisible">
                    @* Con dos columnas, cinco filas y el flujo por columna: la primera se completa antes que la segunda (D1). *@
                    <div class="opciones" data-columnas="@Maquina.ColumnasPagina" data-filas="@Filas">
                        @foreach (var opcion in Maquina.PaginaActual)
                        {
                            var elegida = opcion.Id == Maquina.Elegida?.Id;
                            @* Con su presentación: el fondo y la transparencia, y sin cargo si el precio está oculto (D4 de personalizar-opciones). *@
                            var (estiloFondo, claseFondo) = _presentacionOpciones?.EstiloDe(opcion.Id) ?? (null, string.Empty);
                            <button type="button" class="opcion @claseFondo @(elegida ? "elegida" : "")" aria-pressed="@(elegida ? "true" : "false")"
                                    style="@estiloFondo" @onclick="() => ElegirOpcion(opcion.Id)">
                                <span class="nombre">@opcion.Nombre</span>
                                @if (elegida)
                                {
                                    <span class="marca-elegida">Elegida</span>
                                }
                                @if (CargoVisible(opcion) is { Length: > 0 } cargoVisible)
                                {
                                    <span class="cargo">@cargoVisible</span>
                                }
                            </button>
                        }
                    </div>
                </div>
                @if (Maquina.TotalPaginas > 1)
                {
                    <div class="paginas" inert="@CartelVisible">
                        <button id="anterior" type="button" aria-disabled="@(Maquina.PuedeRetroceder ? "false" : "true")" @onclick="Maquina.Anterior">Anterior</button>
                        <span class="numero-pagina superficie">Página @Maquina.Pagina de @Maquina.TotalPaginas</span>
                        <button id="siguiente" type="button" aria-disabled="@(Maquina.PuedeAvanzar ? "false" : "true")" @onclick="Maquina.Siguiente">Siguiente</button>
                    </div>
                }
                @* El cartel de la elección: repite lo elegido con su cargo y es el único lugar con «Confirmar» (D1). *@
                @if (CartelVisible && Maquina.Elegida is { } eleccion)
                {
                    var confirmando = Maquina.Estado == EstadoAtencion.Confirmando;
                    <div class="fondo-cartel">
                        <section id="cartel-eleccion" class="cartel superficie" role="dialog" aria-modal="true" aria-labelledby="titulo-cartel">
                            <h2 id="titulo-cartel">¿Confirmás tu elección?</h2>
                            <p id="eleccion">
                                <strong class="nombre-eleccion">@eleccion.Nombre</strong>
                                @if (CargoVisible(eleccion) is { Length: > 0 } cargoEleccion)
                                {
                                    <span class="cargo-eleccion">Cargo informado: @cargoEleccion</span>
                                }
                            </p>
                            <div class="acciones">
                                <button id="elegir-otra" type="button" disabled="@confirmando" @onclick="ElegirOtra">Elegir otra</button>
                                @if (confirmando)
                                {
                                    <button id="confirmar" type="button" class="principal" disabled aria-busy="true">Confirmando…</button>
                                }
                                else
                                {
                                    <button id="confirmar" type="button" class="principal" @ref="_confirmarCartel" @onclick="Confirmar">Confirmar</button>
                                }
                            </div>
                            @if (confirmando)
                            {
                                <p id="ocupado" role="status">@MensajesAtencion.Confirmando</p>
                            }
                        </section>
                    </div>
                }
                break;

            case EstadoAtencion.Reconfirmacion:
                <section class="tarjeta superficie">
                    <p id="saludo">Hola, <strong>@Maquina.NombreVisible</strong></p>
                    <p id="aviso" class="aviso" role="status">@Maquina.Aviso</p>
                    <p id="vigente">Valor vigente: <strong>@Maquina.Vigente?.Nombre</strong>@if (Maquina.Vigente is { } vigente && CargoVisible(vigente) is { Length: > 0 } cargoVigente)
                    {
                        @* El separador y el cargo, sólo si hay cargo (D2) y el precio no está oculto (D4 de personalizar-opciones). *@
                        <text> · </text><span id="cargo-vigente">@cargoVigente</span>
                    }</p>
                    <div class="acciones">
                        <button id="volver" type="button" @onclick="Maquina.Volver">Volver</button>
                        <button id="reconfirmar" type="button" class="principal" @onclick="Reconfirmar">Reconfirmar</button>
                    </div>
                </section>
                break;

            case EstadoAtencion.SinOpciones:
                @* Ninguna opción disponible: el aviso, lo usado o el motivo, y «Listo» (D4); sin opciones ni «Confirmar». *@
                <section class="tarjeta superficie">
                    <p id="mensaje" class="mensaje" role="status">@MensajesAtencion.SinOpciones</p>
                    @if (Maquina.UsoDelDia is { } usado)
                    {
                        <p id="uso-del-dia" class="aviso">@usado</p>
                    }
                    else if (Maquina.MotivoSinOpciones is { } motivo)
                    {
                        <p id="motivo-sin-opciones" class="aviso">@motivo</p>
                    }
                    <div class="acciones">
                        <button id="listo" type="button" class="principal" @onclick="Maquina.Listo">Listo</button>
                    </div>
                </section>
                break;

            case EstadoAtencion.Resultado:
                <section class="tarjeta superficie">
                    <p id="mensaje" class="mensaje" role="status">@Maquina.Mensaje</p>
                    @if (Maquina.ComprobanteEnPantalla is { } papel)
                    {
                        @* Con la impresora simulada, el comprobante sale de una impresora en pantalla; tocarlo es «Listo» (D7). *@
                        <div class="impresora">
                            <div class="boca" aria-hidden="true"></div>
                            <button id="listo" type="button" class="comprobante" aria-label="Retirar el comprobante" @onclick="Maquina.Listo">
                                <span class="encabezado-comprobante">@_textos.Encabezado</span>
                                <span class="leyenda">@papel.Leyenda · N.º @papel.Numero</span>
                                <span class="opcion-comprobante">@papel.Opcion</span>
                                <span>Fecha: @papel.FechaNegocio</span>
                                @if (papel.Cargo.Length > 0)
                                {
                                    <span>Cargo informado: @papel.Cargo</span>
                                }
                                @if (_textos.Pie.Length > 0)
                                {
                                    <span class="pie-comprobante">@_textos.Pie</span>
                                }
                                <span class="retirar">@MensajesAtencion.TocaParaRetirar</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="acciones">
                            <button id="listo" type="button" class="principal" @onclick="Maquina.Listo">Listo</button>
                        </div>
                    }
                </section>
                break;

        }
    </main>

    <footer class="pie" inert="@(HayDialogo || CartelVisible)">
        <FranjaSincronizacion Estado="Servicio.Sincronizacion" />
        <div class="pie-derecha">
            <img class="marca-intelektron" src="img/intelektron.svg" alt="Intelektron" />
            @* El engranaje va en el borde, al lado de la marca, y sólo en reposo; durante la atención su lugar queda reservado (D1, D2 y D5). *@
            @if (Maquina.Estado == EstadoAtencion.Reposo)
            {
                <button type="button" class="engranaje" aria-label="Configuración" @onclick="AbrirConfiguracion"><span aria-hidden="true">&#9881;</span></button>
            }
            else
            {
                <span class="lugar-engranaje"></span>
            }
        </div>
    </footer>

    @* Configuración sólo se abre en reposo, y no cambia el estado de la máquina (D5). *@
    @if (ConfiguracionAbierta)
    {
        <PanelConfiguracion Estilo="_vista" Impresora="@(Servicio.Impresora as ImpresoraSimulada)"
                            Bitacoras="_estadoBitacoras" Zona="ZonaDelPuesto" ModoImpresoraCambiado="RegistrarModoImpresora"
                            Administracion="Servicio.Administracion"
                            VistaPrevia="estilo => _vista = estilo" GuardarEstilo="GuardarConfiguracion" Cancelar="CancelarConfiguracion"
                            Modo="_modo" AvisoModo="@_avisoModo" PasarAOperativo="PasarAOperativo" PasarAMantenimiento="PasarAMantenimiento"
                            Simulacion="SimulacionActiva" CambiarSimulacion="CambiarSimulacion" AvisoSimulacion="@_avisoSimulacion"
                            PuedeCerrar="@(_cierre is not null)" CerrarPuesto="@(() => SolicitarCierre("CLOSE_BUTTON"))"
                            Inerte="@(_pedidoClave is not null)" SesionOperador="_sesionOperador"
                            Operador="@_operador" Actor="_actor" ClaveSinValidar="@(_acceso == AccesoClave)"
                            Consumos="Servicio.Consumos" RegistrarConsulta="RegistrarConsultaDeConsumos"
                            AlmacenExportacion="_almacenExportacion" ElectorCarpeta="_electorCarpeta" RegistrarExportacion="RegistrarExportacionDeConsumos"
                            RegistrarExportacionPersonas="RegistrarExportacionDePersonas"
                            ElectorArchivo="_electorArchivo" RegistrarImportacionPersonas="RegistrarImportacionDePersonas"
                            PresentacionOpciones="_presentacionOpciones" RegistrarPresentacion="RegistrarPresentacionDeOpcion"
                            RegistrarImportacionRechazada="RegistrarImportacionRechazada"
                            Textos="_textos" ImprimirPrueba="ImprimirPrueba" GuardarTextos="GuardarTextos"
                            AvisoMonitor="@_pantallaDelPuesto?.Aviso" GuardarMonitor="GuardarMonitor" MonitorGuardadoId="@_almacenPantalla?.Leer().Guardada?.Id"
                            Logos="@(_logosLocales is null ? null : _logos)" GuardarLogo="GuardarLogo"
                            AplicarRed="AplicarRed" DireccionReceptor="@_pruebaConexion?.Direccion"
                            TieneCertificados="@(_pruebaConexion?.TieneCertificados == true)" ProbarConexion="ProbarConexion" />
    }

    @* La clave del día, cuando el modo la pide para abrir Configuración, cerrar el puesto o pasar a operativo (D6). *@
    @if (_pedidoClave is { } pedido)
    {
        <DialogoClaveDelDia Validador="_validador" Fecha="FechaLocal" Motivo="@MotivoClave(pedido)" Resultado="ResultadoClave"
                            Cancelada="() => _pedidoClave = null" ProbarCodigo="ProbarCodigo" />
    }
</div>

@code {
    private string _codigo = string.Empty;
    private Timer? _temporizador;
    private Logos _logos = new(LogosLocales.EmpresaDeEjemplo, LogosLocales.ConcesionariaDeEjemplo);
    private LogosLocales? _logosLocales;
    private AlmacenEstiloVisual? _almacenEstilo;
    private EstiloVisual _guardado = EstiloVisual.PorDefecto;
    private EstiloVisual _vista = EstiloVisual.PorDefecto;
    private bool _configuracion;
    private IReadOnlyList<EstadoBitacora>? _estadoBitacoras;
    private ElementReference _raiz;
    private ElementReference _confirmarCartel;

    /// <summary>El cartel de la elección, estado de la pantalla y no de la máquina (D1 de confirmar-eleccion-en-cartel).</summary>
    private bool _cartelAbierto;

    /// <summary>Al abrirse el cartel, el foco va a «Confirmar» en el próximo dibujado (D3).</summary>
    private bool _enfocarConfirmar;
    private EstadoAtencion? _estadoDibujado;
    private AlmacenModoPuesto? _almacenModo;
    private ModoPuesto _modo = ModoPuesto.Mantenimiento;
    private string? _avisoModo;
    private AlmacenSimulacion? _almacenSimulacion;
    private AlmacenExportacion? _almacenExportacion;
    private IElectorCarpeta? _electorCarpeta;
    private IElectorArchivo? _electorArchivo;
    private AlmacenPresentacionOpciones? _presentacionOpciones;
    private bool _simulacionGuardada;
    private string? _avisoSimulacion;
    private IReadOnlyList<EntradaSimulacion> _personasSimulacion = [];
    private IReadOnlyList<EntradaLista> _entradasSimulacion = [];
    private int _eleccionesSimulacion;
    private CierrePuesto? _cierre;
    private SesionOperador? _sesionOperador;
    private AlmacenImpresora? _almacenImpresora;
    private TextosComprobante _textos = TextosComprobante.PorDefecto;
    private AlmacenPantalla? _almacenPantalla;
    private PantallaDelPuesto? _pantallaDelPuesto;
    private EjecutorNetsh? _ejecutorNetsh;
    private PruebaConexion? _pruebaConexion;
    private IValidadorClaveDelDia _validador = new ClaveDelDiaDeDesarrollo();
    private AccionClave? _pedidoClave;
    private string _fuenteCierre = "ESCAPE";
    private string _acceso = AccesoMantenimiento;

    /// <summary>
    /// El operador que entró a Configuración con su código: su persona, actor de lo que se registre mientras está abierta, su
    /// nombre visible y su sesión privilegiada; null con la clave del día (D5 a D7 de entrar-a-configuracion-con-teclado).
    /// </summary>
    private Guid? _actor;
    private string? _operador;
    private Guid? _sesionDelOperador;

    /// <summary>Para qué se pidió la clave del día; su código va a DAILY_KEY_ACCEPTED o DAILY_KEY_REJECTED (D17).</summary>
    private enum AccionClave
    {
        AbrirConfiguracion,
        CerrarPuesto,
        ActivarOperativo,
    }

    private const string AccesoMantenimiento = "MAINTENANCE_MODE";
    private const string AccesoClave = "DAILY_KEY";
    private const string AccesoOperador = "OPERATOR";

    /// <summary>Con un operador no hay General: el modo, la simulación y el cierre vuelven sin hacer nada (D6).</summary>
    private bool EsOperador => _actor is not null;

    /// <summary>
    /// La simulación activa: guardada encendida y en mantenimiento (D5 de simular-identificacion-por-lista). No depende sólo
    /// del archivo: un puesto operativo nunca muestra la lista, aunque lo guardado diga lo contrario, y el operativo no
    /// cambia lo guardado: al volver a mantenimiento está como se la dejó (D12).
    /// </summary>
    private bool SimulacionActiva => _simulacionGuardada && _modo == ModoPuesto.Mantenimiento;

    private static readonly TimeZoneInfo ZonaDelPuesto = TimeZoneInfo.FindSystemTimeZoneById("America/Argentina/Buenos_Aires");

    private bool ConfiguracionAbierta => _configuracion && Maquina.Estado == EstadoAtencion.Reposo;

    /// <summary>
    /// El cartel se ve sólo abierto, con una opción elegida y en la selección o confirmando (D1): «Volver» de la
    /// reconfirmación, un rechazo o el resultado no lo dejan abierto.
    /// </summary>
    private bool CartelVisible => _cartelAbierto && Maquina.Elegida is not null
        && Maquina.Estado is EstadoAtencion.Seleccion or EstadoAtencion.Confirmando;

    /// <summary>Con Configuración o la clave del día a la vista, el resto de la página es inerte.</summary>
    private bool HayDialogo => ConfiguracionAbierta || _pedidoClave is not null;

    private DateOnly FechaLocal => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Servicio.Reloj.GetUtcNow(), ZonaDelPuesto).DateTime);

    /// <summary>Cinco filas con dos columnas; con una, tantas como opciones (D1).</summary>
    private string Filas => Maquina.ColumnasPagina == 2 ? "5" : Maquina.PaginaActual.Count.ToString();

    protected override void OnInitialized()
    {
        Servicio.SincronizacionCambiada += RefrescarSincronizacion;
        // Sin carpeta de logos registrada (las pruebas que no la usan), quedan los de ejemplo (D4).
        if (Proveedor.GetService(typeof(LogosLocales)) is LogosLocales logos)
        {
            _logosLocales = logos;
            _logos = logos.Leer();
        }

        // Sin almacén registrado, el estilo por defecto y «Guardar» sólo dura la sesión (D5).
        _almacenEstilo = Proveedor.GetService(typeof(AlmacenEstiloVisual)) as AlmacenEstiloVisual;
        _guardado = _vista = _almacenEstilo?.Leer() ?? EstiloVisual.PorDefecto;

        // Sin almacén del modo registrado (las pruebas que no lo usan), mantenimiento en memoria, como el estilo (D5).
        _almacenModo = Proveedor.GetService(typeof(AlmacenModoPuesto)) as AlmacenModoPuesto;
        _modo = _almacenModo?.Leer() ?? ModoPuesto.Mantenimiento;

        // Sin almacén de la simulación registrado (las pruebas que no lo usan), apagada y en memoria, como el modo (D4).
        _almacenSimulacion = Proveedor.GetService(typeof(AlmacenSimulacion)) as AlmacenSimulacion;
        _simulacionGuardada = _almacenSimulacion?.Leer() ?? false;
        if (Proveedor.GetService(typeof(IValidadorClaveDelDia)) is IValidadorClaveDelDia validador)
        {
            _validador = validador;
        }

        // Sin almacén de la impresora registrado, los textos por defecto; la simulada los usa desde el próximo comprobante (D13).
        _almacenImpresora = Proveedor.GetService(typeof(AlmacenImpresora)) as AlmacenImpresora;
        _textos = _almacenImpresora?.Leer() ?? TextosComprobante.PorDefecto;
        if (Servicio.Impresora is ImpresoraSimulada simulada)
        {
            simulada.Textos = _textos;
        }

        _almacenPantalla = Proveedor.GetService(typeof(AlmacenPantalla)) as AlmacenPantalla;
        _pantallaDelPuesto = Proveedor.GetService(typeof(PantallaDelPuesto)) as PantallaDelPuesto;
        _cierre = Proveedor.GetService(typeof(CierrePuesto)) as CierrePuesto;
        _ejecutorNetsh = Proveedor.GetService(typeof(EjecutorNetsh)) as EjecutorNetsh;
        _pruebaConexion = Proveedor.GetService(typeof(PruebaConexion)) as PruebaConexion;
        // Sin almacén de la exportación o sin elector (las pruebas que no los usan), Consumos no exporta (D6 de buscar-y-exportar-consumos).
        _almacenExportacion = Proveedor.GetService(typeof(AlmacenExportacion)) as AlmacenExportacion;
        _electorCarpeta = Proveedor.GetService(typeof(IElectorCarpeta)) as IElectorCarpeta;
        // Sin elector de archivos, Personas no importa (D7 de importar-personas-desde-excel).
        _electorArchivo = Proveedor.GetService(typeof(IElectorArchivo)) as IElectorArchivo;
        // Sin almacén de la presentación, las opciones se ven como siempre y no se personalizan (D3 de personalizar-opciones).
        _presentacionOpciones = Proveedor.GetService(typeof(AlmacenPresentacionOpciones)) as AlmacenPresentacionOpciones;
        if (_cierre is not null)
        {
            _cierre.RequiereClave = _modo == ModoPuesto.Operativo;
            _cierre.ClavePedida += PedirClaveDeLaVentana;
        }

        Maquina.Iniciar();
        LeerPersonasSimulacion();
        _temporizador = new Timer(_ => _ = InvokeAsync(Revisar), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Revisar()
    {
        if (Maquina.RevisarInactividad())
        {
            CancelarConfiguracionFueraDeReposo();
            StateHasChanged();
        }
        else if (ConfiguracionAbierta && _sesionOperador?.RevisarInactividad() == true)
        {
            // Treinta segundos sin un toque en Consumos cierran la sesión del operador o descartan la acción que esperaba un
            // código (D8 de configurar-puesto-por-pestanas y D5 de buscar-y-exportar-consumos).
            StateHasChanged();
        }
    }

    /// <summary>El campo queda vacío apenas se envía: el código no se vuelve a mostrar.</summary>
    private void Ingresar()
    {
        var codigo = _codigo;
        _codigo = string.Empty;
        Maquina.Identificar(codigo);
        CancelarConfiguracionFueraDeReposo();
    }

    /// <summary>
    /// Una persona elegida en el combo del modo simulación (D9): identifica por su credencial, con las guardas del código
    /// tipeado. El valor llega del DOM (OWASP): sólo un GUID llega a la identificación, y una credencial que no está en la
    /// versión activa la rechaza la identificación (D2). Cada elección vuelve a crear el combo en la opción vacía.
    /// </summary>
    private void ElegirEnSimulacion(string valor)
    {
        _eleccionesSimulacion++;
        if (!SimulacionActiva || !Guid.TryParseExact(valor, "D", out var credencial))
        {
            return;
        }

        Maquina.IdentificarPorCredencial(credencial);
        CancelarConfiguracionFueraDeReposo();
    }

    /// <summary>
    /// La lista del combo, leída sólo al quedar en reposo, al encender la simulación y al cerrar Configuración, no en cada
    /// dibujado: el temporizador redibuja cada segundo (D10). Sin la simulación activa o sin base, queda vacía.
    /// </summary>
    private void LeerPersonasSimulacion()
    {
        if (!SimulacionActiva || Maquina.Estado == EstadoAtencion.ErrorAlmacenamiento)
        {
            _personasSimulacion = [];
        }
        else
        {
            try
            {
                _personasSimulacion = Servicio.Identificacion.ListarParaSimulacion();
            }
            catch (Microsoft.Data.Sqlite.SqliteException)
            {
                // Sin la lista, el combo queda sólo con la opción vacía; la atención muestra el error en su próxima escritura.
                _personasSimulacion = [];
            }
        }

        // Las filas de la lista propia: la credencial como valor, nunca el código, y el nombre visible (D3 de ordenar-configuracion).
        _entradasSimulacion = _personasSimulacion.Select(p => new EntradaLista(p.CredencialId.ToString("D"), p.NombreVisible)).ToList();
    }

    /// <summary>
    /// Enter en el campo envía lo tipeado, como «Ingresar» (D8 de simular-identificacion-por-lista): el campo ya se
    /// actualizó con cada tecla, y sin un form no hay un segundo envío.
    /// </summary>
    private void TeclaCodigo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Ingresar();
        }
    }

    /// <summary>
    /// Si se sale de reposo con Configuración abierta (el resto de la página es inerte, pero por si acaso), se cancela
    /// como con «Cancelar»: la vista previa sin guardar no queda aplicada ni el panel reaparece al volver a reposo.
    /// </summary>
    private void CancelarConfiguracionFueraDeReposo()
    {
        if (_configuracion && Maquina.Estado != EstadoAtencion.Reposo)
        {
            CancelarConfiguracion();
        }
    }

    private async Task Confirmar()
    {
        await Maquina.ConfirmarAsync();
        // Si vuelve a la selección con un aviso (la opción ya no está), el cartel no la tapa (D1).
        if (Maquina.Estado != EstadoAtencion.Confirmando)
        {
            _cartelAbierto = false;
        }
    }

    /// <summary>Tocar una opción la marca, como antes, y abre el cartel con ella (D1 de confirmar-eleccion-en-cartel).</summary>
    private void ElegirOpcion(Guid opcionId)
    {
        Maquina.Elegir(opcionId);
        if (Maquina.Estado == EstadoAtencion.Seleccion && Maquina.Elegida?.Id == opcionId)
        {
            _cartelAbierto = true;
            _enfocarConfirmar = true;
        }
    }

    /// <summary>«Elegir otra» y Escape: cierran el cartel con la misma persona y la marca; mientras confirma, nada (D3).</summary>
    private void ElegirOtra()
    {
        if (Maquina.Estado == EstadoAtencion.Seleccion)
        {
            _cartelAbierto = false;
        }
    }

    /// <summary>
    /// El engranaje pide la clave del día o el código de un operador en los dos modos (D1 de entrar-a-configuracion-con-teclado).
    /// Cerrar con Escape en mantenimiento sigue directo.
    /// </summary>
    private void AbrirConfiguracion()
    {
        if (Maquina.Estado != EstadoAtencion.Reposo)
        {
            return;
        }

        // El estado de las bitácoras es el de este toque, antes de registrar la clave o el operador y la apertura.
        _estadoBitacoras = LeerEstadoBitacoras();
        _pedidoClave = AccionClave.AbrirConfiguracion;
    }

    /// <summary>
    /// Lo tipeado en el diálogo, antes de tomarlo como clave del día (D5): si no es un código del snapshot activo, null, y es la
    /// clave. Un código abre Configuración como operador si Asistencia lo concede (RB25, RB26), y para cerrar o pasar a operativo
    /// se rechaza sin llamarla, con DAILY_KEY_REJECTED y PERSON_CODE. Ningún registro lleva lo tipeado.
    /// </summary>
    private DialogoClaveDelDia.ResultadoCodigo? ProbarCodigo(string valor)
    {
        if (_pedidoClave is not { } accion)
        {
            return null;
        }

        ResultadoAsistencia resultado;
        try
        {
            if (!Servicio.Identificacion.EsCodigoConocido(valor))
            {
                return null;
            }

            if (accion != AccionClave.AbrirConfiguracion)
            {
                RegistrarConfiguracion("DAILY_KEY_REJECTED", new
                {
                    Action = CodigoDe(accion), Cause = "PERSON_CODE", ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion,
                }, SeveridadBitacora.Warning);
                return new(MensajesAtencion.CodigoNoEsClave);
            }

            resultado = Servicio.Asistencia.Entrar(valor);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            return new(MensajesAtencion.ErrorAlmacenamiento);
        }

        if (!resultado.Concedida)
        {
            return new(MensajesAtencion.DeMotivo(resultado.ReasonCode));
        }

        _pedidoClave = null;
        _actor = resultado.PersonId;
        _operador = resultado.NombreVisible;
        _sesionDelOperador = resultado.SesionId;
        if (Maquina.Estado == EstadoAtencion.Reposo)
        {
            AbrirConfiguracionCon(AccesoOperador);
            // Consumos usa la sesión de este operador para reimprimir, sin pedirle el código otra vez (D5 de buscar-y-exportar-consumos).
            _sesionOperador?.Adoptar(resultado.SesionId!.Value, resultado.NombreVisible ?? string.Empty);
        }
        else
        {
            SalirDelOperador();
        }

        StateHasChanged();
        return new(null);
    }

    /// <summary>Termina la sesión privilegiada del operador de Configuración y olvida su acceso.</summary>
    private void SalirDelOperador()
    {
        if (_sesionDelOperador is { } sesion)
        {
            try
            {
                Servicio.Asistencia.Salir(sesion, "CONFIGURATION_CLOSED");
            }
            catch (Microsoft.Data.Sqlite.SqliteException)
            {
                // La sesión vence sola a los dos minutos; cerrar Configuración no depende de la base.
            }
        }

        _actor = null;
        _operador = null;
        _sesionDelOperador = null;
    }

    private void AbrirConfiguracionCon(string acceso)
    {
        _vista = _guardado;
        _acceso = acceso;
        _avisoModo = null;
        _avisoSimulacion = null;
        // El estado se leyó al tocar el engranaje (AbrirConfiguracion): muestra lo que había entonces, sin la clave ni la apertura.
        RegistrarConfiguracion("CONFIGURATION_OPENED", new { Access = _acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        _sesionOperador = Servicio.Asistencia is { } asistencia ? new SesionOperador(asistencia, Servicio.Reloj) : null;
        _configuracion = true;
    }

    /// <summary>
    /// Escape en reposo, sin diálogos, pide el cierre del puesto; durante una atención no hace nada (acceso-puesto). Los
    /// diálogos no dejan pasar la tecla hasta acá.
    /// </summary>
    private void TeclaRaiz(KeyboardEventArgs e)
    {
        // Con el cartel de la elección abierto, Escape es «Elegir otra» (D3 de confirmar-eleccion-en-cartel).
        if (e.Key == "Escape" && CartelVisible)
        {
            ElegirOtra();
            return;
        }

        if (e.Key == "Escape" && Maquina.Estado == EstadoAtencion.Reposo && !HayDialogo)
        {
            SolicitarCierre("ESCAPE");
        }
    }

    /// <summary>El cierre ordenado: directo en mantenimiento y, en operativo, después de la clave del día (D7).</summary>
    private void SolicitarCierre(string fuente)
    {
        // El cierre desde General no existe para un operador; si un evento llegara igual, no hace nada (D6).
        if (_cierre is null || (EsOperador && _configuracion))
        {
            return;
        }

        if (_modo == ModoPuesto.Operativo)
        {
            _fuenteCierre = fuente;
            _pedidoClave = AccionClave.CerrarPuesto;
            return;
        }

        Cerrar(fuente, AccesoMantenimiento);
    }

    private void Cerrar(string fuente, string acceso)
    {
        RegistrarConfiguracion("KIOSK_CLOSE_REQUESTED", new { Source = fuente, Access = acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        _cierre?.Cerrar();
    }

    /// <summary>La ventana pidió cerrarse en operativo sin la clave: se la pide la pantalla, desde su hilo (D7).</summary>
    private void PedirClaveDeLaVentana() => _ = InvokeAsync(() =>
    {
        _fuenteCierre = "WINDOW_CLOSE";
        _pedidoClave = AccionClave.CerrarPuesto;
        StateHasChanged();
    });

    private static string MotivoClave(AccionClave accion) => accion switch
    {
        AccionClave.AbrirConfiguracion => MensajesAtencion.ClaveParaAbrir,
        AccionClave.CerrarPuesto => MensajesAtencion.ClaveParaCerrar,
        _ => MensajesAtencion.ClaveParaOperativo,
    };

    private static string CodigoDe(AccionClave accion) => accion switch
    {
        AccionClave.AbrirConfiguracion => "OPEN_CONFIGURATION",
        AccionClave.CerrarPuesto => "CLOSE_KIOSK",
        _ => "ACTIVATE_OPERATIVE",
    };

    /// <summary>Cada «Aceptar» de la clave queda en la general con su acción, nunca con lo tipeado (D17).</summary>
    private void ResultadoClave(bool valida)
    {
        if (_pedidoClave is not { } accion)
        {
            return;
        }

        if (!valida)
        {
            RegistrarConfiguracion("DAILY_KEY_REJECTED", new
            {
                Action = CodigoDe(accion), Cause = "INVALID_FORMAT", ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion,
            }, SeveridadBitacora.Warning);
            return;
        }

        RegistrarConfiguracion("DAILY_KEY_ACCEPTED", new { Action = CodigoDe(accion), ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        _pedidoClave = null;
        switch (accion)
        {
            case AccionClave.AbrirConfiguracion:
                if (Maquina.Estado == EstadoAtencion.Reposo)
                {
                    // Con la clave del día no hay operador: actor nulo con NO_AUTHENTICATION (D7).
                    SalirDelOperador();
                    AbrirConfiguracionCon(AccesoClave);
                }

                break;
            case AccionClave.CerrarPuesto:
                Cerrar(_fuenteCierre, AccesoClave);
                break;
            default:
                CambiarModo(ModoPuesto.Operativo, AccesoClave);
                break;
        }
    }

    private void PasarAOperativo()
    {
        if (!EsOperador)
        {
            _pedidoClave = AccionClave.ActivarOperativo;
        }
    }

    /// <summary>Volver a mantenimiento no pide la clave otra vez: ya se entró con ella (acceso-puesto).</summary>
    private void PasarAMantenimiento() => CambiarModo(ModoPuesto.Mantenimiento, _acceso);

    private void CambiarModo(ModoPuesto nuevo, string acceso)
    {
        if (EsOperador)
        {
            return;
        }

        var antes = _modo;
        var resultado = "APPLIED";
        try
        {
            _almacenModo?.Guardar(nuevo);
            _modo = nuevo;
            _avisoModo = null;
            if (_cierre is not null)
            {
                _cierre.RequiereClave = _modo == ModoPuesto.Operativo;
            }
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            resultado = "FAILED";
            _avisoModo = MensajesAtencion.ModoNoGuardado;
        }

        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "KIOSK_MODE",
            Before = CodigoDe(antes),
            After = CodigoDe(nuevo),
            Result = resultado,
            Effective = CodigoDe(_modo),
            Access = acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });
    }

    /// <summary>El interruptor de General: sólo en mantenimiento, y con el acceso con que se entró a Configuración (D6).</summary>
    private void CambiarSimulacion(bool encendida)
    {
        if (_modo == ModoPuesto.Mantenimiento && !EsOperador)
        {
            GuardarSimulacion(encendida, _acceso);
            LeerPersonasSimulacion();
        }
    }

    /// <summary>
    /// Guarda el modo simulación y lo registra en la general con el antes, el después, el resultado, lo vigente y el acceso,
    /// nunca con un código ni un nombre (D7). Si no se puede guardar, sigue como estaba y General lo avisa.
    /// </summary>
    private void GuardarSimulacion(bool encendida, string acceso)
    {
        var antes = _simulacionGuardada;
        var resultado = "APPLIED";
        try
        {
            _almacenSimulacion?.Guardar(encendida);
            _simulacionGuardada = encendida;
            _avisoSimulacion = null;
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            resultado = "FAILED";
            _avisoSimulacion = MensajesAtencion.SimulacionNoGuardada;
        }

        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "SIMULATION_MODE",
            Before = EncendidaOApagada(antes),
            After = EncendidaOApagada(encendida),
            Result = resultado,
            Effective = EncendidaOApagada(SimulacionActiva),
            Access = acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });
    }

    private static string EncendidaOApagada(bool encendida) => encendida ? "ON" : "OFF";

