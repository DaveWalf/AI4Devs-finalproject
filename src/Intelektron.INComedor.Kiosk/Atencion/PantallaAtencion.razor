    /// <summary>
    /// «Imprimir una prueba»: directo a la impresora, con la leyenda PRUEBA y sin persona ni importe; no pasa por la base, así
    /// que no crea intención, consumo, comprobante, trabajo ni evento de salida, y su TicketId nuevo nunca es el de una
    /// atención (D13). Queda en la general con su resultado.
    /// </summary>
    private string ImprimirPrueba()
    {
        var ahora = TimeZoneInfo.ConvertTime(Servicio.Reloj.GetUtcNow(), ZonaDelPuesto);
        var prueba = new ComprobanteAImprimir(Guid.NewGuid(), Guid.NewGuid(), 0,
            $"Prueba de impresión · {ahora.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)}", "PRUEBA");
        RespuestaImpresora respuesta;
        try
        {
            respuesta = Servicio.Impresora.Enviar(prueba);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            respuesta = RespuestaImpresora.Incierto();
        }

        var (resultado, mensaje) = respuesta.Envio switch
        {
            RespuestaEnvio.Enviado => ("PRINTED", MensajesAtencion.PruebaSalio),
            RespuestaEnvio.Fallido => ("FAILED", respuesta.CodigoError == "PAPER_OUT" ? MensajesAtencion.PruebaSinPapel : MensajesAtencion.PruebaFallo),
            _ => ("UNCERTAIN", MensajesAtencion.PruebaIncierta),
        };
        RegistrarConfiguracion("PRINTER_TESTED", new
        {
            Result = resultado, ErrorCode = respuesta.CodigoError, Access = _acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion,
        });
        return mensaje;
    }

    /// <summary>
    /// Los textos del comprobante: validados antes de escribir, en impresora.json y, con la simulada, desde el próximo que sale.
    /// Cada guardado queda en la general con el antes, el después y el resultado (D13 y D17).
    /// </summary>
    private ResultadoTextos GuardarTextos(string encabezado, string pie)
    {
        var antes = _textos;
        var campos = TextosComprobante.Validar(encabezado, pie);
        if (campos.Count > 0)
        {
            RegistrarCambioDeTextos(antes, null, "REJECTED", campos);
            return new ResultadoTextos(false, campos, MensajesAtencion.PanelInvalido);
        }

        var nuevos = new TextosComprobante(encabezado, pie);
        try
        {
            _almacenImpresora?.Guardar(nuevos);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            RegistrarCambioDeTextos(antes, nuevos, "FAILED", []);
            return new ResultadoTextos(false, [], MensajesAtencion.TextosNoGuardados);
        }

        _textos = nuevos;
        if (Servicio.Impresora is ImpresoraSimulada simulada)
        {
            simulada.Textos = nuevos;
        }

        RegistrarCambioDeTextos(antes, nuevos, "APPLIED", []);
        return new ResultadoTextos(true, [], null);
    }

    private void RegistrarCambioDeTextos(TextosComprobante antes, TextosComprobante? despues, string resultado, IReadOnlyList<string> campos) =>
        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "TICKET_TEXTS",
            Before = new { Header = antes.Encabezado, Footer = antes.Pie },
            After = despues is null ? null : new { Header = despues.Encabezado, Footer = despues.Pie },
            Result = resultado,
            Fields = campos,
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });

    /// <summary>
    /// El monitor del puesto: en pantalla.json y, con la ventana, a pantalla completa en él (D10). Queda en la general con el de
    /// antes y el de después, el resultado y cómo se entró.
    /// </summary>
    private bool GuardarMonitor(MonitorDelPuesto monitor)
    {
        var antes = _almacenPantalla?.Leer().Guardada;
        var resultado = "APPLIED";
        try
        {
            _almacenPantalla?.Guardar(monitor);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            resultado = "FAILED";
        }

        if (resultado == "APPLIED")
        {
            _pantallaDelPuesto?.Mover(monitor);
            if (_pantallaDelPuesto is not null)
            {
                _pantallaDelPuesto.Aviso = null;
            }
        }

        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "DISPLAY_MONITOR",
            Before = antes is null ? null : new { Device = antes.Dispositivo },
            After = new { Device = monitor.Dispositivo, Width = monitor.Area.Ancho, Height = monitor.Area.Alto, Primary = monitor.Principal },
            Result = resultado,
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });
        return resultado == "APPLIED";
    }

    /// <summary>
    /// Un logo en marcas\ de la carpeta de datos, o el de ejemplo con null (D14); la cabecera lo muestra en el acto. Queda en
    /// la general por su huella SHA-256, su tamaño y su formato, nunca por su contenido.
    /// </summary>
    private bool GuardarLogo(LogoPuesto logo, LogoElegido? elegido)
    {
        if (_logosLocales is not { } logos)
        {
            return false;
        }

        var antes = logos.Actual(logo);
        var resultado = "APPLIED";
        try
        {
            if (elegido is null)
            {
                logos.VolverAlDeEjemplo(logo);
            }
            else
            {
                logos.Guardar(logo, elegido);
            }
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            resultado = "FAILED";
        }

        _logos = logos.Leer();
        // El guardado corre en el panel: la cabecera de esta pantalla se redibuja con el logo nuevo.
        StateHasChanged();
        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = logo == LogoPuesto.Empresa ? "COMPANY_LOGO" : "CONCESSIONAIRE_LOGO",
            Before = Huella(antes),
            After = Huella(elegido),
            Result = resultado,
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });
        return resultado == "APPLIED";
    }

    private static object Huella(LogoElegido? logo) => logo is null
        ? new { Example = true }
        : new { Example = false, logo.Sha256, Size = logo.Contenido.Length, Format = logo.Formato };

    /// <summary>
    /// La IPv4 de un adaptador con netsh, un comando por paso y cada uno con su permiso de administrador (D11); cada aplicación
    /// queda en la general con el adaptador, antes y después y el resultado. Sin el ejecutor, que sólo registra la ventana,
    /// null: no corre nada ni registra nada, como en las pruebas.
    /// </summary>
    private async Task<ResultadoRed?> AplicarRed(AdaptadorRed adaptador, IPv4Validada pedida)
    {
        if (_ejecutorNetsh is not { } ejecutor)
        {
            return null;
        }

        var resultado = await ResultadoRed.AplicarAsync(ArgumentosNetsh.Armar(adaptador.Indice, pedida),
            comando => ejecutor.EjecutarAsync(comando, CancellationToken.None));
        RegistrarConfiguracion("CONFIGURATION_CHANGED", resultado.Registro(adaptador, pedida, _acceso),
            resultado.Estado == EstadoRed.Aplicada ? SeveridadBitacora.Info : SeveridadBitacora.Warning);
        return resultado;
    }

    /// <summary>La prueba de conexión con el receptor (D12), en la general con la dirección y las etapas; sin certificados, nada.</summary>
    private async Task<ResultadoConexion?> ProbarConexion()
    {
        if (_pruebaConexion is not { TieneCertificados: true } prueba)
        {
            return null;
        }

        var resultado = await prueba.ProbarAsync(CancellationToken.None);
        RegistrarConfiguracion("CONNECTIVITY_TESTED", resultado.Registro(_acceso),
            resultado.Funciono ? SeveridadBitacora.Info : SeveridadBitacora.Warning);
        return resultado;
    }

    private static string CodigoDe(ModoPuesto modo) => modo == ModoPuesto.Operativo ? "OPERATIVE" : "MAINTENANCE";

    /// <summary>
    /// Sin escritura en la carpeta de datos, el estilo guardado queda como estaba y el diálogo lo avisa: la atención sigue
    /// («Estilo por defecto y validado»). Configuración queda abierta (D3 de configurar-puesto-por-pestanas). Cada guardado
    /// queda en la bitácora con el antes, el después y lo vigente (D9 de escribir-bitacoras-externas).
    /// </summary>
    private bool GuardarConfiguracion()
    {
        var antes = _guardado;
        try
        {
            _almacenEstilo?.Guardar(_vista);
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            RegistrarCambioDeEstilo(antes, _vista, "FAILED", vigente: antes);
            return false;
        }

        _guardado = _vista;
        RegistrarCambioDeEstilo(antes, _guardado, "APPLIED", vigente: _guardado);
        return true;
    }

    private void CancelarConfiguracion()
    {
        // Cerrar Configuración termina la sesión del operador de Consumos (D8); la adoptada la cierra SalirDelOperador, una vez.
        _sesionOperador?.Salir("CONFIGURATION_CLOSED");
        _sesionOperador = null;
        _vista = _guardado;
        _configuracion = false;
        RegistrarConfiguracion("CONFIGURATION_CANCELLED", new { Access = _acceso, ActorPersonId = (Guid?)null, ActorReason = SinAutenticacion });
        SalirDelOperador();
        // Personas se edita en Configuración: al cerrarla, el combo lee la versión activa (D10 de simular-identificacion-por-lista).
        LeerPersonasSimulacion();
    }

    /// <summary>Sin clave, Configuración no tiene actor: va nulo con este motivo, sin inventar a nadie (D9).</summary>
    private const string SinAutenticacion = "NO_AUTHENTICATION";

    private void RegistrarCambioDeEstilo(EstiloVisual antes, EstiloVisual despues, string resultado, EstiloVisual vigente) =>
        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "VISUAL_STYLE",
            Before = new { Opacity = antes.Opacidad, Blur = antes.Desenfoque },
            After = new { Opacity = despues.Opacidad, Blur = despues.Desenfoque },
            Result = resultado,
            Effective = new { Opacity = vigente.Opacidad, Blur = vigente.Desenfoque },
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });

    private void RegistrarModoImpresora(CambioModoImpresora cambio) =>
        RegistrarConfiguracion("CONFIGURATION_CHANGED", new
        {
            Setting = "PRINTER_SIMULATION_MODE",
            Before = CodigoDe(cambio.Antes),
            After = CodigoDe(cambio.Despues),
            Result = "APPLIED",
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });

    private static string CodigoDe(ModoImpresoraSimulada modo) => modo switch
    {
        ModoImpresoraSimulada.Disponible => "AVAILABLE",
        ModoImpresoraSimulada.SinPapel => "PAPER_OUT",
        _ => "UNCERTAIN",
    };

    /// <summary>
    /// Configuración sigue aunque SQLite no registre: el ajuste es local y la atención muestra el error de almacenamiento en
    /// su próxima escritura.
    /// </summary>
    private void RegistrarConfiguracion(string tipo, object contexto, string severidad = SeveridadBitacora.Info)
    {
        try
        {
            Servicio.RegistroConfiguracion?.Registrar(tipo, ConActor(contexto), severidad);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            // Ver el resumen: el ajuste no depende de la bitácora.
        }
    }

    /// <summary>
    /// Con un operador en Configuración, su persona en ActorPersonId y sin ActorReason, en el mismo lugar del registro; con la
    /// clave del día o sin Configuración, el registro queda igual, con el nulo y NO_AUTHENTICATION (D7 de
    /// entrar-a-configuracion-con-teclado).
    /// </summary>
    private object ConActor(object contexto)
    {
        if (_actor is not { } persona)
        {
            return contexto;
        }

        var nodo = System.Text.Json.JsonSerializer.SerializeToNode(contexto)!.AsObject();
        if (!nodo.ContainsKey("ActorPersonId"))
        {
            return contexto;
        }

        nodo["ActorPersonId"] = persona;
        nodo.Remove("ActorReason");
        return nodo;
    }

    private IReadOnlyList<EstadoBitacora>? LeerEstadoBitacoras()
    {
        try
        {
            return Servicio.Bitacoras?.Estado();
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            return null;
        }
    }

    private Task Reconfirmar() => Maquina.ReconfirmarAsync();

    /// <summary>El ciclo de envío avisa desde su hilo; la franja se redibuja en el del componente.</summary>
    private void RefrescarSincronizacion() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// En reposo y sin diálogos, el foco vuelve a la raíz para que Escape llegue aunque no se haya tocado nada: al abrir, al
    /// volver de una atención y al cerrar un diálogo (D7).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool primera)
    {
        var enReposo = Maquina.Estado == EstadoAtencion.Reposo && !HayDialogo;
        var estado = HayDialogo ? (EstadoAtencion?)null : Maquina.Estado;
        var volvioAReposo = enReposo && !primera && _estadoDibujado != EstadoAtencion.Reposo;
        if (enReposo && (primera || _estadoDibujado != EstadoAtencion.Reposo))
        {
            await _raiz.FocusAsync();
        }

        _estadoDibujado = estado;

        // Fuera de la selección y de la confirmación, el cartel queda cerrado; abierto, el foco va a «Confirmar» (D1 y D3).
        if (Maquina.Estado is not (EstadoAtencion.Seleccion or EstadoAtencion.Confirmando))
        {
            _cartelAbierto = false;
        }

        if (_enfocarConfirmar && CartelVisible && Maquina.Estado == EstadoAtencion.Seleccion)
        {
            _enfocarConfirmar = false;
            await _confirmarCartel.FocusAsync();
        }

        // Al volver a reposo con la simulación activa, el combo relee la lista (D10); el primer dibujado ya la tiene.
        if (volvioAReposo && SimulacionActiva)
        {
            LeerPersonasSimulacion();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (_cierre is not null)
        {
            _cierre.ClavePedida -= PedirClaveDeLaVentana;
        }

        Servicio.SincronizacionCambiada -= RefrescarSincronizacion;
        _temporizador?.Dispose();
    }
