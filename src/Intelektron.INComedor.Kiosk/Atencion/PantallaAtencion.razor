    /// <summary>
    /// Cada importación aplicada queda en la general con el modo, la huella SHA-256 del archivo, la versión, los totales y, persona
    /// por persona, su PersonId y lo que pasó, sin nombres ni códigos; con un operador, él es el actor (D8 de
    /// importar-personas-desde-excel). Cada persona cambiada tiene además su CONFIGURATION_CHANGED, como un guardado a mano.
    /// </summary>
    private void RegistrarImportacionDePersonas(PanelConfiguracion.ImportacionPersonasRealizada importacion)
    {
        var personas = importacion.Resultado.Personas;
        RegistrarConfiguracion("PEOPLE_IMPORTED", new
        {
            Mode = importacion.Modo == ModoImportacion.Reemplazar ? "REPLACE" : "MERGE",
            FileSha256 = importacion.Huella,
            Version = importacion.Resultado.Guardado.VersionActiva,
            Added = personas.Count(p => p.Accion == AccionImportada.Agregada),
            Updated = personas.Count(p => p.Accion == AccionImportada.Modificada),
            Unchanged = personas.Count(p => p.Accion == AccionImportada.SinCambios),
            Deactivated = personas.Count(p => p.Accion == AccionImportada.DadaDeBaja),
            People = personas.Select(p => new
            {
                PersonId = p.PersonaId,
                Result = p.Accion switch
                {
                    AccionImportada.Agregada => "ADDED",
                    AccionImportada.Modificada => "UPDATED",
                    AccionImportada.SinCambios => "UNCHANGED",
                    _ => "DEACTIVATED",
                },
            }).ToList(),
            Access = _acceso,
            ActorPersonId = (Guid?)null,
            ActorReason = SinAutenticacion,
        });
