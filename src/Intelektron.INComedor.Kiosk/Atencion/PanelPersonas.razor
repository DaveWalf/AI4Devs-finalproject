@using System.Globalization
@using Intelektron.INComedor.Infrastructure.Sqlite

@*
    Personas en una tabla (D4 de configurar-puesto-por-pestanas, sobre «Personas habilitadas» de administrar-personas-y-opciones):
    una fila por persona y una columna por cada par de servicio y categoría que usa el catálogo o alguna regla, con el límite
    o «—». Para leer es #tabla-personas; con «Editar» pasa a #panel-personas en el mismo lugar: el nombre y cada límite son
    campos (vacío es sin cupo, 0 es la denegación explícita), una fila nueva suma el código enmascarado, y «Quitar»,
    «Guardar» y «Cancelar» actúan como en C. Ordenar cambia sólo la vista: la edición se arma en el orden de lectura y los
    campos rechazados vuelven a su fila por esa posición. Nunca muestra un código; el servicio valida y decide (D10, D11).
*@
<section id="@(Editando ? "panel-personas" : "tabla-personas")" class="panel-administracion tabla-administracion" aria-label="Personas habilitadas">
    @if (Editando)
    {
        <h3 id="titulo-personas">Personas habilitadas</h3>
    }

    @if (Editando && _vista.SoloLectura)
    {
        <p id="aviso-inweb" class="aviso" role="status">@MensajesAtencion.INWebAdministra</p>
    }

    @if (_aviso is not null)
    {
        <p id="aviso-panel" class="aviso" role="alert">@_aviso</p>
    }

    <div class="caja-tabla">
        <table class="tabla-personas">
            <thead>
                <tr>
                    @foreach (var columna in Columnas)
                    {
                        <th scope="col" data-columna="@columna.Clave" aria-sort="@Orden(columna.Clave)">
                            <button type="button" class="ordenar" @onclick="() => Ordenar(columna.Clave)">@columna.Titulo</button>
                        </th>
                    }
                    @if (Editable)
                    {
                        <th scope="col">Código</th>
                        <th scope="col"><span class="oculto">Acciones</span></th>
                    }
                    else if (!Editando)
                    {
                        @* «Editar» (o «Ver» con INWeb) en el encabezado, sin una fila propia que le quite alto a la tabla. *@
                        <td class="accion-tabla">
                            <button id="abrir-personas" type="button" class="principal" disabled="@(!PuedeEditar)"
                                    title="@(PuedeEditar ? null : MensajesAtencion.EdicionDeOpcionesAbierta)" @onclick="() => Editar.InvokeAsync()">@(_vista.SoloLectura ? "Ver" : "Editar")</button>
                        </td>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var indice in OrdenDeVista())
                {
                    var fila = _filas[indice];
                    <tr class="persona @(fila.Quitar ? "de-baja" : "")" data-indice="@indice" aria-invalid="@Marca(indice, "PersonaId")">
                        <td>
                            @if (Editable)
                            {
                                <input class="nombre-persona" type="text" maxlength="@AdministracionLocal.LargoNombrePersona" aria-label="Nombre visible"
                                       value="@fila.Nombre" aria-invalid="@Marca(indice, "Nombre")" @oninput="e => fila.Nombre = Texto(e)" />
                            }
                            else
                            {
                                <span class="nombre-persona">@fila.Nombre</span>
                            }
                        </td>
                        <td class="estado-persona">@Estado(fila)</td>
                        @for (var j = 0; j < _pares.Count; j++)
                        {
                            var columna = j;
                            <td class="cupo" data-cupo="@NombrePar(_pares[columna])">
                                @if (Editable)
                                {
                                    <input class="limite" type="number" inputmode="numeric" min="0" max="@AdministracionLocal.LimiteMaximo"
                                           aria-label="@($"Límite diario de {NombrePar(_pares[columna])}")" value="@fila.Limites[columna]"
                                           aria-invalid="@MarcaCupo(indice, columna)" @oninput="e => fila.Limites[columna] = Texto(e)" />
                                }
                                else
                                {
                                    @(fila.Limites[columna].Length == 0 ? "—" : fila.Limites[columna])
                                }
                            </td>
                        }
                        <td class="habilitadas" data-cantidad="@fila.Habilitadas">@fila.Habilitadas</td>
                        @if (!Editando)
                        {
                            <td></td>
                        }
                        @if (Editable)
                        {
                            <td>
                                @if (fila.Nueva)
                                {
                                    @* Sin value: lo tipeado no vuelve a dibujarse (D10 de administrar-personas-y-opciones). *@
                                    <input class="codigo-persona" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Código"
                                           maxlength="@AdministracionLocal.LargoCodigo" aria-invalid="@Marca(indice, "Codigo")" @oninput="e => fila.Codigo = Texto(e)" />
                                }
                            </td>
                            <td>
                                @if (fila.Nueva)
                                {
                                    <button type="button" class="quitar-persona" @onclick="() => Descartar(fila)">Descartar</button>
                                }
                                else if (fila.Activa)
                                {
                                    <button type="button" class="@(fila.Quitar ? "deshacer-quitar" : "quitar-persona")" @onclick="() => fila.Quitar = !fila.Quitar">
                                        @(fila.Quitar ? "Deshacer" : "Quitar")
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Editando)
    {
        <div class="acciones">
            @if (Editable)
            {
                <button id="agregar-persona" type="button" @onclick="AgregarPersona">Agregar persona</button>
            }
            <button id="cancelar-panel" type="button" @onclick="() => Cerrar.InvokeAsync(null)">Cancelar</button>
            @if (Editable)
            {
                <button id="guardar-panel" type="button" class="principal" @onclick="Guardar">Guardar</button>
            }
        </div>
    }
</section>

@code {
    private static readonly StringComparer PorNombre = StringComparer.Create(CultureInfo.GetCultureInfo("es-AR"), ignoreCase: true);

    private VistaAdministracion _vista = null!;
    private List<FilaPersona> _filas = [];
    private List<(Guid Servicio, Guid Categoria)> _pares = [];
    private IReadOnlyList<CampoRechazado> _campos = [];
    private Dictionary<int, List<int>> _columnasEnviadas = [];
    private string? _aviso;
    private string? _ordenColumna;
    private bool _ordenAscendente = true;
    private bool? _editandoCargado;

    [Parameter, EditorRequired]
    public AdministracionLocal Administracion { get; set; } = null!;

    /// <summary>Con «Editar», la tabla pasa a edición en el mismo lugar; sin él, sólo se lee.</summary>
    /// <summary>El operador que entró con su código, actor de lo guardado; null con la clave del día (D7 de entrar-a-configuracion-con-teclado).</summary>
    [Parameter]
    public Guid? Actor { get; set; }

    [Parameter]
    public bool Editando { get; set; }

    /// <summary>Para leer, «Editar» pasa la tabla a edición; deshabilitado mientras Opciones está en edición (D2).</summary>
    [Parameter]
    public EventCallback Editar { get; set; }

    [Parameter]
    public bool PuedeEditar { get; set; } = true;

    /// <summary>Se cierra la edición: con el aviso de la versión guardada, o null si se canceló.</summary>
    [Parameter]
    public EventCallback<string?> Cerrar { get; set; }

    private bool Editable => Editando && !_vista.SoloLectura;

    private IEnumerable<(string Clave, string Titulo)> Columnas =>
        new[] { ("Nombre", "Nombre"), ("Estado", "Estado") }
            .Concat(_pares.Select(p => (NombrePar(p), NombrePar(p))))
            .Append(("Opciones", "Opciones habilitadas"));

    /// <summary>Cada vez que entra o sale de la edición, vuelve a leer la versión activa.</summary>
    protected override void OnParametersSet()
    {
        if (_editandoCargado != Editando)
        {
            _editandoCargado = Editando;
            Cargar(Administracion.Leer());
        }
    }

    private void Cargar(VistaAdministracion vista)
    {
        _vista = vista;
        _pares = ParesDeColumnas(vista);
        _filas = vista.Personas.Select(p => new FilaPersona
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Activa = p.Activa,
            Limites = _pares.Select(par => p.Cupos.FirstOrDefault(c => c.ServicioId == par.Servicio && c.CategoriaId == par.Categoria) is { } cupo
                ? cupo.Limite.ToString(CultureInfo.InvariantCulture)
                : string.Empty).ToArray(),
            Habilitadas = p.OpcionesHabilitadas.Count,
        }).ToList();
        _campos = [];
        _columnasEnviadas = [];
        _aviso = null;
    }

    /// <summary>
    /// Los pares que usan las cargas de las opciones, en el orden del catálogo, y después los de alguna regla que el catálogo
    /// no usa; no cada servicio por cada categoría (D4).
    /// </summary>
    private static List<(Guid Servicio, Guid Categoria)> ParesDeColumnas(VistaAdministracion vista)
    {
        var pares = new List<(Guid, Guid)>();
        foreach (var par in vista.Opciones.SelectMany(o => o.Cargas.Select(c => (o.ServicioId, c.CategoriaId)))
                     .Concat(vista.Personas.SelectMany(p => p.Cupos.Select(c => (c.ServicioId, c.CategoriaId)))))
        {
            if (!pares.Contains(par))
            {
                pares.Add(par);
            }
        }

        return pares
            .OrderBy(p => vista.Servicios.Select(s => s.Id).ToList().IndexOf(p.Item1))
            .ThenBy(p => vista.Categorias.Select(c => c.Id).ToList().IndexOf(p.Item2))
            .ToList();
    }

    /// <summary>El orden de la vista: las filas de lectura ordenadas por la columna elegida, y las nuevas siempre al final.</summary>
    private IEnumerable<int> OrdenDeVista()
    {
        var existentes = Enumerable.Range(0, _filas.Count).Where(i => !_filas[i].Nueva).ToList();
        var nuevas = Enumerable.Range(0, _filas.Count).Where(i => _filas[i].Nueva);
        if (_ordenColumna is not { } columna)
        {
            return existentes.Concat(nuevas);
        }

        var parIndice = _pares.FindIndex(p => NombrePar(p) == columna);
        IEnumerable<int> ordenadas = columna switch
        {
            "Nombre" => Ordenadas(existentes, i => _filas[i].Nombre, PorNombre),
            "Estado" => Ordenadas(existentes, i => _filas[i].Activa ? 0 : 1, Comparer<int>.Default),
            "Opciones" => Ordenadas(existentes, i => _filas[i].Habilitadas, Comparer<int>.Default),
            _ when parIndice >= 0 => OrdenarPorCupo(existentes, parIndice),
            _ => existentes,
        };
        return ordenadas.Concat(nuevas);
    }

    private IEnumerable<int> Ordenadas<T>(List<int> filas, Func<int, T> clave, IComparer<T> comparador) =>
        _ordenAscendente ? filas.OrderBy(clave, comparador).ThenBy(i => i) : filas.OrderByDescending(clave, comparador).ThenBy(i => i);

    /// <summary>Por el límite de un cupo; una celda sin cupo va al final en los dos sentidos.</summary>
    private IEnumerable<int> OrdenarPorCupo(List<int> filas, int columna)
    {
        int? Limite(int i) => int.TryParse(_filas[i].Limites[columna], NumberStyles.None, CultureInfo.InvariantCulture, out var limite) ? limite : null;
        var conCupo = filas.Where(i => Limite(i) is not null).ToList();
        var sinCupo = filas.Where(i => Limite(i) is null);
        return Ordenadas(conCupo, i => Limite(i)!.Value, Comparer<int>.Default).Concat(sinCupo);
    }

    private void Ordenar(string columna)
    {
        _ordenAscendente = _ordenColumna != columna || !_ordenAscendente;
        _ordenColumna = columna;
    }

    private string Orden(string columna) =>
        _ordenColumna != columna ? "none" : _ordenAscendente ? "ascending" : "descending";

    private void AgregarPersona()
    {
        _filas.Add(new FilaPersona { Nueva = true, Activa = true, Limites = new string[_pares.Count] });
        Array.Fill(_filas[^1].Limites, string.Empty);
    }

    /// <summary>Descartar una fila nueva corre las posiciones: las marcas del último guardado ya no corresponden.</summary>
    private void Descartar(FilaPersona fila)
    {
        _filas.Remove(fila);
        _campos = [];
        _columnasEnviadas = [];
    }

    /// <summary>
    /// Arma la edición entera en el orden de lectura y la manda al servicio, que valida y decide. Una celda vacía es sin cupo;
    /// un límite que no es un número va como -1, para que el servicio lo rechace y lo registre como cualquier otro dato fuera de
    /// rango.
    /// </summary>
    private async Task Guardar()
    {
        _columnasEnviadas = [];
        var ediciones = new List<EdicionPersona>();
        for (var i = 0; i < _filas.Count; i++)
        {
            var fila = _filas[i];
            var columnas = new List<int>();
            var cupos = new List<CupoEditado>();
            for (var j = 0; j < _pares.Count; j++)
            {
                if (fila.Limites[j].Trim().Length == 0)
                {
                    continue;
                }

                columnas.Add(j);
                cupos.Add(new CupoEditado(_pares[j].Servicio, _pares[j].Categoria,
                    int.TryParse(fila.Limites[j], NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var limite) ? limite : -1));
            }

            _columnasEnviadas[i] = columnas;
            ediciones.Add(fila.Nueva
                ? new EdicionPersona(null, fila.Nombre, cupos, fila.Codigo)
                : new EdicionPersona(fila.Id, fila.Nombre, cupos, Quitar: fila.Quitar));
        }

        ResultadoGuardado resultado;
        try
        {
            resultado = Administracion.GuardarPersonas(ediciones, Actor);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _aviso = MensajesAtencion.PanelNoGuardado;
            return;
        }

        switch (resultado.Tipo)
        {
            case TipoGuardado.Aplicado:
                await Cerrar.InvokeAsync(MensajesAtencion.VersionGuardada(resultado.VersionActiva));
                break;
            case TipoGuardado.Denegado:
                Cargar(Administracion.Leer());
                _aviso = MensajesAtencion.INWebAdministra;
                break;
            default:
                _campos = resultado.Campos;
                _aviso = resultado.Motivo == CodigosAdministracion.CodigoDuplicado ? MensajesAtencion.CodigoYaExiste : MensajesAtencion.PanelInvalido;
                break;
        }
    }

    private string? Marca(int indice, string campo) =>
        _campos.Any(c => c.Indice == indice && c.Campo == campo) ? "true" : null;

    /// <summary>El campo rechazado «Cupos[n]» es la n-ésima celda con valor que se mandó de esa fila.</summary>
    private string? MarcaCupo(int indice, int columna) =>
        _columnasEnviadas.TryGetValue(indice, out var columnas) && columnas.IndexOf(columna) is var n and >= 0
        && _campos.Any(c => c.Indice == indice && (c.Campo == $"Cupos[{n}].Limite" || c.Campo == $"Cupos[{n}]"))
            ? "true"
            : null;

    private string NombrePar((Guid Servicio, Guid Categoria) par)
    {
        var nombreServicio = _vista.Servicios.FirstOrDefault(s => s.Id == par.Servicio)?.Nombre ?? "?";
        var nombreCategoria = _vista.Categorias.FirstOrDefault(c => c.Id == par.Categoria)?.Nombre ?? "?";
        return nombreServicio == nombreCategoria ? nombreServicio : $"{nombreServicio} · {nombreCategoria}";
    }

    private static string Estado(FilaPersona fila) =>
        fila.Nueva ? "Nueva" : fila.Quitar ? "Se da de baja al guardar" : fila.Activa ? "Activa" : "De baja";

    private static string Texto(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    private sealed class FilaPersona
    {
        public Guid Id { get; init; }

        public bool Nueva { get; init; }

        public string Nombre { get; set; } = string.Empty;

        public string Codigo { get; set; } = string.Empty;

        public bool Activa { get; init; }

        public bool Quitar { get; set; }

        public string[] Limites { get; init; } = [];

        public int Habilitadas { get; init; }
    }
}
