@* Los modos de la impresora simulada, dentro de Configuración (D5 de presentar-atencion-tactil); aplican desde el próximo envío. *@
<section class="franja-impresora" aria-labelledby="titulo-impresora">
    <h3 id="titulo-impresora">Impresora simulada</h3>
    <p>Demostración: elegí cómo responde al próximo comprobante.</p>
    <div class="acciones">
        @foreach (var modo in Enum.GetValues<ModoImpresoraSimulada>())
        {
            <button type="button" id="impresora-@modo.ToString().ToLowerInvariant()" aria-pressed="@(modo == Impresora.Modo ? "true" : "false")"
                    @onclick="() => Impresora.Modo = modo">@Texto(modo)</button>
        }
    </div>
    <p id="modo-impresora">Modo: @Texto(Impresora.Modo)</p>
</section>

@code {
    [Parameter, EditorRequired]
    public ImpresoraSimulada Impresora { get; set; } = null!;

    private static string Texto(ModoImpresoraSimulada modo) => modo switch
    {
        ModoImpresoraSimulada.Disponible => "Disponible",
        ModoImpresoraSimulada.SinPapel => "Sin papel",
        _ => "Incierta",
    };
}
