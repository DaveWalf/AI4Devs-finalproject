@using Intelektron.INComedor.Infrastructure.Sqlite

@*
    La pestaña Comprobantes (D8 de configurar-puesto-por-pestanas): la reimpresión y la recuperación que antes estaban en
    «Asistencia» de reposo, con el código de un operador con OPERATOR y las reglas de RB26 de Asistencia. El código se
    tipea y no vuelve a mostrarse. Un toque dentro de la pestaña reinicia el plazo de 30 s de la sesión.
*@
<div class="comprobantes" @onpointerdown="Tocar">
    @if (!Sesion.Abierta)
    {
        <p>Para reimprimir o recuperar un comprobante, ingresá el código de un operador.</p>
        <div class="entrada-operador">
            <input id="codigo-operador" type="text" inputmode="numeric" autocomplete="off" aria-label="Código del operador"
                   value="@_codigo" @oninput="e => _codigo = e.Value?.ToString() ?? string.Empty" />
            <button id="entrar-operador" type="button" class="principal" @onclick="Entrar">Ingresar</button>
        </div>
        @if (Sesion.Aviso is not null)
        {
            <p id="aviso-comprobantes" class="aviso" role="status">@Sesion.Aviso</p>
        }
    }
    else
    {
        <p>Operador: <strong>@Sesion.NombreVisible</strong> · Identificación simulada por código (demostración)</p>
        @if (Sesion.Mensaje is not null)
        {
            <p id="mensaje-asistencia" role="status">@Sesion.Mensaje</p>
        }
        @if (Sesion.ReimpresionPedida is { } pedida)
        {
            <section aria-label="Motivo de la reimpresión">
                @if (Sesion.AvisoIncertidumbre)
                {
                    <p id="aviso-incertidumbre" class="aviso" role="alert">@MensajesAtencion.Incertidumbre</p>
                }
                <p>Reimprimir el comprobante de las @Hora(pedida.CreadoUtc) · @pedida.Opcion. Elegí el motivo:</p>
                <div class="acciones">
                    @foreach (var motivo in Enum.GetValues<MotivoReimpresion>())
                    {
                        <button type="button" class="motivo" @onclick="() => Sesion.Reimprimir(motivo)">@MensajesAtencion.Motivo(motivo)</button>
                    }
                    <button id="cancelar-reimpresion" type="button" @onclick="Sesion.CancelarReimpresion">Cancelar</button>
                </div>
            </section>
        }
        else
        {
            <table class="tabla-comprobantes">
                <thead><tr><th>Hora</th><th>Opción</th><th>Persona</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var comprobante in Sesion.Comprobantes)
                    {
                        <tr>
                            <td>@Hora(comprobante.CreadoUtc)</td>
                            <td>@comprobante.Opcion</td>
                            <td>@comprobante.NombreVisible</td>
                            <td>@Estado(comprobante.EstadoUltimoTrabajo)</td>
                            <td>
                                @if (comprobante.EstadoOriginal == EstadoTrabajoImpresion.Failed)
                                {
                                    <button type="button" class="recuperar" @onclick="() => Sesion.Recuperar(comprobante.TrabajoOriginalId)">Recuperar</button>
                                }
                                <button type="button" class="reimprimir" @onclick="() => Sesion.PedirReimpresion(comprobante.TicketId)">Reimprimir</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div class="acciones">
            <button id="salir" type="button" @onclick="() => Sesion.Salir()">Salir</button>
        </div>
    }
</div>

@code {
    private string _codigo = string.Empty;

    [Parameter, EditorRequired]
    public SesionOperador Sesion { get; set; } = null!;

    [Parameter]
    public TimeZoneInfo Zona { get; set; } = TimeZoneInfo.Utc;

    /// <summary>El campo queda vacío apenas se envía: el código no se vuelve a mostrar.</summary>
    private void Entrar()
    {
        var codigo = _codigo;
        _codigo = string.Empty;
        Sesion.Entrar(codigo);
    }

    private void Tocar() => Sesion.Tocar();

    private string Hora(DateTimeOffset instante) => TimeZoneInfo.ConvertTime(instante, Zona).ToString("HH:mm");

    private static string Estado(EstadoTrabajoImpresion estado) => estado switch
    {
        EstadoTrabajoImpresion.Submitted => "Enviado",
        EstadoTrabajoImpresion.Failed => "Falló",
        EstadoTrabajoImpresion.Unknown => "Incierto",
        _ => "En cola",
    };
}
