<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Microsoft.Data.SqlClient 7.1.1, que llega con Sync.Api, trae Pkcs 9.0.18 (CVE-2026-84008 y CVE-2026-70162); este
         proyecto no es web y no lo poda, así que se fija la versión corregida del tren de D-C25. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <ProjectReference Include="..\..\src\Intelektron.INComedor.Kiosk\Intelektron.INComedor.Kiosk.csproj" />
    <ProjectReference Include="..\..\src\Intelektron.INComedor.Sync.Api\Intelektron.INComedor.Sync.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- El receptor real con TLS mutuo y sus certificados de prueba, los mismos que usa Sync.Api.Tests (D13). -->
    <Compile Include="..\Intelektron.INComedor.Sync.Api.Tests\CertificadosDePrueba.cs" Link="Receptor\CertificadosDePrueba.cs" />
    <Compile Include="..\Intelektron.INComedor.Sync.Api.Tests\ReceptorConKestrel.cs" Link="Receptor\ReceptorConKestrel.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
